filesystem : {
  fstrees : {
    / : {
      invalidation : stat
      mkdir : false
      index : false
    }
    /home/todd/bam : {
      invalidation : notify
      mkdir : false
      index : true
      mount : true
    }
    /home/todd/bam-build : {
      invalidation : notify
      mkdir : true
      index : true
      mount : true
    }
  }
  exclude : {
    /home/todd/bam/builtin-modules
    /home/todd/bam/builtin-plugins
    /usr/share/bam/modules
  }
  special : {
    var.bam.final+devel
    var.bam.debug+devel
    var.bam.trace+devel
    var.bam.devel+devel

    rules.bam.final+devel
    rules.bam.debug+devel
    rules.bam.trace+devel
    rules.bam.devel+devel
  }
}

plugins : {
  path : {
    dirs : {
      /home/todd/bam/builtin-plugins+devel
    }
  }
  [
    {
      path : autobuild-focus
    }
    {
      path : invalidate-global
      args : [
        --suffix=h
      ]
    }
  ]
}
