#
# installs binaries/libraries built by fab-v0.8
#

usage() {
  echo "usage: $0 /path/to/build-dir" 1>&2
  exit 1
}

if [ $# -ne 1 ]; then
  usage
fi

SRCDIR=$(dirname $(realpath $0))
BUILDDIR=$1
if [ ! -d $BUILDDIR ]; then
  usage
fi

echo SRCDIR   $SRCDIR
echo BUILDDIR $BUILDDIR

# cleanup previous builds
(
  find . $BUILDDIR -type f \(    \
       -name '*.o'               \
    -o -name 'git-state.[ch]'    \
    -o -name '*.tokens.[ch]'     \
    -o -name '*.states.[ch]'     \
    -o -name '*.tab.[ch]'        \
    -o -name '*.lex.[ch]'        \
    -o -name '*.desc.[ch]'       \
  \) -print
) | xargs rm

set +e
killall fabd
if [ $? == 0 ]; then
  sleep 1
fi
set -e

for x in libxlinux libcommon asan unit libnarrator libdescriptor libvalyria libxunit libyyutil liblorien libbacon libmoria ; do
  pushd $BUILDDIR/$x
  fab
  fab kill
  popd
done

for x in bacon fab/libbam fab/bam ; do
  pushd $BUILDDIR/$x
  fab
  fab kill
  popd
done

for x in fab/bamd ; do
  pushd $BUILDDIR/$x
  fab
  fab kill
  popd
done
