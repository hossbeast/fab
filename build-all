usage() {
  echo "usage: $0"
}

if [ $# -ne 0 ]; then
  usage
  exit 1
fi

SRCDIR=$(dirname $(realpath $0))
BUILDDIR=$(realpath .)

echo SRCDIR   $SRCDIR
echo BUILDDIR $BUILDDIR

# you can remove these guardrails
if [ $SRCDIR != "/home/todd/bam" ]; then
  echo "unexpected SRCDIR $SRCDIR" 1>&2
  exit 1
fi
if [ $BUILDDIR != "/home/todd/bam-build" ]; then
  echo "unexpected BUILDDIR $BUILDDIR" 1>&2
  exit 1
fi

# cleanup previous builds
(
  find $BUILDDIR -type f \(      \
       -name '*.o'               \
    -o -name '*.a'               \
    -o -name 'git-state.[ch]'    \
    -o -name '*.tokens.[ch]'     \
    -o -name '*.states.[ch]'     \
    -o -name '*.tab.[ch]'        \
    -o -name '*.lex.[ch]'        \
    -o -name '*.descriptor.[ch]' \
    -o -name '*.desc.[ch]'       \
    -o -name '*.unit'            \
    -o -name '*.xunit'           \
  \) -print
) | xargs rm -f

set +e
killall bamd
if [ $? == 0 ]; then
  sleep 1
fi
set -e

for x in libxlinux asan unit libcommon libnarrator libdescriptor libvalyria libxunit libyyutil liblorien libbacon libmoria ; do
  pushd $BUILDDIR/$x
  bam
  bam kill
  popd
done

for x in bacon libbam bam ; do
  pushd $BUILDDIR/$x
  bam
  bam kill
  popd
done

for x in bamd ; do
  pushd $BUILDDIR/$x
  bam
  bam kill
  popd
done
