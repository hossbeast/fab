#!/usr/bin/env perl

#
# This test has a bind rule whose target is ambiguous
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_dir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'C');
setup({tolerant => 1 }, <<TREE);
|-- A
|   `-- foo
|       `-- bar
|-- B
|   `-- foo
|       `-- bar
|-- C
|   `-- module.bam%devel <<
bind { name : 1 } foo => [*] //foo
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
  }
}
>>
TREE

my $modules_ns_id = bam::identity('namespace', "modules");
my $foo_A_id = bam::identity("dir", "$bam_basedir/A/foo");
my $foo_B_id = bam::identity("dir", "$bam_basedir/B/foo");

# 1. ambiguous target between A/foo and B/foo - error
assert {
  info({
    "system-state" => 'rule-reconcile'
})};
assert {
  stats("//bm/namespaces/$modules_ns_id", "-S", {
      put => 5  # number of indexed directory nodes
    , del => 0
    , count => 4
})};
assert {
  stats(undef, {
      modules => 1          # the imported directory is not vivified
    , system_error => 1
    , system_state_ready => 0
    , rule_resolve_err => 1
    , rule_resolve_ok => 0
    , rule_run => 0
})};
assert {
  stats(".", "-S", {
      type => 'module'
    , state => 'fresh'
    , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
      type => 'ruleset'
    , state => 'fresh'
    , parse_err => 0
    , parse_ok => 1
})};
assert {
  stats("//module/rmas-by/name/1", "--follow", {
      rule_resolve_err => 1
    , rule_resolve_ok => 0
    , rule_run => 0
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
    , target_hits => 2        # size of ambiguous target set
    , attachment_hits => 1
})};

assert { eexists("//foo") };
assert { enoent("//foo/$foo_A_id") };
assert { enoent("//foo/$foo_B_id") };

# remove the ambiguity by renaming B/foo
rename("$bam_basedir/B/foo", "$bam_basedir/B/baz");
reconcile();

assert {
  stats("//bm/namespaces/$modules_ns_id", "-S", {
      put => 6  # number of indexed directory nodes
    , del => 1  # redundant "foo" deleted
    , count => 5# baz is now indexed
})};
assert {
  stats(undef, {
      modules => 1
    , system_state_ready => 1
    , rule_run => 1
    , rule_resolve_err => 1
    , rule_resolve_ok => 1
})};
assert {
  stats(".", "-S", {
      type => 'module'
    , state => 'fresh'
    , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
      type => 'ruleset'
    , state => 'fresh'
    , parse_err => 0
    , parse_ok => 1
})};
assert {
  stats("//module/rmas-by/name/1", "--follow", {
      rule_resolve_err => 1
    , rule_resolve_ok => 1
    , rule_run => 1
    , target_hits => 1        # unambiguous
    , attachment_hits => 1
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
})};

assert { ls("//foo", "foo - shadow-dir fresh", "--max-distance", "0") };
assert { ls("//foo/$foo_A_id", "$foo_A_id -> $bam_basedir/A/foo") };
assert { enoent("//foo/$foo_B_id") };

teardown();
