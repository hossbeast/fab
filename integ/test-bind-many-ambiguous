#!/usr/bin/env perl

#
# This test has a bind rule whose target is ambiguous
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_projdir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use util;
use tree;
use bam;

init(subdir => 'C');
setup({tolerant => 1 }, <<TREE);
|-- A
|   `-- foo
|       `-- bar
|-- B
|   `-- foo
|       `-- bar
|-- C
|   `-- module.bam+devel <<
bind { id : 1 } foo => [*] //foo
>>
|-- system-config <<
filesystems : {
  / : {
    indexed : false
  }
  $bam_basedir : {
    indexed : true
  }
}
walker : {
  include : {
    $bam_basedir
  }
}
>>
TREE

my $foo_A_id = hash64("$bam_basedir/A/foo");
my $foo_B_id = hash64("$bam_basedir/B/foo");

# 1. ambiguous target between A/foo and B/foo - error
assert {
  stats(undef, {
      modules => 1          # the imported directory is not vivified
    , system_state => 'rule-reconcile'
    , system_error => 1
    , system_state_ok => 0
    , fsent_index_put => 6  # number of indexed directory nodes
    , fsent_index_del => 0
    , fsent_index_count => 5
    , rule_run => 1
})};
assert {
  stats(".", "-S", {
      type => 'module'
    , state => 'fresh'
    , reloaded => 1
    , parse => 1
    , parse_ok => 1
})};
assert {
  stats("//module/rma/1", {
      rule_run => 1
    , rule_run_ok => 0        # bind rule was invalidated, and re-run
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
    , target_hits => 2        # size of ambiguous target set
    , attachment_hits => 1
})};

assert { eexists("//foo") };
assert { enoent("//foo/$foo_A_id") };
assert { enoent("//foo/$foo_B_id") };

# remove the ambiguity by renaming B/foo
rename("$bam_basedir/B/foo", "$bam_basedir/B/baz");
reconcile();

assert {
  stats(undef, {
      modules => 1
    , system_state_ok => 1
    , fsent_index_put => 7  # number of indexed directory nodes
    , fsent_index_del => 1  # redundant "foo" deleted
    , fsent_index_count => 6# baz is now indexed
    , rule_run => 2
})};
assert {
  stats(".", "-S", {
      type => 'module'
    , state => 'fresh'
    , reloaded => 1
    , parse => 1
    , parse_ok => 1
})};
assert {
  stats("//module/rma/1", {
      rule_run => 2
    , rule_run_ok => 1        # bind rule was invalidated, and re-run
    , target_hits => 1        # nomatch
    , attachment_hits => 1
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
})};

assert { ls("//foo", "foo - shadow-dir fresh", "--max-distance", "0") };
assert { ls("//foo/$foo_A_id", "$foo_A_id -> $bam_basedir/A/foo") };
assert { enoent("//foo/$foo_B_id") };

teardown();
