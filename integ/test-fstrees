#!/usr/bin/env perl

#
# Exercise frstree list and describe from bam cli
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup(<<TREE);
|-- B
|   `-- C
|       `-- D
|-- module.bam%devel
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir/B : {
      mount : true
    }
  }
}
>>
TREE

my $result;
my $root_fstree_id = bam::identity("fstree", "/");
my $shadow_fstree_id = bam::identity("fstree", "//");
my $system_fstree_id = bam::identity("fstree", $bam_basedir);
my $B_fstree_id = bam::identity("fstree", "$bam_basedir/B");

# check stats
assert {
  stats("//bm/fstrees/$root_fstree_id", "--follow", {
    type => 'fstree'
  , state => "fresh"
})};
assert {
  stats("//bm/fstrees/$shadow_fstree_id", "--follow", {
    type => 'fstree'
  , state => "fresh"
})};
assert {
  stats("//bm/fstrees/$system_fstree_id", "--follow", {
    type => 'fstree'
  , state => "fresh"
})};
assert {
  stats("//bm/fstrees/$B_fstree_id", "--follow", {
    type => 'fstree'
  , state => "fresh"
})};

# list fstrees
$result = bam_fstrees();
print("$result\n");
assert { index($result, $root_fstree_id) > -1 };
assert { index($result, $shadow_fstree_id) > -1 };
assert { index($result, $system_fstree_id) > -1 };
assert { index($result, $B_fstree_id) > -1 };

# describe fstree by id
$result = bam_fstree($root_fstree_id);
assert { index($result, $root_fstree_id) > -1 };

$result = bam_fstree($shadow_fstree_id);
assert { index($result, $shadow_fstree_id) > -1 };

$result = bam_fstree($system_fstree_id);
assert { index($result, $system_fstree_id) > -1 };

$result = bam_fstree($B_fstree_id);
assert { index($result, $B_fstree_id) > -1 };

teardown();
