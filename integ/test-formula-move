#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# build out the fstree under /tmp
init();
setup(<<'TREE');
|-- module.bam%devel <<
rule -- boats : ./foo.bam
rule boats -> //targets
>>
|-- foo.bam << 0777
#!/usr/bin/env perl
open FH, ">", $ENV{bm_target0} or die $!;
print FH "foo\n";
close FH;
>>
|-- bar.bam << 0777
#!/usr/bin/env perl
open FH, ">", $ENV{bm_target0} or die $!;
print FH "bar\n";
close FH;
>>
TREE

my $foo_bam_id = bam::identity("formula", "$bam_basedir/foo.bam");
my $bar_bam_id = bam::identity("formula", "$bam_basedir/bar.bam");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
  , system_state_ok => 0
  , formulas => 1
})};
assert { stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 1
  , state => "fresh"
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => "fresh"
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => "ruleset"
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("foo.bam", "-S", {
    type => "formula"
  , state => "fresh"
  , parse_ok => 1
  , parse_err => 0
})};
assert { stats("bar.bam", {   # not yet referenced by any formula
    state => "fresh"
  , type => "file"
})};
assert { stats("boats", {
    state => "uncreated"
})};

my $res = bam_formulas();
print("$res\n");
assert { $res =~ /formula id : $foo_bam_id/ };
my $nls = ($res =~ tr/\n//);
assert { $nls <= 1 };

# build - creates the file
build();
assert { stats("foo.bam", "-S", {
    type => "formula"
  , state => "fresh"
  , parse_ok => 1
  , parse_err => 0
})};

# file was created by the foo formula
assert_file("$bam_basedir/boats", "foo");
assert { stats("boats", {
    type => "file"
  , state => "fresh"
  , fresh => 1
  , stale => 0
})};

# change the file to be created by some other formula
open my $fh, ">", "$bam_basedir/module.bam%devel" or die $!;
print $fh <<TEXT;
rule -- boats : ./bar.bam
rule boats -> //targets
TEXT
close $fh;

reconcile();

assert { stats(undef, {
    modules => 1
  , formulas => 1
})};

# boats was invalidated when the other formula was assigned
assert { stats("boats", {
    type => "file"
  , state => "stale"
})};

# build - re-creates the file
build();

assert { stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 2
  , state => "fresh"
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => "fresh"
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => "ruleset"
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 2
})};
assert { stats("foo.bam", {  # no longer referenced as a formula by any rule
    state => "fresh"
  , type => "file"
})};
assert { stats("bar.bam", "-S", {
    type => "formula"
  , state => "fresh"
  , parse_ok => 1
  , parse_err => 0
})};
assert { stats("boats", {
    type => "file"
  , state => "fresh"
})};

# file was created by the foo formula
assert_file("$bam_basedir/boats", "bar");

$res = bam_formulas();
print("$res\n");
assert { $res =~ /formula id : $bar_bam_id/ };
$nls = ($res =~ tr/\n//);
assert { $nls <= 1 };

teardown();
