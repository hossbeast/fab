#!/usr/bin/env perl

#
# honor the fstree mkdir=true setting to create directories in the module build dir
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_dir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<"TREE");
|-- A
|   `-- foo
|   `-- rules.bam%devel <<
rule foo -> boats/bar : ./cp.bam+(.)
rule foo -> \$^D/bar : ./cp.bam+(.)
rule **/bar -> //targets
>>
|   `-- cp.bam << 0777
file : {
  lookup : {
    namespace : coreutils
    pattern : bin/cp+(@.)
  }
}
args : [
  \$bm_source0
  \$bm_target0
]
>>
|-- B
|   `-- module.bam%devel <<
anchor ../A
>>
|-- system-config <<
namespaces : {
  coreutils
}
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
    }
    $bam_basedir/B : {
      mount : true
      mkdir : true
    }
    $repodir/usr/share/bam/coreutils : {
      mount : true
      namespaces : {
        coreutils
      }
    }
  }
}
>>
TREE

my $B_module_id = bam::identity('module', $bam_dir);
my $B_fstree_id = bam::identity('fstree', $bam_dir);

# build link points to the right node
my $result = bam_ls(["//bm/modules/$B_module_id/build", "--no-follow"]);
my $ref = $$result{out};
assert { $ref eq "build -> $bam_basedir/B" };

# anchor link points to the right node
$result = bam_ls(["//bm/modules/$B_module_id/anchor", "--no-follow"]);
$ref = $$result{out};
assert { $ref eq "anchor -> $bam_basedir/A" };

# before
assert {
  stats(undef, {
    modules => 1
})};
assert {
  stats("//bm/sys-filesystem", "--follow", {
      mkdir_ok => 1
    , mkdir_err => 0
    , mkdir_eexist => 0
})};
assert {
  stats("//bm/fstrees/$B_fstree_id", "--follow", {
      mkdir_ok => 1
    , mkdir_no => 0
    , mkdir_err => 0
    , mkdir_eexist => 0
})};
assert {
  stats("$bam_basedir/B", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("$bam_basedir/B/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("$bam_basedir/B", {
    type => 'dir'
  , state => 'fresh'
  , mkdir_ok => 0
  , mkdir_no => 0
  , mkdir_err => 0
  , mkdir_eexist => 0
})};
assert {
  stats("$bam_basedir/B/boats", {
    type => 'dir'
  , state => 'fresh'
  , mkdir_ok => 1
  , mkdir_no => 0
  , mkdir_err => 0
  , mkdir_eexist => 0
})};
assert {
  stats("$bam_basedir/A", {
    type => 'dir'
  , state => 'fresh'
  , mkdir_ok => 0
  , mkdir_no => 0
  , mkdir_err => 0
  , mkdir_eexist => 0
})};

build();
assert_file("$bam_dir/boats/bar");
assert_file("$bam_dir/bar");

teardown();
