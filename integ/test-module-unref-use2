#!/usr/bin/env perl

#
# This test has an out-of-tree directory with a rules.bam file ; the file is referenced by a uses import
# and the directory is referenced by an bind rule ; then uses import is removed
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_projdir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<TREE);
|-- A
|   `-- rules.bam+devel <<
rule { name : foo } foo -> bar
>>
|-- B
|   `-- foo
|   `-- module.bam+devel <<
use A
>>
|   `-- C
|       `-- module.bam+devel <<
bind A => //A
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : { mount : true }
  }
}
>>
TREE

my $B_id = hash64("$bam_projdir");

# before
assert { stats(undef, {
    modules => 2
  , ruleset_files => 1
  , system_state_ok => 1
})};
assert { stats(".", "-S", {     # B
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , modules_up => 0
  , modules_down => 1
  , rules => 0
  , uses_down => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats(".", {     # B
    type => 'module-dir'
  , rules => 1
})};
assert { stats("//modules/$B_id/rmas-by/name/foo", {
    rule_run => 2               # this rule is run twice because it instantiates a new file in the matched directory
  , rule_run_ok => 2
})};
assert { stats("../A/rules.bam+devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
  , rules => 1
  , uses_up => 1
})};
assert { stats("C", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , modules_up => 1
  , modules_down => 0
  , uses_down => 0
  , parse => 1
  , parse_ok => 1
})};
assert { stats("C", {
    type => 'module-dir'
  , state => 'fresh'
})};

# delete the contents of the module file
open my $fh, ">", "$bam_basedir/B/module.bam+devel" or die $!;
close $fh;

# after
reconcile();
assert { stats(undef, {
    modules => 2
  , ruleset_files => 0
  , system_state_ok => 2
})};
assert { stats(".", "-S", {     # B
    type => 'module'
  , state => 'fresh'
  , reloaded => 2
  , modules_up => 0
  , modules_down => 1
  , uses_down => 0
  , rules => 0
  , parse => 2
  , parse_ok => 2
})};
assert { stats(".", {     # B
    type => 'module-dir'
  , rules => 0            # B no longer uses A
})};
# out-of-tree rules.bam file ; no longer referenced ; its just a file now
assert { stats("../A/rules.bam+devel", {
    type => 'file'
})};
assert { stats("C", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , modules_up => 1
  , modules_down => 0
  , uses_down => 0
  , parse => 1
  , parse_ok => 1
})};

teardown();
