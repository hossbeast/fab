#!/usr/bin/env perl

#
# anchor with nested modules
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_dir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<"TREE");
|-- A
|   `-- module.bam%devel <<
rule foo -> bar : B/cp.bam+(.)
rule bar -> //targets
>>
|-- B
|   `-- foo
|   `-- module.bam%devel <<
anchor ../A
rule foo -> baz : B/cp.bam+(.)
rule baz -> //targets
>>
|   `-- cp.bam << 0777
file : {
  lookup : {
    namespace : coreutils
    pattern : bin/cp+(@.)
  }
}
args : [
  \$bm_source0
  \$bm_target0
]
>>
|-- system-config <<
namespaces : {
  coreutils
}
filesystem : {
  fstrees : {
    $repodir/usr/share/bam/coreutils : {
      mount : true
      namespaces : {
        coreutils
      }
    }
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
    $bam_basedir/B : {
      mount : true
      namespaces : {
        modules
        formulas
      }
    }
  }
}
>>
TREE

my $B_module_id;
my $A_rule_1_id;
my $A_rule_2_id;
my $B_rule_2_id;
my $B_rule_3_id;
my $result;
my $ref;
my $lines;

$B_module_id = bam::identity("module", "$bam_basedir/B");
$A_rule_1_id = bam::identity("ruleset", "$bam_basedir/A/module.bam%devel", "rule", "1");
$A_rule_2_id = bam::identity("ruleset", "$bam_basedir/A/module.bam%devel", "rule", "2");
$B_rule_2_id = bam::identity("ruleset", "$bam_basedir/B/module.bam%devel", "rule", "2");
$B_rule_3_id = bam::identity("ruleset", "$bam_basedir/B/module.bam%devel", "rule", "3");

print(" A_rule_1_id $A_rule_1_id\n");
print(" A_rule_2_id $A_rule_2_id\n");
print(" B_rule_2_id $B_rule_2_id\n");
print(" B_rule_3_id $B_rule_3_id\n");

# upon setup
assert {
  stats(undef, {
    modules => 1
})};
assert {
  stats("//bm/sys-filesystem", "--follow", {
      mkdir_ok => 0
    , mkdir_err => 0
    , mkdir_no => 0
    , readlink_err => 0
    , readlink_no => 0
    , readlink_ok => 0
    , unlink_enoent => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_ok => 0
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 2
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};

# module ref links
assert { ls("//bm/modules/$B_module_id/build", "build -> $bam_basedir/B") };
assert { ls("//bm/modules/$B_module_id/anchor", "anchor -> $bam_basedir/A") };

# list of rules
$result = bam_ls(["//bm/modules/$B_module_id/rules"]);
print("$$result{out}\n");
$lines = ($$result{out} =~ tr/\n//);

assert { $$result{out} =~ $A_rule_1_id };
assert { $$result{out} =~ $A_rule_2_id };
assert { $$result{out} =~ $B_rule_2_id };
assert { $$result{out} =~ $B_rule_3_id };
assert { $lines == 4 };

assert {
  stats("$bam_dir/foo", {
    type => 'file'
  , stale => 0
  , fresh => 1
})};

assert { enoent("$bam_dir/bar") };
assert { enoent("$bam_dir/baz") };

build();

assert {
  stats("$bam_dir/foo", {
    type => 'file'
  , stale => 0
  , fresh => 1
})};
assert {
  stats("$bam_dir/bar", {
    type => 'file'
  , stale => 0
  , fresh => 1
})};
assert {
  stats("$bam_dir/baz", {
    type => 'file'
  , stale => 0
  , fresh => 1
})};

teardown();
