#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

# backtrace on die
use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use bam;
use util;

my $RED = "\x1b\x5b\x33\x31\x6d";
my $GREEN = "\x1b\x5b\x33\x32\x6d";
my $NONE = "\x1b\x5b\x30\x3b\x30\x6d";
my $CONCURRENCY = 20;   # dont have more tests than this in flight at once

if(! -e "/run/fab-integ")
{
  print("sudo mkdir -p /run/fab-integ/logs && sudo chmod -R ugoa+rwx /run/fab-integ\n");
  die("forgot?");
}

my $filter = qr/./;
if($#ARGV >= 0) {
  $filter = qr/$ARGV[0]/ or die;
}

my $total = 0;
my $passed = 0;
my $failed = 0;
my @tests;
my %table;
opendir(my $dh, ".") or die;
while(readdir($dh))
{
  next unless length($_) > 5 && substr($_, 0, 5) eq "test-";
  next unless $_ =~ $filter;

  for my $invalidate ("stat", "notify")
  {
    my ($dir, $hash, $ipc) = test_parameters($_ . "+$invalidate");
    my $test = {
        'index' => $#tests + 1,
      , path => "./$_"
      , args => [ $invalidate ]
      , projdir => $dir
      , projhash => $hash
      , ipcdir => $ipc
    }; 
    push @tests, $test;
    mkdirp($$test{ipcdir});
  }
}

$SIG{CHLD} = sub {
  local ($!, $?);
  while((my $pid = waitpid(-1, WNOHANG)) > 0) {
    my $test = $table{$pid};
    my $exit = $? >> 8;
    my $sig = $? & 127;
    $$test{exit} = $exit;

    if($? == 0) {
      printf("${GREEN}[%5s]${NONE} %3d $$test{path} @{$$test{args}}\n", "PASS", $$test{'index'});
      $passed++;
    } else {
      printf("${RED}[%5s]${NONE} %3d $$test{path} @{$$test{args}}\n", "FAIL", $$test{'index'});
      $failed++;
    }
  }
};

# launch all the tests
for my $test (@tests)
{
  $total++;
  while(($total - ($passed + $failed)) > $CONCURRENCY) {
    select(undef, undef, undef, .025);
  }

  if(($$test{pid} = fork()) == 0)
  {
    my @cmd = ($$test{path}, @{$$test{args}});

    my $name  = $$test{path} . join("", @{$$test{args}});
    $name =~ s/[^a-zA-Z0-0]//g;

    POSIX::close(0);
    POSIX::open("/dev/null", O_RDONLY);

    POSIX::close(1);
    POSIX::open("$$test{ipcdir}/run.log", O_WRONLY | O_CREAT | O_TRUNC) or die $!;

    POSIX::dup2(1, 2) or die $!;

    exec { $cmd[0] } @cmd;
  }

  $table{$$test{pid}} = $test;
}

while(($passed + $failed) <= $#tests)
{
  select(undef, undef, undef, .025);
}

printf("${GREEN}[%5s]${NONE} $passed\n", "PASS");
printf("${RED}[%5s]${NONE} $failed\n", "FAIL") if $failed;
exit(0) if $failed == 0;

print("\nsummary\n");
for my $test (@tests)
{
  next unless $$test{exit};
  printf("${RED}[%5s]${NONE} %3d $$test{path} @{$$test{args}}\n", "FAIL", $$test{'index'});
  printf(" %12s : %s\n", "projdir", $$test{projdir});
  printf(" %12s : %s\n", "ipcdir", $$test{ipcdir});
  printf(" %12s : %s\n", "run.log", "$$test{ipcdir}/run.log");
  printf(" %12s : %s (%s)\n", "fabd/stdout", "$$test{ipcdir}/fabd/stdout", (-s "$$test{ipcdir}/fabd/stdout" || 0));
  printf(" %12s : %s (%s)\n", "fabd/stderr", "$$test{ipcdir}/fabd/stderr", (-s "$$test{ipcdir}/fabd/stderr" || 0));
  system("grep -A 5 AddressSanitizer $$test{ipcdir}/fabd/stderr");
}
