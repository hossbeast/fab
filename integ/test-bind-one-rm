#!/usr/bin/env perl

#
# This test has a one-to-one bind rule whose target-set changes
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_projdir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'C');
setup(<<TREE);
|-- A
|   `-- foo
|       `-- bar
|-- C
|   `-- module.bam+devel <<
bind { name : 1 } foo => //foo
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      index : true
      mount : true
    }
  }
}
>>
TREE

# num targets : 1
assert {
  stats(undef, {
    modules => 1
  , system_state_ok => 1
  , rule_run => 1
})};
assert {
  stats("//fsindex", {
      del => 0
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("//module/rmas-by/name/1", {
      rule_run => 1
    , rule_run_ok => 1
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
    , target_hits => 1
    , attachment_hits => 1
})};

assert { ls("//foo", "foo -> $bam_basedir/A/foo") };

# num targets : 0
unlink("$bam_basedir/A/foo/bar");
rmdir("$bam_basedir/A/foo");
reconcile(tolerant => 1);

assert {
  stats(undef, {
    modules => 1
  , system_state_ok => 1
  , rule_run => 2
})};
assert {
  stats("//fsindex", {
      del => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("//module/rmas-by/name/1", {
      rule_run => 2
    , rule_run_ok => 1
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
    , target_hits => 0        # nomatch
    , attachment_hits => 1
})};

# nomatch ; the previous instantiation was cleaned up
assert { enoent("//foo") };

teardown();
