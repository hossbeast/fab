#!/usr/bin/env perl

#
# This test exercises use statements which are in rulesets which are referenced via use
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'A');
setup(<<TREE);
|-- A
|   `-- module.bam%devel <<
use B
rule -- foo : $bam_basedir/touch.bam+(.)
>>
|-- B
|   `-- rules.bam%devel <<
use C
rule foo -> bar : $bam_basedir/cp.bam+(.)
>>
|-- C
|   `-- rules.bam%devel <<
rule bar -> baz : $bam_basedir/cp.bam+(.)
>>
|-- system-config <<
namespaces : {
  coreutils
}
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
    $repodir/usr/share/bam/coreutils : {
      mount : true
      namespaces : {
        coreutils
      }
    }
  }
}
>>
|-- cp.bam << 0777
file : {
  lookup : {
    namespace : coreutils
    pattern : bin/cp+(.@)
  }
}
args : [
  \$bm_source0
  \$bm_target0
]
>>
|-- touch.bam << 0777
file : {
  lookup : {
    namespace : coreutils
    pattern : bin/touch+(@.)
  }
}
args : [
  \$bm_target0
]
>>
TREE

# before
assert {
  stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert {
  stats("$bam_basedir/A", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 3    # self (B), A, and C via A
  , rmas => 3
})};
assert {
  stats("$bam_basedir/A/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
  , modules => 1
})};
assert {
  stats("$bam_basedir/B/rules.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
  , modules => 1
})};
assert {
  stats("$bam_basedir/C/rules.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
  , modules => 1
})};
assert {
  stats("$bam_basedir/A", {
    type => 'dir'
  , rules => 2        # rules from B, C, match in this dir
})};

build();

teardown();
