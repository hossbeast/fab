#!/usr/bin/env perl

#
# This test uses the rulesfiles directive in the module file in order to load an additional
# rules file in the same directory
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# build out the fstree under /tmp
init();
my $testdir = setup(<<TREE);
|-- module.bam+devel <<
rulesets myrules
>>
|-- myrules+devel <<
rule a -> b
>>
TREE

my $mod_id = hash64("$bam_basedir");
my $rules_id = hash64("$bam_basedir/myrules+devel");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("myrules+devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse => 1
  , parse_ok => 1
})};

assert { ls("//modules/$mod_id/rulesets/$rules_id", "$rules_id -> //rulesets/$rules_id") };

teardown();
