#!/usr/bin/env perl

#
# Exercises the case where two modules use the same rule, and that rule
# contains references to shadow nodes which should resolve differently
# between the two modules
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_projdir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init();
my $testdir = setup(<<'TREE');
|-- system-config <<
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}
>>
|-- cp.bam << 0777
file : {
  path-search : cp    # this needs the config to resolve
}
args : [
  $bm_source0
  $bm_target0
]
>>
|-- rules.bam.devel+devel <<
rule { name : 1 } //module/base/x -> $^D/y : cp.bam
rule //module/base/y -> //targets
>>
|-- B
|   `-- module.bam+devel <<
rulesets rules.bam.devel
>>
|   `-- x <<
Bx
>>
|-- C
|   `-- module.bam+devel <<
rulesets rules.bam.devel
>>
|   `-- x <<
Cx
>>
TREE

assert { stats(undef, "--no-module", { modules => 2 })}; # B, C
assert {
  stats("B", "-S", "-S", "--no-module", {
      type => 'module'
    , state => 'fresh'
    , reloaded => 1
    , modules_up => 0
    , modules_down => 0
    , parse => 1
    , parse_ok => 1
    , fresh => 1
    , stale => 1
    , rules => 0      # rules in the modules' rules file
})};
assert { stats("B", "--no-module", {
    type => 'module-dir'
  , state => 'fresh'
  , rules => 2        # rules attached to the directory
})};
assert { stats("C", "-S", "-S", "--no-module", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , modules_up => 0
  , modules_down => 0
  , parse => 1
  , parse_ok => 1
  , fresh => 1
  , stale => 1
  , rules => 0      # rule in the modules' rules file
})};
assert { stats("C", "--no-module", {
    type => 'module-dir'
  , state => 'fresh'
  , rules => 2      # rules attached to the module
})};

build();
assert_file("$testdir/B/y", "Bx");
assert_file("$testdir/C/y", "Cx");
