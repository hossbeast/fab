#!/usr/bin/env perl

#
# This test creates two nested directories, then creates a module file in the subdirectory
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup(<<'TREE');
|-- A
|   `-- foo
`-- module.bam%devel
TREE

my $fh;

# before
assert {
  stats(undef, {
    modules => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
})};

# create the child module file
open $fh, ">>", "$bam_basedir/A/module.bam%devel" or die $!;
print $fh "\n";
close $fh;

# after
reconcile();
assert { stats(undef, { modules => 2 })};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("A", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("A/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};

teardown();
