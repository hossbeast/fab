#!/usr/bin/env perl

#
# exercise the autobuild command - spawn bam autobuild in the background and verify
# it automatically rebuilds when files change.
# in this test, building fails, and the primary files are modified to fix the failure
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_dir;
our $bam_bampath;
our $bam_invalidate;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# build out the fstree under /tmp
init();
setup(<<TREE);
|-- cores.c <<
foo
>>
|-- module.bam%devel <<
rule cores.c -> cores.o : ./check-and-cp.bam+(.)
rule cores.o -> cores : ./check-and-cp.bam+(.)
rule cores -> //targets
>>
|-- check-and-cp.bam << 0777
#!/usr/bin/env perl
open A, "<", \$ENV{bm_source0} or die \$!;
while(<A>)
{
  die if /foo/;
}
close A;

open A, "<", \$ENV{bm_source0} or die \$!;
open B, ">", \$ENV{bm_target0} or die \$!;
while(<A>)
{
  print B "\$_";
}
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      invalidation : notify
    }
  }
}
>>
TREE

# this test only makes sense when the primary files are being monitored with notify
exit if $bam_invalidate ne "notify";

my $fh;
my $child;
my $res;
my $x;
my $goals;

sub poll_auto
{
  for($x = 0; $x < 5; $x++)
  {
    $res = poll($child, show => 1);
    if(exists($$child{status})) {
      print("[$$child{pid}] status $$child{status} out ".length($$child{out})." err ".length($$child{err})."] " . join(" ", @{$$child{cmd}}) . "\n");
      last;
    }
  }
}

#
# check initial state
#
print("\n >> 1 - INITIAL STATE <<\n\n");

assert {
  stats("cores.c", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert {
  stats("cores.o", {
    type => 'file'
  , state => 'uncreated'
  , stale => 0
  , fresh => 0
})};
assert {
  stats("cores", {
    type => 'file'
  , state => 'uncreated'
  , stale => 0
  , fresh => 0
})};

#
# spawn autobuild and wait for initial build, which is going to fail
#
print("\n >> 2 - SPAWN AUTOBUILD <<\n\n");

$child = spawn({ cwd => $bam_dir }
  , $bam_bampath
  , "--no-launch"
  , "--no-color"
  , "autobuild"
);

print("[$$child{pid}] " .  join(" ", @{$$child{cmd}}) . "\n");
poll_auto();

# verify initial build completed
assert { enoent("$bam_basedir/cores.o") };
assert { enoent("$bam_basedir/cores") };

$goals = bam_goals();
assert { $$goals{label} eq 'bam-autobuild' };

assert {
  stats(undef, {
    system_state_ok => 0
  , system_state_err => 1
})};
assert {
  stats("cores.c", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};

#
# modify source file, fix the issue, and verify automatic rebuild
#
print("\n >> 3 - MODIFY SOURCE <<\n\n");

open $fh, ">", "$bam_basedir/cores.c" or die $!;
print $fh "bar\n";
close $fh;

reconcile();
poll_auto();

assert_file("$bam_basedir/cores.o", "bar");
assert_file("$bam_basedir/cores", "bar");

assert {
  stats(undef, {
    system_state_ok => 1
  , system_state_err => 1
})};
assert {
  stats("cores.c", {
    type => 'file'
  , state => 'fresh'
  , stale => 1
  , fresh => 2
})};
assert {
  stats("cores.o", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert {
  stats("cores", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};

#
# delete intermediate target and verify rebuild
#
print("\n >> 4 - DELETE INTERMEDIATE TARGET <<\n\n");

unlink("$bam_basedir/cores.o") or die $!;

reconcile();
poll_auto();

assert_file("$bam_basedir/cores.o", "bar");
assert_file("$bam_basedir/cores", "bar");

assert {
  stats(undef, {
    system_state_ok => 2
  , system_state_err => 1
})};
assert {
  stats("cores.o", {
    type => 'file'
  , state => 'fresh'
  , stale => 1
  , fresh => 2
})};
assert {
  stats("cores", {
    type => 'file'
  , state => 'fresh'
  , stale => 1
  , fresh => 2
})};

#
# delete final target and verify rebuild
#
print("\n >> 5 - DELETE FINAL TARGET <<\n\n");

unlink("$bam_basedir/cores") or die $!;

reconcile();
poll_auto();

assert_file("$bam_basedir/cores", "bar");

assert {
  stats(undef, {
    system_state_ok => 3
  , system_state_err => 1
})};
assert {
  stats("cores", {
    type => 'file'
  , state => 'fresh'
  , stale => 2
  , fresh => 3
})};

#
# teardown the autobuild client
#
print("\n >> 5 - TEARDOWN <<\n\n");

kill(15, $$child{pid}) or die $!;
poll_auto();
assert { $$child{status} == 0 };

teardown();
