#!/usr/bin/env perl

#
# setup with nested modules, delete them one by one
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# build out the fstree under /tmp
init();
setup(<<'TREE');
|-- A
|   `-- B
|       |-- C
|       |   |-- foo
|       |   `-- module.bam%devel
|       `-- module.bam%devel
`-- module.bam%devel
TREE

print("\n >> 1 - initial + B and C <<\n\n");

assert { stats(undef, { modules => 3 })};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("A/B", "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
})};
assert {
  stats("A/B/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("A/B/C", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , fresh => 1
  , stale => 1
})};
assert {
  stats("A/B/C/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};

print("\n >> 2 - delete B <<\n\n");

unlink("$bam_basedir/A/B/module.bam%devel") or die $!;
reconcile();

assert { stats(undef, { modules => 2 })};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("A/B/C", "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
})};
assert {
  stats("A/B/C/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};

assert { enoent("A/B", "-S") };

print("\n >> 2 - delete C <<\n\n");

unlink("$bam_basedir/A/B/C/module.bam%devel") or die $!;
reconcile();

assert { stats(undef, { modules => 1 })};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};

assert { enoent("A/B", "-S") };
assert { enoent("A/B/C", "-S") };

teardown();
