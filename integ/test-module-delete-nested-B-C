#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init();
my $testdir = setup(<<'TREE');
|-- A
|   `-- B
|       |-- C
|       |   `-- module.bam+devel
|       `-- module.bam+devel
`-- module.bam+devel
TREE

assert { stats(undef, { modules => 3 })};
assert { stats(".", "-S", {
    reloaded => 1
  , modules_up => 0
  , modules_down => 1
  , fresh => 1
  , stale => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("A/B", "-S", {
    reloaded => 1
  , modules_up => 1
  , modules_down => 1
  , fresh => 1
  , stale => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("A/B/C", "-S", {
    reloaded => 1
  , modules_up => 1
  , modules_down => 0
  , fresh => 1
  , stale => 1
  , parse => 1
  , parse_ok => 1
})};

unlink("$testdir/A/B/module.bam+devel") or die $!;
reconcile();

assert { stats(undef, { modules => 2 })};
assert { stats(".", "-S", {
    reloaded => 1
  , modules_up => 0
  , modules_down => 1
  , fresh => 1
  , stale => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("A/B/C", "-S", {
    reloaded => 1
  , modules_up => 1
  , modules_down => 0
  , fresh => 1
  , stale => 1
  , parse => 1
  , parse_ok => 1
})};

unlink("$testdir/A/B/C/module.bam+devel") or die $!;
reconcile();

assert { stats(undef, { modules => 1 })};
assert { stats(".", "-S", {
    reloaded => 1
  , modules_up => 0
  , modules_down => 0
  , fresh => 1
  , stale => 1
  , parse => 1
  , parse_ok => 1
})};
teardown();
