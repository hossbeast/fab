#!/usr/bin/env perl

#
# Delete a rules.bam file while it is being referenced by another module via a uses ref
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# module file with ambiguous reference
init(subdir => 'B');
setup(<<TREE);
|-- A
|   `-- rules.bam%devel <<
rule foo -> bar
>>
|   `-- foo
|-- B
|   `-- module.bam%devel <<
use A
>>
|   `-- foo
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
  }
}
>>
TREE

my $A_rules_id = bam::identity("ruleset", "$bam_basedir/A/rules.bam%devel");

# before
assert {
  stats(undef, {
    system_state_ready => 1
  , modules => 1
  , rulesets => 2
  , fsnames => 2
  , fstrees => 4
  , namespaces => 3
  , varsets => 0
})};
assert { 
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
  , rulesets => 2      # one rules.bam reference
})};
assert { 
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , rules => 0          # rules defined in module.bam
})};
assert {
  stats(".", {
    type => 'dir'
  , rules => 1          # rules attached to this dir
})};
assert {
  stats("..", {
    type => 'dir'
})};
assert {
  stats("../A", {
    type => 'dir'
})};
assert {
  stats("../A/rules.bam%devel", "-S", {
    type => "ruleset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
  , rules => 1
  , modules => 1
})};

assert { ls("//module/rulesets/$A_rules_id", "$A_rules_id -> //bm/rulesets/$A_rules_id") };

# delete the referent
unlink("$bam_basedir/A/rules.bam%devel") or die $!;

reconcile(expect_error => 1); # B/module.bam%devel now has unresolved use reference
assert {
  stats(undef, {
    system_state_ready => 1
  , modules => 1
  , rulesets => 1
  , fsnames => 2
  , fstrees => 4
  , namespaces => 3
  , varsets => 0
})};
assert {
  stats(".", "-S", {
    state => 'stale'      # invalidated when the EDGE_USES edge was disconnected
  , type => 'module'
  , fresh => 1
  , stale => 2
  , reloaded => 1         # not reloaded
  , rulesets => 1         # no rules.bam references
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , rules => 0
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats(".", {
    type => 'dir'
  , rules => 0            # no rules in effect
})};
assert {
  stats("..", {
    type => 'dir'
})};
assert {
  stats("../A", {
    type => 'dir'
})};

assert { enoent("//module/rules/$A_rules_id") };

# delete the contents of the module file, removing the uses reference to A
open my $fh, ">", "$bam_basedir/B/module.bam%devel" or die $!;
close $fh;
reconcile();

assert {
  stats(undef, {
    modules => 1
  , system_state_ready => 2
})};
assert {
  stats(".", "-S", {
    reloaded => 2         # now reloaded
  , state => 'fresh'      # now fresh
  , type => 'module'
  , fresh => 2
  , stale => 2
  , rulesets => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'      # now fresh
  , fresh => 2
  , stale => 2
  , rules => 0
  , parse_err => 0        # now re-parse_ok
  , parse_ok => 2
})};
assert {
  stats(".", {
    type => 'dir'
  , rules => 0            # no rules in effect
})};
assert {
  stats("..", {
    type => 'dir'
})};
assert {
  stats("../A", {
    type => 'dir'
})};

assert { enoent("//module/rules/$A_rules_id") };

teardown();
