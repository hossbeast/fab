#!/usr/bin/env perl

#
# if a plugin fails to become ready reconcile times out
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_dir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();

# expect error because the plugin does not send plugin-ready
setup({ expect_error => 1 }, <<TREE);
|-- module.bam%devel <<
>>
|-- plugin << 0755
#!/usr/bin/env perl
# does nothing, just exits with error
exit(1);
>>
|-- config.bam%devel <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        formulas
      }
    }
  }
}
plugins : {
  [
    {
      file : {
        lookup : {
          pattern : ./plugin+(.)
          namespace : formulas
        }
      }
    }
  ]
}
>>
TREE

my $plugin_id = bam::identity("plugin", "$bam_basedir/plugin", 'plugin');

assert {
  info(undef, {
    "system-state" => 'plugin-reconcile'
})};
assert {
  stats(undef, {
      system_state_ok => 0
    , system_state_ready => 0
    , system_state_plugin_reconcile => 1
})};
assert { stats("$bam_basedir/plugin", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert { stats("//bm/plugins/$plugin_id", "-S", {
    type => 'plugin'
  , state => 'stale'
  , stale => 1
  , fresh => 0
  , commands => 0
  , crashed => 1
  , events => 0
  , fork => 1
  , ready => 0
  , reap => 1
  , tx_parse_err => 0
})};

# fix the plugin
open my $fh, ">", "$bam_basedir/plugin" or die $!;
print $fh <<'TEXT';
#!/usr/bin/env perl

use POSIX;

my $s = <<MSG;
plugin-ready

MSG

while(1) {
  POSIX::write(1001, $s, length($s));
  <STDIN>;
}
TEXT
close $fh;

# after
reconcile();

assert {
  info(undef, {
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
      system_state_ok => 0
    , system_state_ready => 1
    , system_state_plugin_reconcile => 2
})};
assert { stats("$bam_basedir/plugin", {
    type => 'file'
  , state => 'fresh'
  , stale => 1
  , fresh => 2
})};
assert { stats("//bm/plugins/$plugin_id", "-S", {
    type => 'plugin'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , commands => 0
  , crashed => 1
  , events => 0
  , fork => 2
  , ready => 1
  , reap => 1
  , tx_parse_err => 0
})};

teardown();
