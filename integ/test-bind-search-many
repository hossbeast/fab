#!/usr/bin/env perl

#
# bind rule with search pattern on the lhs
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_dir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<TREE);
|-- B
|   `-- module.bam%devel <<
rule { name : beef } */foo+(.) => [*] //foo
>>
|   `-- A
|      `-- foo
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
  }
}
>>
TREE

my $modules_ns_id = bam::identity("namespace", "modules");
my $B_A_foo_id = bam::identity("file", "$bam_basedir/B/A/foo");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
  , rule_run => 1
})};
assert {
  stats("//bm/namespaces/$modules_ns_id", "-S", {
      del => 0
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("//module/rmas-by/name/beef", "--follow", {
      rule_run => 1
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
    , search_hits => 1
    , target_hits => 0
    , attachment_hits => 1
})};

assert { ls("//foo", "foo - shadow-dir fresh", "--max-distance", "0") };
assert { ls("//foo/$B_A_foo_id", "$B_A_foo_id -> $bam_basedir/B/A/foo") };

teardown();
