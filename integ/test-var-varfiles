#!/usr/bin/env perl

#
# This test uses the varfiles directive in the module file in order to load an additional
# var file in the same directory
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use util;
use tree;
use bam;

# build out the fstree under /tmp
init();
my $testdir = setup(<<TREE);
|-- module.bam+devel <<
varfiles myvar
>>
|-- myvar+devel <<
a : 42
>>
TREE

my $mod_id = hash64("$bam_basedir");
my $var_id = hash64("$bam_basedir/myvar+devel");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("myvar+devel", "-S", {
    type => 'var'
  , state => "fresh"
  , parse => 1
  , parse_ok => 1
})};

my $result = bam_ls(["//modules/$mod_id/var/$var_id", "--no-follow"]);
my $ref = $$result{out};
assert { $ref eq "$var_id -> $bam_basedir/myvar+devel" };

teardown();
