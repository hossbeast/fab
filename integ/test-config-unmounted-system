#!/usr/bin/env perl

#
# Normally, only directory-level inotify watches are used.
# However, special files (including config files) are monitored with file-level
# watches when they are in an unmounted inotify fstree
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_invalidate;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# notify-specific stats assertions
init(subdir => 'B');
exit 0 if $bam_invalidate ne 'notify';

setup(<<"TREE");
|-- system-config
|-- B
|   `-- module.bam+devel
TREE

# 1. empty system-config file
assert { info({
    "system-state" => 'ok'
})};
assert { stats(undef, {
    system_state_ok => 1
  , configset_files => 1
})};
# system-config is outside any mounted fstree and is thus watched directly
assert { stats("//notify", {
    count => 2
})};
assert { stats(".", {
    type => 'module-dir'
  , state => 'fresh'
  , indexed_lookup => 1
  , indexed_notify => 1
})};
assert { stats("../system-config", {
    type => 'configset-file'
  , state => 'fresh'
  , indexed_notify => 1
})};
assert { stats("../system-config", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};

# no user-config file
assert { enoent("$bam_basedir/user-config") };

# 2. system-config deleted
unlink("$bam_basedir/system-config");

reconcile();
assert { info({
    "system-state" => 'ok'
})};
assert { stats(undef, {
    system_state_ok => 2
  , configset_files => 0
})};
assert { stats("//notify", {
    count => 1
})};
assert { enoent("$bam_basedir/system-config") };

# 3. system-config restored
open my $fh, ">", "$bam_basedir/system-config" or die $!;
print $fh <<'TEXT';
TEXT
close $fh;

reconcile();
assert { info({
    "system-state" => 'ok'
})};
assert { stats(undef, {
    system_state_ok => 3
  , configset_files => 1
})};
assert { stats("//notify", {
    count => 2
})};
assert { stats("../system-config", {
    type => 'configset-file'
  , state => 'fresh'
  , indexed_notify => 1
})};
assert { stats("../system-config", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};

# 4. system-config changed
open $fh, ">", "$bam_basedir/system-config" or die $!;
print $fh <<'TEXT';
build : {
  concurrency : 42
}
TEXT
close $fh;

reconcile();
assert { info({
    "system-state" => 'ok'
})};
assert { stats(undef, {
    system_state_ok => 4
  , configset_files => 1
})};
assert { stats("//notify", {
    count => 2
})};
assert { stats("../system-config", {
    type => 'configset-file'
  , state => 'fresh'
  , indexed_notify => 1
})};
assert { stats("../system-config", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 2
  , parse_ok => 2
})};

# no user-config file but the node exists as uncreated
assert { enoent("$bam_basedir/user-config") };

teardown();
