#!/usr/bin/env perl

#
# This test exercises a changing one-to-one bind rule
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup(<<"TREE");
|-- module.bam%devel <<
bind B => //A
>>
|-- B
|   |-- foo
|-- C
|   |-- foo
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
  }
}   
TREE

# 1. one target
print("\n >> 1 - one target <<\n\n");
assert {
  stats(undef, {
    system_state_ready => 1
  , system_state_ok => 0
  , system_error => 0
  , fstrees => 3
  , namespaces => 3
  , modules => 1
  , rules => 1
  , rulesets => 1
  , rmas => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , rules => 1
  , parse_err => 0
  , parse_ok => 1
})};

assert { ls("//A", "A -> $bam_basedir/B") };

print("\n >> 2 - zero targets, error case <<\n\n");
open my $fh, ">", "$bam_basedir/module.bam%devel" or die $!;
print $fh <<'TEXT';
bind D => //A
TEXT
close $fh;

reconcile(expect_error => 1);
assert {
  info({
    "system-state" => 'rule-reconcile'
})};
assert {
  stats(undef, {
    system_state_ready => 1
  , system_state_ok => 0
  , system_error => 1
  , fstrees => 3
  , namespaces => 3
  , modules => 1
  , rules => 1
  , rulesets => 1
  , rmas => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 2
  , rulesets => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , rules => 1
  , parse_err => 0
  , parse_ok => 2
})};

# the attachment point is still created
assert { eexists("//A") };

# 3. one target - different target
print("\n >> 3 - one target, different target <<\n\n");
open $fh, ">", "$bam_basedir/module.bam%devel" or die $!;
print $fh <<'TEXT';
bind C => //A
TEXT
close $fh;

reconcile();
assert {
  stats(undef, {
    system_state_ready => 2
  , system_state_ok => 0
  , system_error => 0
  , fstrees => 3
  , namespaces => 3
  , modules => 1
  , rules => 1
  , rulesets => 1
  , rmas => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 3
  , rulesets => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , rules => 1
  , parse_err => 0
  , parse_ok => 3
})};

# bind target
assert { ls("//A", "A -> $bam_basedir/C") };

teardown();
