#!/usr/bin/env perl

#
# This test uses multiple var.bam files which are merged, and then asserts about the resulting
# output of the vars and env subcommands
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# build out the fstree under /tmp
init(subdir => 'B');
setup(<<'TREE');
|-- var.bam%devel <<
A : 1   # outer
>>
|-- B
|   `-- module.bam%devel
|   `-- var.bam%devel <<
B : 1   # inner
>>
|-- system-config <<
filesystem : {
  special : {
    var.bam%devel
  }
}
>>
TREE

# before
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1
})};
assert { stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("$bam_basedir/var.bam%devel", "-S", {
    type => 'varset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("$bam_basedir/B/var.bam%devel", "-S", {
    type => 'varset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};

my $text;
my $fh;

$text = bam_module_vars();
assert { $text =~ /A : 1/ };
assert { $text =~ /B : 1/ };
assert { $text !~ /C/ };
assert { $text !~ /D/ };

$text = bam_module_envs();
assert { $text =~ /A=1/ };
assert { $text =~ /B=1/ };
assert { $text !~ /C/ };
assert { $text !~ /D/ };

# rewrite the outer var file
open $fh, ">", "$bam_basedir/var.bam%devel" or die $!;
print $fh <<'TEXT';
C : 1
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ready => 2
})};
assert { stats("$bam_basedir/var.bam%devel", "-S", {
    type => "varset"
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 2
})};
assert { stats("$bam_basedir/B/var.bam%devel", "-S", {
    type => "varset"
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 2  # invalidation of connected var file induces module reload
})};
assert { stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};

$text = bam_module_vars();
assert { $text !~ /A :/ };
assert { $text =~ /B :/ };
assert { $text =~ /C :/ };
assert { $text !~ /D :/ };
$text = bam_module_envs();
assert { $text !~ /A=/ };
assert { $text =~ /B=/ };
assert { $text =~ /C=/ };
assert { $text !~ /D=/ };

# modify the inner var file
open $fh, ">", "$bam_basedir/B/var.bam%devel" or die $!;
print $fh <<'TEXT';
D : 1
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ready => 3
})};
assert { stats("$bam_basedir/var.bam%devel", "-S", {
    type => "varset"
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 2
})};
assert { stats("$bam_basedir/B/var.bam%devel", "-S", {
    type => "varset"
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 2
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 3  # invalidation of connected var file induces module reload
})};
assert { stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};

$text = bam_module_vars();
print("$text\n");
assert { $text !~ /A :/ };
assert { $text !~ /B :/ };
assert { $text =~ /C :/ };
assert { $text =~ /D :/ };

$text = bam_module_envs();
print("$text\n");
assert { $text !~ /A=/ };
assert { $text !~ /B=/ };
assert { $text =~ /C=/ };
assert { $text =~ /D=/ };

teardown();
