#!/usr/bin/env perl

#
# 
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_projhash;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# build out the fstree under /tmp
init();
my $testdir = setup(<<'TREE');
|-- module.bam+devel <<
rule { name : 1 } -- boats : foo.bam
rule boats -> //targets
>>
|-- foo.bam << 0777
#!/usr/bin/env perl
open FH, ">>", $ENV{bm_target0} or die $!;
print FH "hi\n";
close FH;
>>
TREE

# before
assert {
  stats(undef, {
    modules => 1
  , system_error => 0
  , system_state_ok => 1
})};
assert {
  stats(".", "-S", {
    type => "module"
  , reloaded => 1
  , state => "fresh"
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("foo.bam", "-S", {
    type => 'formula'
  , state => "fresh"
  , parse_ok => 1
  , parse => 1
})};
assert {
  stats("boats", {
      state => "uncreated"
    , stale => 0    # counting state transitions
    , fresh => 0
})};
assert {
  stats("//modules/$bam_projhash/rmas-by/name/1", {
    rule_run => 1
  , rule_run_ok => 1
})};

# build - creates the file
build();
assert {
  stats(undef, {
    modules => 1
  , system_error => 0
  , system_state_ok => 3      # one for reconcile -> ok, one for build -> ok
})};
assert {
  stats("foo.bam", "-S", {
    state => "fresh"
  , parse_ok => 1
  , parse => 1
})};
assert {
  stats("boats", {
      state => "fresh"
    , stale => 0    # counting state transitions
    , fresh => 1
})};
assert {
  stats("//modules/$bam_projhash/rmas-by/name/1", {
    rule_run => 1
  , rule_run_ok => 1
})};

# delete the formula file - the rule fml ref is now unresolved
unlink("$testdir/foo.bam") or die $!;
reconcile(expect_error => 1);

assert {
  stats(undef, {
    modules => 1
  , system_state_ok => 3
  , system_error => 1
})};
assert {
  info({
    "system-state" => 'rule-reconcile'
})};

# foo.bam was deleted during filesystem-reconcile, then re-created in the uncreated
# state during rules-reconcile, since it is the target of the formula ref
#assert { uncreated("foo.bam") };
assert {
  stats(".", "-S", {
    type => "module"
  , state => "fresh"      # the module is not invalidated
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};

# boats marked stale when the formula was deleted
# -> boats dependency removed during subsequent rules reconcile
# NOTE : boats will be marked fresh during fsent freshen, at the end of the next successful reconcile
assert {
  stats("boats", {
      state => "stale"
    , stale => 1          # counting state transitions
    , fresh => 1
})};
assert {
  stats("//modules/$bam_projhash/rmas-by/name/1", {
    rule_run => 2
  , rule_run_ok => 1
})};
teardown();
