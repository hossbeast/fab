#!/usr/bin/env perl

#
# This test changes the walker configuration so that portions of the filesystem tree
# which previously had been in use, are no longer in use.
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<"TREE");
|-- module.bam%devel
|-- A
|   `-- foo
|       `-- bar
|   `-- baz
|       `-- qux
|-- B
|   `-- module.bam%devel <<
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir/A/foo : { # only this subtree is visible
      mount : true
    }
  }
}
>>
TREE

# before
assert {
  stats(undef, { modules => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , varsets => 0
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , rules => 0
})};

assert { eexists("$bam_basedir/A/foo") };
assert { eexists("$bam_basedir/A/foo/bar") };
assert { enoent("$bam_basedir/A/baz") };
assert { enoent("$bam_basedir/A/baz/qux") };

open FH, ">$bam_basedir/system-config" or die $!;
print FH <<TREE;
filesystem : {
  fstrees : {
    $bam_basedir/A/baz : { # now only this subtree is visible
      mount : true
    }
  }
}
TREE
close FH;
reconcile();

# after
assert { stats(undef, { modules => 1 }) };
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , varsets => 0
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , rules => 0
})};

assert { enoent("$bam_basedir/A/foo") };
assert { enoent("$bam_basedir/A/foo/bar") };
assert { eexists("$bam_basedir/A/baz") };
assert { eexists("$bam_basedir/A/baz/qux") };

teardown();
