#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# build out the fstree under /tmp
init();
my $testdir = setup(<<'TREE');
|-- module.bam%devel
|-- var.bam%devel <<
A : [
  B C
]
>>
TREE

# before
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("var.bam%devel", "-S", {
    parse_err => 0
  , parse_ok => 1
  , state => "fresh"
})};

my $vars = bam_module_vars();
print("$vars\n");
assert { $vars =~ /B/ };
assert { $vars =~ /C/ };

# modify the var file
open my $fh, ">>", "$testdir/var.bam%devel" or die $!;
print $fh <<'TEXT';
A : [
  B
]
TEXT
close $fh;

# after - var file change in same dir causes the module to be reloaded
reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ready => 2
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 2
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("var.bam%devel", "-S", {
    parse_err => 0
  , parse_ok => 2
  , state => "fresh"
})};

$vars = bam_module_vars();
print("$vars\n");
assert { $vars =~ /B/ };
assert { $vars !~ /C/ };

teardown();
