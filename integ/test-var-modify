#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use util;
use tree;
use bam;

# build out the fstree under /tmp
init();
my $testdir = setup(<<'TREE');
|-- module.bam+devel
|-- var.bam+devel <<
lflags : [
  -lasan -lubsan
]
>>
TREE

# before
assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("var.bam+devel", "-S", {
    parse => 1
  , parse_ok => 1
  , state => "fresh"
})};

print(bam_vars(), "\n");

# modify the var file
open my $fh, ">>", "$testdir/var.bam+devel" or die $!;
print $fh <<'TEXT';
lflags : [
  -lpcre
]
TEXT
close $fh;

# after - var file change in same dir causes the module to be reloaded
reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ok => 2
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 2
  , parse => 1
  , parse_ok => 1
})};
assert { stats("var.bam+devel", "-S", {
    parse => 2
  , parse_ok => 2
  , state => "fresh"
})};

print(bam_vars(), "\n");

teardown();
