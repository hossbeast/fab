#!/usr/bin/env perl

#
# When they are in a mounted filesystem tree, config files are watched via their directory
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_dir;
our $bam_invalidate;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# notify-specific stats assertions
init();
exit 0 if $bam_invalidate ne 'notify';

setup(<<"TREE");
|-- module.bam%devel
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_dir : {
      mount : true
      namespaces : {
        modules
      }
    }
  }
}
>>
TREE

# 1. empty system-config file
assert {
  info({
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
    system_state_ready => 1
  , configsets => 2
})};
# system-config is within a mounted fstree and is not watched directly
assert {
  stats("//bm/sys-notify", "--follow", {
    count => 2  # test dir, user-config
  , put => 3
  , file_put => 1     # system-config
  , file_del => 1     # system-config
  , dir_put => 1      # test-dir
  , symlink_put => 1  # user-config
})};
assert {
  stats(".", {
    type => 'dir'
  , state => 'fresh'
  , indexed_lookup => 1
  , indexed_notify => 1
})};

assert { eexists("system-config") };
assert {
  stats("system-config", {
    type => 'file'
  , state => 'fresh'
  , indexed_notify => 0
})};
assert {
  stats("system-config", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};

# 2. system-config deleted
unlink("$bam_basedir/system-config");

reconcile();
assert {
  info({
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
    system_state_ready => 2
  , configsets => 1   # the default user-config
})};
assert {
  stats("//bm/sys-notify", "--follow", {
    count => 2  # test dir, user-config
  , put => 3
  , file_put => 1     # system-config
  , file_del => 1     # system-config
  , dir_put => 1      # test-dir
  , symlink_put => 1  # user-config
})};
assert { enoent("system-config") };

# 3. system-config restored
open my $fh, ">", "$bam_basedir/system-config" or die $!;
print $fh <<'TEXT';
TEXT
close $fh;

reconcile();

assert {
  info({
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
    system_state_ready => 3
  , configsets => 2
})};
assert {
  stats("//bm/sys-notify", "--follow", {
    count => 2  # test dir, user-config
  , put => 3
  , file_put => 1     # system-config
  , file_del => 1     # system-config
  , dir_put => 1      # test-dir
  , symlink_put => 1  # user-config
})};
assert {
  stats("system-config", {
    type => 'file'
  , state => 'fresh'
  , indexed_notify => 0
})};
assert {
  stats("system-config", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};

# 4. system-config changed
open $fh, ">", "$bam_basedir/system-config" or die $!;
print $fh <<'TEXT';
build : {
  concurrency : 42
}
TEXT
close $fh;

reconcile();

assert {
  info({
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
    system_state_ready => 4
  , configsets => 2
})};
assert {
  stats("//bm/sys-notify", "--follow", {
    count => 2  # test dir, user-config
  , put => 3
  , file_put => 1     # system-config
  , file_del => 1     # system-config
  , dir_put => 1      # test-dir
  , symlink_put => 1  # user-config
})};
assert {
  stats("system-config", {
    type => 'file'
  , state => 'fresh'
  , indexed_notify => 0
})};
assert {
  stats("system-config", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 2
})};

teardown();
