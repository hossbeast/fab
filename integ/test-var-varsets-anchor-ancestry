#!/usr/bin/env perl

#
# This test uses the varfiles directive in the module file in order to load additional
# var files in the module anchor dir ancestry
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# build out the fstree under /tmp
init(subdir => 'B');
my $testdir = setup(<<TREE);
|-- A
|   `-- myvar%devel <<
>>
|   `-- C
|       `-- myvar%devel <<
>>
|-- B
|   `-- module.bam%devel <<
anchor ../A/C
varsets myvar%devel
>>
|-- myvar%devel <<
>>
|-- system-config <<
filesystem : {
  exclude : {
    foo
  }
  fstrees : {
    $bam_basedir : {
      mount : true
    }
    / : {
      mkdir : true
    }
  }
}
>>
TREE

my $mod_id = bam::identity('module', "$bam_basedir/B");
my $var_1_id = bam::identity("varset", "$bam_basedir/A/myvar%devel");
my $var_2_id = bam::identity("varset", "$bam_basedir/A/C/myvar%devel");
my $result;
my $ref;

# before
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("$bam_basedir/myvar%devel", "-S", {
    type => "varset"
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};

$result = bam_ls(["//bm/modules/$mod_id/varsets/$var_1_id", "--no-follow"]);
$ref = $$result{out};
print("$ref\n");
assert { $ref eq "$var_1_id -> //bm/varsets/$var_1_id" };

$result = bam_ls(["//bm/modules/$mod_id/varsets/$var_2_id", "--no-follow"]);
$ref = $$result{out};
print("$ref\n");
assert { $ref eq "$var_2_id -> //bm/varsets/$var_2_id" };

teardown();
