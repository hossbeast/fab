#!/usr/bin/env perl

#
# This test uses the varfiles directive in the module file in order to load additional
# var files in the module anchor dir ancestry
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# build out the fstree under /tmp
init(subdir => 'B');
my $testdir = setup(<<TREE);
|-- A
|   `-- myvar+devel <<
>>
|   `-- C
|       `-- myvar+devel <<
>>
|-- B
|   `-- module.bam+devel <<
anchor ../A/C
varsets myvar
>>
|-- myvar+devel <<
>>
|-- system-config <<
filesystem : {
  exclude : {
    foo
  }
  fstrees : {
    $bam_basedir : {
      mount : true
    }
    / : {
      mkdir : true
      index : true
    }
  }
}
>>
TREE

my $mod_id = hash64("$bam_basedir/B");
my $var_1_id = hash64("$bam_basedir/A/myvar+devel");
my $var_2_id = hash64("$bam_basedir/A/C/myvar+devel");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("$bam_basedir/myvar+devel", "-S", {
    type => "varset"
  , state => "fresh"
  , parse => 1
  , parse_ok => 1
})};

my $result = bam_ls(["//modules/$mod_id/varsets/$var_1_id", "--no-follow"]);
my $ref = $$result{out};
print("$ref\n");
assert { $ref eq "$var_1_id -> //varsets/$var_1_id" };

$result = bam_ls(["//modules/$mod_id/varsets/$var_2_id", "--no-follow"]);
$ref = $$result{out};
print("$ref\n");
assert { $ref eq "$var_2_id -> //varsets/$var_2_id" };

teardown();
