#!/usr/bin/env perl

#
# plugin sends an invalid request before becoming ready
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_dir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup({ tolerant => 1 }, <<TREE);
|-- module.bam%devel <<
>>
|-- plugin << 0755
#!/usr/bin/env perl
use POSIX;
my \$exit = 0;
\$SIG{TERM} = sub { \$exit = 1 };
POSIX::write(1001, "garbage\n\n", 9);
while(!\$exit) { sleep 1; }
>>
|-- config.bam%devel <<
plugins : {
  [
    {
      file : {
        lookup : {
          pattern : $bam_basedir/plugin
        }
      }
    }
  ]
}
>>
TREE

my $plugin_id = bam::identity("plugin", "$bam_basedir/plugin", 'plugin');
my $text;

assert {
  info(undef, {
    "system-state" => 'plugin-reconcile'
})};
assert {
  stats(undef, {
      system_state_ready => 0
    , system_state_plugin_reconcile => 1
})};
assert { stats("//bm/plugins/$plugin_id", "-S", {
    type => 'plugin'
  , state => 'stale'
  , stale => 1
  , fresh => 0
  , fork => 1
  , crashed => 0
  , tx_parse_err => 1
  , reap => 1
  , ready => 0
  , events => 0
  , commands => 0
})};

# fix the plugin
open my $fh, ">", "$bam_basedir/plugin" or die $!;
print $fh <<'TEXT';
#!/usr/bin/env perl
use POSIX;

my $s = <<MSG;
plugin-ready

MSG
while(1) {
  POSIX::write(1001, $s, length($s));
  <STDIN>;
}
TEXT
close $fh;

# after
reconcile();

assert {
  info(undef, {
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
      system_state_ready => 1
    , system_state_plugin_reconcile => 2
})};
assert { stats("//bm/plugins/$plugin_id", "-S", {
    type => 'plugin'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , fork => 2
  , crashed => 0
  , tx_parse_err => 1
  , reap => 1
  , ready => 1
  , events => 0
  , commands => 0
})};

# some sanity checks for the cli results
$text = bam_plugins();
assert { $text =~ /$plugin_id/ };

$text = bam_plugin($plugin_id);
assert { $text =~ /$plugin_id/ };

# should run without error
bam_plugin($plugin_id, "stdin");
bam_plugin($plugin_id, "stdout");
bam_plugin($plugin_id, "stderr");
bam_plugin($plugin_id, "auxout");

teardown();
