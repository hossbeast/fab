#!/usr/bin/env perl

#
# This test imports the current directory by name. The current directory and its
# ancestry is loaded in a different way from directories loaded from walker config
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_projdir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<TREE);
|-- A
|   `-- foo
|-- B
|   `-- module.bam+devel <<
bind A => //A
bind B => //B
>>
|-- system-config <<
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
    }
  }
}
>>
TREE

# before
assert {
  stats(undef, {
    modules => 1          # the imported directory is not vivified
  , system_state_ok => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , modules_up => 0
  , modules_down => 0
  , uses_down => 0
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("../A", {
    type => 'dir'
})};

teardown();
