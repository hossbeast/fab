#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# config file with syntax error
init();
my $testdir = setup({tolerant => 1 }, <<'TREE');
|-- A
|   `-- B
|       `-- C
|-- module.bam%devel
|-- config.bam%devel <<
goats boats
>>
TREE

# before
assert { stats(undef, {
    modules => 0
  , system_state_ok => 0
})};
assert {
  stats("config.bam%devel", "-S", "--no-module", {
      type => "configset"
    , state => 'stale'
    , parse_err => 1
    , parse_ok => 0
})};

reconcile(tolerant => 1);
assert { stats(undef, {
    modules => 0
  , system_state_ok => 0
})};
assert { stats("config.bam%devel", "-S", "--no-module", {
    type => "configset"
  , state => 'stale'
  , parse_err => 2
  , parse_ok => 0
})};

reconcile(tolerant => 1);
assert { stats(undef, {
    modules => 0
  , system_state_ok => 0
})};
assert { stats("config.bam%devel", "-S", "--no-module", {
    type => "configset"
  , state => 'stale'
  , parse_err => 3
  , parse_ok => 0
})};

# config file syntax fixed
open my $fh, ">", "$testdir/config.bam%devel" or die $!;
print $fh <<'TEXT';
build : {
  concurrency : 42
}
TEXT
close $fh;

# after
reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert { stats("config.bam%devel", "-S", {
    type => "configset"
  , state => "fresh"
  , parse_err => 3
  , parse_ok => 1
})};

teardown();
