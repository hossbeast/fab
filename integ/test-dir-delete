#!/usr/bin/env perl

#
# This test deletes a directory with a file in it
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_invalidate;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup(<<TREE);
|-- A
|   `-- foo
|-- module.bam%devel
|-- config.bam%devel <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
    }
  }
}
>>
TREE

# /run/user/1000/bam-integ/testdir/user-config
# /run/user/1000/bam-integ/testdir
# /run/user/1000/bam-integ/testdir/A
my $watches = 3;
my $dir_watches = 2;
my $file_watches = 0;
my $symlink_watches = 1;

assert {
  stats("//bm/sys-notify", "--follow", {
      count => ($bam_invalidate eq "notify") ? $watches : 0
    , put => ($bam_invalidate eq "notify") ? ($dir_watches + $file_watches + $symlink_watches) : 0
    , dir_put => ($bam_invalidate eq "notify") ? $dir_watches : 0
    , file_put => ($bam_invalidate eq "notify") ? $file_watches : 0
    , symlink_put => ($bam_invalidate eq "notify") ? $symlink_watches : 0
})};
assert { stats("$bam_basedir", {
    type => 'dir'
  , state => 'fresh'
  , fresh => 0
  , stale => 0
  , indexed_lookup => 0
  , indexed_notify => ($bam_invalidate eq "notify") ? 1 : 0
})};
assert { stats("$bam_basedir/A", {
    type => 'dir'
  , state => 'fresh'
  , fresh => 0
  , stale => 0
  , indexed_lookup => 0
  , indexed_notify => ($bam_invalidate eq "notify") ? 1 : 0
})};

# state of the module file
# state of the module directory
assert {
  stats($bam_basedir, "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
})};

# delete the subdirectory
unlink("$bam_basedir/A/foo") or die $!;
rmdir("$bam_basedir/A") or die $!;
reconcile();

assert { enoent("$bam_basedir/A/foo") };
assert { enoent("$bam_basedir/A") };

assert {
  stats("//bm/sys-notify", "--follow", {
      # watch for testdir/A was removed
      count => ($bam_invalidate eq "notify") ? ($watches - 1) : 0
    , put => ($bam_invalidate eq "notify") ? ($dir_watches + $file_watches + $symlink_watches) : 0
    , dir_put => ($bam_invalidate eq "notify") ? $dir_watches : 0
    , file_put => ($bam_invalidate eq "notify") ? $file_watches : 0
    , symlink_put => ($bam_invalidate eq "notify") ? $symlink_watches : 0
})};
assert {
  stats($bam_basedir, "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , reloaded => 1
})};

teardown();
