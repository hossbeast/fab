#!/usr/bin/env perl

#
# This test verifies that when rule reconciliation does not complete, subsequent
# reconciliation attempts continue to not succeed, since nothing has changed
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_bamd_id;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup({ expect_error => 1 }, <<'TREE');
|-- module.bam%devel <<
rule foo
>>
TREE

print("\n >> 1 - INITIAL, invalid rule <<\n\n");

assert {
  stats(undef, {
    modules => 1
  , system_state_ok => 0
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'stale'
  , reloaded => 0
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'stale'
  , rules => 0
  , parse_err => 1
  , parse_ok => 0
})};

assert {
  info({
    "system-state" => 'module-reconcile'
})};

print("\n >> 2 - reconcile, invalid rule <<\n\n");
reconcile(expect_error => 1);

assert { stats(undef, {
    modules => 1
  , system_state_ok => 0
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'stale'
  , reloaded => 0
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'stale'
  , rules => 0
  , parse_err => 2
  , parse_ok => 0
})};

assert {
  info({
    "system-state" => 'module-reconcile'
})};

teardown();
