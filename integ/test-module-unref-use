#!/usr/bin/env perl

#
#
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_projdir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<TREE);
|-- A
|   `-- rules.bam+devel <<
rule { name : foo } foo -> bar
>>
|-- B
|   `-- foo
|   `-- module.bam+devel <<
use A
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : { mount : true }
  }
}
>>
TREE

my $A_rules_id = hash64("$bam_basedir/A/rules.bam+devel");
my $B_id = hash64("$bam_projdir");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
#  , rule_run => 2
#  , rule_run_ok => 2
  , ruleset_files => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , modules_up => 0
  , modules_down => 0
  , rules => 0
})};
assert { stats(".", {
    type => 'module-dir'
  , state => 'fresh'
  , rules => 1
})};
assert { stats("//modules/$B_id/rmas-by/name/foo", {
    rule_run => 2               # this rule is run twice because it instantiates a new file in the matched directory
  , rule_run_ok => 2
  , bpe_hits => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};
assert { stats("..", {
    type => 'dir'
})};
assert { stats("../A", {
    state => 'fresh'
  , type => 'dir'
  , rules => 0
})};
assert { stats("../A/rules.bam+devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
  , uses_up => 1
  , rules => 1
})};

assert { ls("//module/rulesets/$A_rules_id", "$A_rules_id -> //rulesets/$A_rules_id") };

# delete the contents of the module file
open my $fh, ">", "$bam_basedir/B/module.bam+devel" or die $!;
close $fh;

# after
reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ok => 2
  , ruleset_files => 0      # A/rules.bam is no longer referenced
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 2
  , modules_up => 0
  , modules_down => 0
  , uses_down => 0
  , rules => 0
  , parse => 2
  , parse_ok => 2
})};
assert { stats("..", {
    type => 'dir'
})};
# out-of-tree rules ; no longer referenced ; just a file now
assert { stats("../A", {
    type => 'dir'
})};
assert { stats("../A/rules.bam+devel", {
    type => 'file'
})};

assert { enoent("//module/rules/$A_rules_id") };
teardown();
