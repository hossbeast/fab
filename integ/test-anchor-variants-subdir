#!/usr/bin/env perl

#
# anchor with nested modules
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_projdir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'build');
setup(<<"TREE");
|-- foo <<
qux
>>
|-- rules.bam+devel <<
rule foo -> bar : cp.bam
rule bar -> //targets
>>
|-- cp.bam << 0777
file : {
  path-search : cp    # this needs the config to resolve
}
args : [
  \$bm_source0
  \$bm_target0
]
>>
|`-- build
|   `-- C
|       `-- module.bam+devel <<
anchor ../..
>>
|   `-- D
|       `-- module.bam+devel <<
anchor ../..
>>
|-- system-config <<
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}
filesystem : {
  exclude : {
    foo
  }
  fstrees : {
    $bam_basedir : {
      mount : true
    }
    / : {
      mkdir : true
    }
  }
}
>>
TREE

my $build_C_id = hash64("$bam_projdir/C");
my $build_D_id = hash64("$bam_projdir/D");

# C fs link points to the right node
my $result = bam_ls(["//modules/$build_C_id/base", "--no-follow", "--no-module"]);
my $ref = $$result{out};
assert { $ref eq "base -> $bam_basedir/build/C" };

# C ref link points to the right node
$result = bam_ls(["//modules/$build_C_id/anchor", "--no-follow", "--no-module"]);
$ref = $$result{out};
assert { $ref eq "anchor -> $bam_basedir" };

# D fs link points to the right node
$result = bam_ls(["//modules/$build_D_id/base", "--no-follow", "--no-module"]);
$ref = $$result{out};
assert { $ref eq "base -> $bam_basedir/build/D" };

# D ref link points to the right node
$result = bam_ls(["//modules/$build_D_id/anchor", "--no-follow", "--no-module"]);
$ref = $$result{out};
assert { $ref eq "anchor -> $bam_basedir" };

assert {
  stats("--no-module", "//system", {
    modules => 2          # module B, plus module B/C (anchored to A/C)
})};
assert {
  stats("--no-module", "//filesystem", {
    mkdir => 0
})};
assert {
  stats("./C", "-S", "--no-module", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("./D", "-S", "--no-module", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};

build();
assert_file("$bam_projdir/C/bar", "qux");
assert_file("$bam_projdir/D/bar", "qux");
teardown();
