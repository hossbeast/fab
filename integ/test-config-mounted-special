#!/usr/bin/env perl

#
# exercises config.bam state changes
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use util;
use tree;
use bam;

init();
setup(<<'TREE');
|-- module.bam+devel
|-- config.bam+devel <<
build : {
  concurrency : 42
}
>>
TREE

# 1. non-empty config.bam file
assert { stats(undef, {
    system_state => 'ok'
  , system_state_ok => 1
  , modules => 1
  , config_files => 1
})};
assert { stats("config.bam+devel", {
    type => 'config-file'
  , state => 'fresh'
  , indexed_lookup => 0
})};
assert { stats("config.bam+devel", "-S", {
    type => 'config'
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};
my ($node_id_1, $node_token_1) = get_node_identifiers("config.bam+devel");
print("id >> $node_id_1 << token >> $node_token_1 <<\n");

# 2. config.bam file deleted
unlink("$bam_basedir/config.bam+devel") or die $!;

reconcile();
assert { stats(undef, {
    system_state => 'ok'
  , system_state_ok => 2
  , config_files => 0
})};
assert { enoent("$bam_basedir/config.bam+devel") };

# 3. config.bam file restored
open my $fh, ">", "$bam_basedir/config.bam+devel" or die $!;
print $fh <<'TEXT';
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    system_state => 'ok'
  , system_state_ok => 3
  , config_files => 1
})};
assert { stats("$bam_basedir/config.bam+devel", {
    type => 'config-file'
  , state => 'fresh'
  , indexed_lookup => 0
})};
assert { stats("$bam_basedir/config.bam+devel", "-S", {
    type => 'config'
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};
my ($node_id_2, $node_token_2) = get_node_identifiers("config.bam+devel");
print("id >> $node_id_2 << token >> $node_token_2 <<\n");

assert { $node_id_1 eq $node_id_2 };          # id is stable across delete/create
assert { $node_token_1 ne $node_token_2 };    # token changes across delete/create

# 3. config.bam file changed
open $fh, ">", "$bam_basedir/config.bam+devel" or die $!;
print $fh <<'TEXT';
build : {
  concurrency : 42
}
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    system_state => 'ok'
  , system_state_ok => 4
  , config_files => 1
})};
assert { stats("$bam_basedir/config.bam+devel", {
    type => 'config-file'
  , state => 'fresh'
  , indexed_lookup => 0
})};
assert { stats("$bam_basedir/config.bam+devel", "-S", {
    type => 'config'
  , state => 'fresh'
  , parse => 2
  , parse_ok => 2
})};

teardown();
