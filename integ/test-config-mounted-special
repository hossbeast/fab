#!/usr/bin/env perl

#
# exercises config.bam state changes
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init();
setup(<<'TREE');
|-- module.bam+devel
|-- config.bam+devel <<
build : {
  concurrency : 42
}
>>
TREE

# 1. non-empty config.bam file
assert { info({
    "system-state" => 'ok'
})};
assert { stats(undef, {
    system_state_ok => 1
  , modules => 1
  , configset_files => 1
})};
assert { stats("config.bam+devel", {
    type => 'configset-file'
  , state => 'fresh'
})};
assert { stats("config.bam+devel", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};
my $node_id_1 = get_node_identifiers("config.bam+devel");

# 2. config.bam file deleted
unlink("$bam_basedir/config.bam+devel") or die $!;

reconcile();
assert { info({
    "system-state" => 'ok'
})};
assert { stats(undef, {
    system_state_ok => 2
  , configset_files => 0
})};
assert { enoent("$bam_basedir/config.bam+devel") };

# 3. config.bam file restored
open my $fh, ">", "$bam_basedir/config.bam+devel" or die $!;
print $fh <<'TEXT';
TEXT
close $fh;

reconcile();
assert { info({
    "system-state" => 'ok'
})};
assert { stats(undef, {
    system_state_ok => 3
  , configset_files => 1
})};
assert { stats("$bam_basedir/config.bam+devel", {
    type => 'configset-file'
  , state => 'fresh'
})};
assert { stats("$bam_basedir/config.bam+devel", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};
my $node_id_2 = get_node_identifiers("config.bam+devel");

assert { $node_id_1 eq $node_id_2 };          # id is stable across delete/create

# 3. config.bam file changed
open $fh, ">", "$bam_basedir/config.bam+devel" or die $!;
print $fh <<'TEXT';
build : {
  concurrency : 42
}
TEXT
close $fh;

reconcile();
assert { info({
    "system-state" => 'ok'
})};
assert { stats(undef, {
    system_state_ok => 4
  , configset_files => 1
})};
assert { stats("$bam_basedir/config.bam+devel", {
    type => 'configset-file'
  , state => 'fresh'
})};
assert { stats("$bam_basedir/config.bam+devel", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 2
  , parse_ok => 2
})};

teardown();
