#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_projdir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<'TREE');
|-- B
|   `-- module.bam+devel
|   `-- var.bam+devel <<
lflags.devel : [
  -lasan -lubsan
]
>>
TREE

# before
assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
  , varset_files => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , fresh => 1
  , stale => 1
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};

unlink("$bam_projdir/var.bam+devel") or die $!;
reconcile();

# after - disappearance of var file in same dir has invalidated the module
assert { stats(undef, {
    modules => 1
  , system_state_ok => 2
  , varset_files => 0        # and deleted the var node
})};
assert { enoent("$bam_projdir/var.bam+devel") };
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , fresh => 2
  , stale => 2
  , reloaded => 2
  , parse => 1
  , parse_ok => 1
})};
teardown();
