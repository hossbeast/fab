#!/usr/bin/env perl

#
# This test exercises symlink invalidations
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use integ;
use bam::bam;

# build out the fstree under /tmp
init();
setup(<<TREE);
|-- A <<
foo
>>
|-- B -> ./A
|-- module.bam%devel <<
rule A -> A.o : ./cp.bam+(.)
rule B -> B.o : ./cp.bam+(.)
>>
|-- cp.bam << 0777
#!/usr/bin/env perl
open A, "<", \$ENV{bm_source0} or die \$!;
open B, ">", \$ENV{bm_target0} or die \$!;
while(<A>)
{
  print B "\$_";
}
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      readlink : yes
    }
    $repodir/builtin-plugins%devel : {
      mount : true
      readlink : no
    }
  }
}
>>
TREE

my $base_fstree_id = bam::identity("fstree", $bam_basedir);
my $res;
my $msg;

print("\n >> 1 - SETUP <<\n\n");
assert { stats("//bm/sys-filesystem", "--follow", {
    readlink_no => 0
  , readlink_ok => 1
  , readlink_unresolved => 1
  , readlink_failed => 0
  , readlink_err => 0
})};
assert { stats("//bm/fstrees/$base_fstree_id", "--follow", {
    readlink_no => 0
  , readlink_ok => 1
  , readlink_unresolved => 1
  , readlink_failed => 0
  , readlink_err => 0
})};
assert { stats("A", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert { stats("A.o", {
    type => 'file'
  , state => 'uncreated'
  , stale => 0
  , fresh => 0
})};
assert { stats("B.o", {
    type => 'file'
  , state => 'uncreated'
  , stale => 0
  , fresh => 0
})};

assert { stats("B", {
    type => 'symlink'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
  , readlink_no => 0
  , readlink_ok => 1          # B resolved ok
  , readlink_unresolved => 0
  , readlink_failed => 0
  , readlink_err => 0
  , readlink_pending => 0
})};
$res = bam_describe(["$bam_basedir/B"]);
$msg = bam::bacon::parse($$res{out});
assert { $$msg{"$bam_basedir/B"}{target} eq "./A" };          # B got the right reference
assert { $$msg{"$bam_basedir/B"}{ref} eq "$bam_basedir/A" };

print("\n >> 2 - BUILD <<\n\n");
build();
assert { stats("A", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert { stats("A.o", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert { stats("B.o", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert { stats("B", {
    type => 'symlink'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
  , readlink_no => 0
  , readlink_ok => 1          # B resolved ok
  , readlink_unresolved => 0
  , readlink_failed => 0
  , readlink_err => 0
  , readlink_pending => 0
})};
$res = bam_describe(["$bam_basedir/B"]);
$msg = bam::bacon::parse($$res{out});
assert { $$msg{"$bam_basedir/B"}{target} eq "./A" };          # B retains the correct reference
assert { $$msg{"$bam_basedir/B"}{ref} eq "$bam_basedir/A" };

# copy propageted thru the symlink
assert_file("$bam_basedir/A.o", "foo");
assert_file("$bam_basedir/B.o", "foo");

# invalidation of the source file propagates via the symlink
print("\n >> 3 - FILE INVALIDATION of target <<\n\n");

open my $fh, ">", "$bam_basedir/A" or die $!;
print $fh <<'TEXT';
bar
TEXT
close $fh;
reconcile();

assert { stats("A", {
    type => 'file'
  , state => 'fresh'
  , stale => 1
  , fresh => 2
})};
assert { stats("A.o", {
    type => 'file'
  , state => 'stale'
  , stale => 1
  , fresh => 1
})};
assert { stats("B.o", {
    type => 'file'
  , state => 'stale'
  , stale => 1
  , fresh => 1
})};
assert { stats("B", {
    type => 'symlink'
  , state => 'fresh'
  , stale => 1                # invalidated thru the link
  , fresh => 2
  , readlink_no => 0
  , readlink_ok => 1          # B resolved ok
  , readlink_unresolved => 0
  , readlink_failed => 0
  , readlink_err => 0
})};

# invalidation of the source file propagates via the symlink
print("\n >> 4 - API INVALIDATION of target <<\n\n");
bam_touch("$bam_basedir/A");
reconcile();

assert { stats("A", {
    type => 'file'
  , state => 'fresh'
  , stale => 2
  , fresh => 3
})};
assert { stats("A.o", {
    type => 'file'
  , state => 'stale'
  , stale => 1
  , fresh => 1
})};
assert { stats("B.o", {
    type => 'file'
  , state => 'stale'
  , stale => 1
  , fresh => 1
})};
assert { stats("B", {
    type => 'symlink'
  , state => 'fresh'
  , stale => 2                # invalidated thru the link
  , fresh => 3
  , readlink_no => 0
  , readlink_ok => 1          # B resolved ok
  , readlink_unresolved => 0
  , readlink_failed => 0
  , readlink_err => 0
})};

teardown();
