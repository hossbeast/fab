#!/usr/bin/env perl

#
# This test has symlinks
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
my $testdir = setup(<<"TREE");
|-- module.bam%devel
|-- A
|   `-- foo
|       `-- bar
|   `-- baz
|       `-- qux
|-- B
|   `-- module.bam%devel <<
>>
|-- system-config <<
filesystem : {
  exclude : {
    foo
  }
  fstrees : {
    $bam_basedir : {
      mount : true
    }
    / : {
      readlink : yes
    }
  }
}
>>
TREE

# before
assert {
  stats(undef, {
    modules => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , reloaded => 1
  , rulesets => 1
  , rmas => 0
  , varsets => 0
  , fsnames => 0
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , rules => 0
})};

assert {
  stats("$bam_basedir/A/baz/qux", {
    state => "fresh"
})};
assert {
  stats("$bam_basedir/A/baz", {
    state => "fresh"
})};

symlink("qux", "$bam_basedir/A/baz/boats") or die;
reconcile();
assert {
  stats("$bam_basedir/A/baz/boats", {
    state => "fresh"
})};

teardown();
