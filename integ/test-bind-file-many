#!/usr/bin/env perl

#
# This test has a one-to-many bind rule whose target is a file. Since only directories are indexed
# for lookup, the lookup pattern must specify the file-type qualifier (.).
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_dir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<TREE);
|-- A
|   `-- foo
|-- B
|   `-- module.bam%devel <<
bind { name : 1 } A/foo+(.) => [*] //foo
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
  }
}
>>
TREE

my $modules_ns_id = bam::identity("namespace", "modules");
my $foo_A_id = bam::identity("file", "$bam_basedir/A/foo");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
  , rule_run => 1
})};
assert {
  stats("//bm/namespaces/$modules_ns_id", "-S", {
      put => 2
    , del => 0
    , count => 2
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("../A", {
    type => 'dir'
})};
assert { stats("../A/foo", {
    type => 'file'
})};
assert {
  stats("//module/rmas-by/name/1", "--follow", {
      rule_run => 1
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
    , target_hits => 1
    , attachment_hits => 1
})};

assert { ls("//foo", "foo - shadow-dir fresh", "--max-distance", "0") };
assert { ls("//foo/$foo_A_id", "$foo_A_id -> $bam_basedir/A/foo") };

teardown();
