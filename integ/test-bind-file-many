#!/usr/bin/env perl

#
# This test has a one-to-many bind rule whose target is a file. Since only directories are indexed
# for lookup, the lookup pattern must specify the file-type qualifier (.).
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_projdir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<TREE);
|-- A
|   `-- foo
|-- B
|   `-- module.bam+devel <<
bind { id : 1 } A/foo+(.) => [*] //foo
>>
|-- system-config <<
filesystems : {
  / : {
    indexed : false
  }
  $bam_basedir : {
    indexed : true
  }
}
walker : {
  include : {
    $bam_basedir
  }
}
>>
TREE

my $foo_A_id = hash64("$bam_basedir/A/foo");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
  , fsent_index_put => 3  # number of indexed directory nodes
  , fsent_index_del => 0
  , fsent_index_count => 3
  , rule_run => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("../A", {
    type => 'dir'
})};
assert { stats("../A/foo", {
    type => 'file'
})};
assert {
  stats("//module/rma/1", {
      rule_run => 1
    , rule_run_ok => 1
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
    , target_hits => 1
    , attachment_hits => 1
})};

assert { ls("//foo", "foo - shadow-dir fresh", "--max-distance", "0") };
assert { ls("//foo/$foo_A_id", "$foo_A_id -> $bam_basedir/A/foo") };

teardown();
