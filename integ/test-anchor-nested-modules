#!/usr/bin/env perl

#
# anchor with nested modules
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_dir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<"TREE");
|-- A
|   `-- foo
|   `-- rules.bam%devel <<
rule foo -> bar : ./cp.bam+(.)
rule bar -> //targets
>>
|   `-- cp.bam << 0777
file : {
  lookup : {
    namespace : coreutils
    pattern : bin/cp+(@.)
  }
}
args : [
  \$bm_source0
  \$bm_target0
]
>>
|   `-- C
|       `-- foo
|       `-- baz
|       `-- module.bam%devel <<
bind A => //A
rule baz -> qux : //A/cp.bam+(.)
rule qux -> //targets
>>
|-- B
|   `-- module.bam%devel <<
anchor ../A
>>
|-- system-config <<
namespaces : {
  coreutils
}
filesystem : {
  exclude : {
    foo
  }
  fstrees : {
    $repodir/usr/share/bam/coreutils : {
      mount : true
      namespaces : {
        coreutils
      }
    }
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
    $bam_basedir/B : {
      mkdir : true
    }
  }
}
>>
TREE

my $B_module_id;
my $C_module_id;
my $B_ruleset_id;
my $A_ruleset_id;
my $C_ruleset_id;
my $result;
my $ref;
my $lines;

$B_module_id = bam::identity("module", "$bam_basedir/B");
$C_module_id = bam::identity("module", "$bam_basedir/B/C");
$B_ruleset_id = bam::identity("ruleset", "$bam_basedir/B/module.bam%devel");
$A_ruleset_id = bam::identity("ruleset", "$bam_basedir/A/rules.bam%devel");
$C_ruleset_id = bam::identity("ruleset", "$bam_basedir/A/C/module.bam%devel");
$result = bam_ls(["//bm/modules/$B_module_id/build", "--no-follow"]);
$ref = $$result{out};

# before
assert {
  stats(undef, {
    modules => 2          # module B, plus module B/C (anchored to A/C)
})};
assert {
  stats("//bm/sys-filesystem", "--follow", {
      mkdir_ok => 1            # B/C
    , mkdir_err => 0
    , readlink_err => 0
    , readlink_no => 0
    , readlink_ok => 0
    , unlink_enoent => 0
    , unlink_err => 0
    , unlink_no => 0
})};
assert {
  stats("$bam_basedir/B", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 2
})};
assert {
  stats("$bam_basedir/B/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("$bam_basedir/B/C", "-S", {
    type => 'module'
  , state => 'fresh'
  , fresh => 1
  , stale => 1
  , rulesets => 2
})};
assert { enoent("./C/module.bam%devel", "-S") };

# check B fs links
assert { ls("//bm/modules/$B_module_id/build", "build -> $bam_basedir/B") };
assert { ls("//bm/modules/$B_module_id/anchor", "anchor -> $bam_basedir/A") };

$result = bam_ls(["//bm/modules/$B_module_id/rulesets"]);
$lines = ($$result{out} =~ tr/\n//);
assert { $$result{out} =~ $B_ruleset_id };
assert { $$result{out} =~ $A_ruleset_id };
assert { $lines == 2 };

# check C fs links
assert { ls("//bm/modules/$C_module_id/build", "build -> $bam_basedir/B/C") };
assert { ls("//bm/modules/$C_module_id/anchor", "anchor -> $bam_basedir/A/C") };

$result = bam_ls(["//bm/modules/$C_module_id/rulesets"]);
$lines = ($$result{out} =~ tr/\n//);
assert { $$result{out} =~ $A_ruleset_id };
assert { $$result{out} =~ $C_ruleset_id };
assert { $lines == 2 };

build();
assert_file("$bam_dir/bar");        # in module dir
assert_file("$bam_dir/C/qux");      # in nested module

teardown();
