#!/usr/bin/env perl

#
# This test checks whether rules in conditional blocks are applied
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_projhash;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use util;
use tree;
use bam;

# this conditional has a variable, and it evaluates to true
init();
my $testdir = setup(<<'TREE');
|-- module.bam+devel <<
{
  if($a)
  rule a -> b
}
>>
|-- a
|-- var.bam+devel <<
a : true
>>
TREE

assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rules => 1    # the rule exists in the module.bam file
  , parse => 1
  , parse_ok => 1
})};
assert { stats(".", {
    type => 'module-dir'
  , state => 'fresh'
  , rules => 1    # the rule IS applied
})};
assert { stats("module.bam+devel", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
})};
assert { stats("var.bam+devel", "-S", {
    type => 'var'
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
  , stale => 1
  , fresh => 1
})};

# this conditional has a variable, and it evaluates to false
open my $fh, ">", "$testdir/var.bam+devel" or die $!;
print $fh <<'TEXT';
a : false
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ok => 2
})};
assert { stats(".", "-S", {
    reloaded => 2
  , state => 'fresh'
  , rules => 1    # the rule exists in the module.bam file
  , parse => 1
  , parse_ok => 1
})};
assert { stats(".", {
    type => 'module-dir'
  , state => 'fresh'
  , rules => 0    # the rule IS NOT applied
})};
assert { stats("module.bam+devel", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 2
  , fresh => 2
})};
assert { stats("var.bam+devel", "-S", {
    type => 'var'
  , state => 'fresh'
  , parse => 2
  , parse_ok => 2
  , stale => 2
  , fresh => 2
})};
teardown();
