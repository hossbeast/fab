#!/usr/bin/env perl

#
# This test checks whether rules in conditional blocks are applied
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_bamd_id;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# this conditional has a variable, and it evaluates to true
init();
my $testdir = setup(<<'TREE');
|-- module.bam%devel <<
{
  if($a)
  rule a -> b
}
>>
|-- a
|-- var.bam%devel <<
a : true
>>
TREE

assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rmas => 1    # the rule exists in the module.bam file
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , rules => 1    # the rule exists in the module.bam file
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats(".", {
    type => 'dir'
  , state => 'fresh'
  , rules => 1    # the rule IS applied
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
})};
assert {
  stats("var.bam%devel", "-S", {
    type => "varset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
  , stale => 1
  , fresh => 1
})};

# this conditional has a variable, and it evaluates to false
open my $fh, ">", "$testdir/var.bam%devel" or die $!;
print $fh <<'TEXT';
a : false
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ready => 2
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 2
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => "ruleset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
  , rules => 1    # the rule exists in the module.bam file
})};
assert {
  stats(".", {
    type => 'dir'
  , state => 'fresh'
  , rules => 0    # the rule IS NOT applied
})};
assert {
  stats("var.bam%devel", "-S", {
    type => "varset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 2
  , stale => 2
  , fresh => 2
})};
teardown();
