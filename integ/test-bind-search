#!/usr/bin/env perl

#
# This test references a file imported from another directory in a rule
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_projdir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<TREE);
|-- A
|   `-- foo
|-- B
|   `-- module.bam+devel <<
bind A => //A
rule //A/foo -> bar : cp.bam
rule bar -> //targets
>>
|   `-- cp.bam << 0777
file : {
  path-search : cp
}
args : [
  \$bm_source0
  \$bm_target0
]
>>
|-- system-config <<
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}
walker : {
  include : {
    $bam_basedir
  }
}
>>
TREE

# before
assert {
  stats(undef, {
    modules => 1          # the imported directory is not vivified
  , system_state_ok => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , modules_up => 0
  , modules_down => 0
  , uses_down => 0
  , rules => 3
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("../A", {
    type => 'dir'
})};

build();
assert_file("$bam_projdir/bar");

teardown();
