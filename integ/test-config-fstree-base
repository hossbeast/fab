#!/usr/bin/env perl

#
# exercises config.bam with fstree identified via $bm_basedir sysvar
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_dir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# notify-specific stats assertions
init();
setup(<<"TREE");
|-- module.bam%devel
|-- config.bam%devel <<
filesystem : {
  fstrees : {
    \$bm_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
  }
}
>>
TREE

my $res;

assert {
  stats(undef, { modules => 1
})};
assert {
  stats(".", "-S", {
      type => 'module'
    , state => 'fresh'
    , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
      type => 'ruleset'
    , state => 'fresh'
    , parse_err => 0
    , parse_ok => 1
})};

$res = bam_describe(["$bam_basedir"]);
assert { $$res{out} =~ /indexed.lookup : 1/ };

teardown();
