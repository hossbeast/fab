#!/usr/bin/env perl

#
# This test exercises various cases of fstree / dir association
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'B/C');
setup(<<"TREE");
|-- module.bam+devel
|-- A
|   `-- foo
|-- B
|   `-- C
|       `-- module.bam+devel <<
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      invalidation : notify
      mkdir : true
      index : true
      mount : true
    }
    / : {
      invalidation : notify
      mkdir : true
      index : false
    }
  }
  exclude : {
    foo
  }
}
>>
TREE

# before
assert {
  stats(undef, { modules => 1
})};
assert {
  stats(".", "-S", {
      type => 'module'
    , state => 'fresh'
    , reloaded => 1
    , parse => 1
    , parse_ok => 1
})};

my $res = bam_describe(["$bam_basedir/A"]);
assert { $$res{out} =~ /indexed.lookup : 1/ };

teardown();
