#!/usr/bin/env perl

#
# This test exercises various cases of fstree / dir association
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B/C');
setup(<<"TREE");
|-- module.bam%devel
|-- A
|   `-- foo
|-- B
|   `-- C
|       `-- module.bam%devel <<
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      invalidation : notify
      mkdir : true
      mount : true
      namespaces : {
        modules
      }
    }
    / : {
      invalidation : notify
      mkdir : true
    }
  }
  exclude : {
    foo
  }
}
>>
TREE

# before
assert {
  stats(undef, { modules => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , rules => 0
})};

my $res = bam_describe(["$bam_basedir/A"]);
assert { $$res{out} =~ /indexed.lookup : 1/ };

teardown();
