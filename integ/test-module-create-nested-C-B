#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use util;
use tree;
use bam;

# build out the fstree under /tmp
init();
my $testdir = setup(<<TREE);
|-- A
|   `-- B
|       `-- C
|           `-- foo
`-- module.bam+devel
TREE

# before
assert { stats(undef, { modules => 1 })};
assert { stats(".", "-S", {
    reloaded => 1
  , modules_up => 0
  , modules_down => 0
  , parse => 1
  , parse_ok => 1
})};

open my $fh, ">>", "$testdir/A/B/C/module.bam+devel" or die $!;
print $fh "\n";
close $fh;

# after
reconcile();
assert { stats(undef, { modules => 2 })};
assert { stats(".", "-S", {
    reloaded => 1
  , modules_up => 0
  , modules_down => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("A/B/C", "-S", {
    reloaded => 1
  , modules_up => 1
  , modules_down => 0
  , parse => 1
  , parse_ok => 1
})};

open $fh, ">>", "$testdir/A/B/module.bam+devel" or die $!;
print $fh "\n";
close $fh;

# after
reconcile();
assert { stats(undef, { modules => 3 })};
assert { stats(".", "-S", {
    reloaded => 1
  , modules_up => 0
  , modules_down => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("A/B", "-S", {
    reloaded => 1
  , modules_up => 1
  , modules_down => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("A/B/C", "-S", {
    reloaded => 1
  , modules_up => 1
  , modules_down => 0
  , parse => 1
  , parse_ok => 1
})};
teardown();
