#!/usr/bin/env perl

#
# create multiple nested modules
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

my $fh;

# build out the fstree under /tmp
init();
setup(<<TREE);
|-- A
|   `-- B
|       `-- C
|           `-- foo
`-- module.bam%devel
TREE

# before
assert { stats(undef, { modules => 1 })};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert { enoent("A/B", "-S") };
assert { enoent("A/B/C", "-S") };

# create A/B/C module
open $fh, ">>", "$bam_basedir/A/B/C/module.bam%devel" or die $!;
print $fh "\n";
close $fh;

# after
reconcile();
assert { stats(undef, { modules => 2 })};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert { enoent("A/B", "-S") };
assert {
  stats("A/B/C", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 1
})};
assert {
  stats("A/B/C/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};

# create A/B module
open $fh, ">>", "$bam_basedir/A/B/module.bam%devel" or die $!;
print $fh "\n";
close $fh;

# after
reconcile();
assert { stats(undef, { modules => 3 })};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("A/B", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 1
})};
assert {
  stats("A/B/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("A/B/C", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , rulesets => 1
})};
assert {
  stats("A/B/C/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};

teardown();
