#!/usr/bin/env perl

#
# search-search rule
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup(<<TREE);
|-- foo
|-- bar
|-- module.bam%devel <<
rule { name : 1 } search foo [*] -> [*] search bar
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
    }
  }
}
>>
TREE

# before
assert {
  stats(undef, {
    modules => 1
  , system_state_ready => 1
  , rule_run => 1
})};
assert {
  stats("$bam_basedir", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("$bam_basedir/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("//module/rmas-by/name/1", "--follow", {
      rule_run => 1
    , search_hits => 1
    , search_rhs_hits => 1
    , generate_hits => 0
    , formula_hits => 0
    , target_hits => 0
    , attachment_hits => 0
})};

teardown();
