#!/usr/bin/env perl

#
# This test has a BIND_MANY rule whose target is a single directory
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $bam_projdir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<TREE);
|-- A
|   `-- foo
|       `-- bar
|-- B
|   `-- module.bam+devel <<
bind { name : 1 } A/foo => [*] //foo
>>
|-- system-config <<
filesystem : {
  fstrees : {
    / : {
      index : false
    }
    $bam_basedir : {
      index : true
      mount : true
    }
  }
}
>>
TREE

my $foo_A_id = hash64("$bam_basedir/A/foo");

# before
assert { stats(undef, {
    modules => 1          # the imported directory is not vivified
  , system_state_ok => 1
  , rule_run => 1
})};
assert {
  stats("//fsindex", {
      del => 0
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("//module/rmas-by/name/1", {
      rule_run => 1
    , rule_run_ok => 1
    , search_hits => 0
    , generate_hits => 0
    , formula_hits => 0
    , target_hits => 1
    , attachment_hits => 1
})};

assert { ls("//foo", "foo - shadow-dir fresh", "--max-distance", "0") };
assert { ls("//foo/$foo_A_id", "$foo_A_id -> $bam_basedir/A/foo") };

teardown();
