#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# module file - boats is created by separate rules which each reference the same formula
init();
my $testdir = setup({ tolerant => 1 }, <<'TREE');
|-- module.bam+devel <<
rule -- boats : foo.bam
rule -- boats : foo.bam
rule boats -> //targets
>>
|-- foo.bam << 0777
#!/usr/bin/env perl
open FH, ">", $ENV{bm_target0} or die $!;
print FH "foo\n";
close FH;
>>
TREE

# before
assert {
  stats(undef, {
    modules => 1
  , system_state_ok => 0
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("foo.bam",  "-S", {
    type => "formula"
  , state => "stale"    # not parsed yet since rules did not reconcile
  , parse => 0
  , parse_ok => 0
})};
assert {
  stats("boats", {
    state => "uncreated"
})};

# module file - fixed
open my $fh, ">", "$testdir/module.bam+devel" or die $!;
print $fh <<TEXT;
rule -- boats : foo.bam
rule boats -> //targets
TEXT
close $fh;

reconcile();
assert {
  stats(undef, {
    modules => 1
  , system_state_ok => 1
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 2
  , parse => 2
  , parse_ok => 2
})};
assert {
  stats("foo.bam", "-S", {
    type => "formula"
  , state => "fresh"
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("boats", { state => "uncreated" })};

# build - creates the file
build();
assert {
  stats("boats", {
    state => "fresh"
  , fresh => 1
})};

# file was created by the foo formula
assert_file("$testdir/boats", "foo");
teardown();
