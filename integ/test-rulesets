#!/usr/bin/env perl

#
# Exercise ruleset list and describe from bam cli
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup(<<TREE);
|-- module.bam%devel <<
rulesets myrules%devel
>>
|-- myrules%devel <<
rule a -> b
>>
TREE

my $result;
my $mod_ruleset_id = bam::identity("ruleset", "$bam_basedir/module.bam%devel");
my $ruleset_id = bam::identity("ruleset", "$bam_basedir/myrules%devel");

# check stats
assert {
  stats("$bam_basedir/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("$bam_basedir/myrules%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , fresh => 1
  , stale => 1
  , parse_err => 0
  , parse_ok => 1
})};

# list rulesets
$result = bam_rulesets();
assert { index($result, $mod_ruleset_id) > -1 };
assert { index($result, "$bam_basedir/module.bam%devel") > -1 };

# describe ruleset by id
$result = bam_ruleset($mod_ruleset_id);
assert { index($result, $mod_ruleset_id) > -1 };
assert { index($result, "$bam_basedir/module.bam%devel") > -1 };

$result = bam_ruleset($ruleset_id);
assert { index($result, $ruleset_id) > -1 };
assert { index($result, "$bam_basedir/myrules%devel") > -1 };

# describe ruleset by path
$result = bam_ruleset("module.bam%devel");
assert { index($result, $mod_ruleset_id) > -1 };
assert { index($result, "$bam_basedir/module.bam%devel") > -1 };

$result = bam_ruleset("myrules%devel");
assert { index($result, $ruleset_id) > -1 };
assert { index($result, "$bam_basedir/myrules%devel") > -1 };

teardown();
