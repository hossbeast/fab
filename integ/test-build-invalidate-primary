#!/usr/bin/env perl

#
# Run the build, invalidate a primary file by api, run the build again
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# build out the fstree under /tmp
init();
my $testdir = setup(<<'TREE');
|-- cores.c <<
foo
>>
|-- module.bam+devel <<
rule cores.c -> cores.o : cp.bam
rule cores.o -> cores : cp.bam
rule cores -> //targets
>>
|-- cp.bam << 0777
#!/usr/bin/env perl
open A, "<", $ENV{bm_source0} or die $!;
open B, ">", $ENV{bm_target0} or die $!;
while(<A>)
{
  print B "$_";
}
>>
TREE

assert { stats("cores.c", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert { stats("cores.o", {
    type => 'file'
  , state => 'uncreated'
  , stale => 0
  , fresh => 0
})};
assert { stats("cores", {
    type => 'file'
  , state => 'uncreated'
  , stale => 0
  , fresh => 0
})};

build();

# intermediate and final file were created
assert_file("$testdir/cores.o", "foo");
assert_file("$testdir/cores", "foo");

assert { stats("cores.c", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert { stats("cores.o", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};
assert { stats("cores", {
    type => 'file'
  , state => 'fresh'
  , stale => 0
  , fresh => 1
})};

# invalidate all primary files
$result = run({ cwd => $bam_dir }
  , $bam_bampath
  , "--no-launch"
  , "adhoc"
  , "--"
  , "select : [ path : { pattern : / } traverse : { graph : fs visit : primary } ] invalidate"
);
print("$$result{out}\n");

assert { stats("cores.c", {
    type => 'file'
  , state => 'stale'    # primary file invalidated
  , stale => 1
  , fresh => 1
})};
assert { stats("cores.o", {
    type => 'file'
  , state => 'stale'    # propagated
  , stale => 1
  , fresh => 1
})};
assert { stats("cores", {
    type => 'file'
  , state => 'stale'    # propagated
  , stale => 1
  , fresh => 1
})};

reconcile();

assert { stats("cores.c", {
    type => 'file'
  , state => 'fresh'  # primary files refresh automatically on reconcile
  , stale => 1
  , fresh => 2
})};
assert { stats("cores.o", {
    type => 'file'
  , state => 'stale'
  , stale => 1
  , fresh => 1
})};
assert { stats("cores", {
    type => 'file'
  , state => 'stale'
  , stale => 1
  , fresh => 1
})};

build();

assert { stats("cores.c", {
    type => 'file'
  , state => 'fresh'
  , stale => 1
  , fresh => 2
})};
assert { stats("cores.o", {
    type => 'file'
  , state => 'fresh'
  , stale => 1
  , fresh => 2
})};
assert { stats("cores", {
    type => 'file'
  , state => 'fresh'
  , stale => 1
  , fresh => 2
})};

teardown();
