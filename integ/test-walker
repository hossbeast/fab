#!/usr/bin/env perl

#
# walker configuration which includes, and excludes, certain parts of the filesystem tree
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<"TREE");
|-- module.bam%devel
|-- A
|   `-- foo
|       `-- bar
|   `-- baz
|       `-- qux
|-- B
|   `-- module.bam%devel <<
>>
|-- config.bam%devel <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
    }
  }
  exclude : {
    foo
  }
}
>>
TREE

assert {
  stats(".", "-S", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , parse_err => 0
  , parse_ok => 1
})};

teardown();
