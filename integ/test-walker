#!/usr/bin/env perl

#
# walker configuration which includes, and excludes, certain parts of the filesystem tree
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<"TREE");
|-- module.bam+devel
|-- A
|   `-- foo
|       `-- bar
|   `-- baz
|       `-- qux
|-- B
|   `-- module.bam+devel <<
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir
  }
  exclude : {
    foo
  }
}
>>
TREE

## before
#assert {
#  stats(undef, {
#    modules => 1
#})};
assert { stats(".", "-S", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};

teardown();
