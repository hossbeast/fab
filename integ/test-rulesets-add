#!/usr/bin/env perl

#
# This test uses the rulesfiles directive in the module file in order to load an additional
# rules file in the same directory
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# build out the fstree under /tmp
init();
my $testdir = setup(<<TREE);
|-- module.bam%devel <<
rulesets myrules%devel
>>
|-- myrules%devel <<
rule a -> b
>>
TREE

my $mod_id = bam::identity("module", "$bam_basedir");
my $rules_id = bam::identity("ruleset", "$bam_basedir/myrules%devel");

# before
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("myrules%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};

assert { ls("//bm/modules/$mod_id/rulesets/$rules_id", "$rules_id -> //bm/rulesets/$rules_id") };

teardown();
