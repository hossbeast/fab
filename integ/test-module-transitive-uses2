#!/usr/bin/env perl

#
# This test verifies that transitive USES are applied correctly
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $bam_basedir;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'A');
setup(<<TREE);
|-- A
|   `-- module.bam%devel <<
use B
>>
|-- B
|   `-- rules.bam%devel <<
use C
>>
|-- C
|   `-- rules.bam%devel <<
use D
>>
|-- D
|   `-- rules.bam%devel <<
rule -- foo : $bam_basedir/touch.bam+(.)
>>
|-- system-config <<
namespaces : {
  coreutils
}
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
    $repodir/usr/share/bam/coreutils : {
      mount : true
      namespaces : {
        coreutils
      }
    }
  }
}
>>
|-- touch.bam << 0777
file : {
  lookup : {
    namespace : coreutils
    pattern : bin/touch+(@.)
  }
}
args : [
  \$bm_target0
]
>>
TREE

my $B_id = bam::identity('ruleset', "$bam_basedir/B/rules.bam%devel");
my $C_id = bam::identity('ruleset', "$bam_basedir/C/rules.bam%devel");
my $D_id = bam::identity('ruleset', "$bam_basedir/D/rules.bam%devel");

# before
assert {
  info({
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
    system_state_ready => 1
  , modules => 1
})};
assert {
  stats("$bam_basedir/A", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , reloaded => 1
  , rulesets => 4    # B, C, D
  , rmas => 1
})};
assert {
  stats("$bam_basedir/A/module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("$bam_basedir/B/rules.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , modules => 1
})};
assert {
  stats("$bam_basedir/C/rules.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , modules => 1
})};
assert {
  stats("$bam_basedir/D/rules.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , modules => 1
})};

assert { ls("//module/rulesets/$B_id", "$B_id -> //bm/rulesets/$B_id", "--max-distance", "0") };
assert { ls("//module/rulesets/$C_id", "$C_id -> //bm/rulesets/$C_id", "--max-distance", "0") };
assert { ls("//module/rulesets/$D_id", "$D_id -> //bm/rulesets/$D_id", "--max-distance", "0") };

build();

assert { eexists("$bam_basedir/A/foo") };

teardown();
