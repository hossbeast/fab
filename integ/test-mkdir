#!/usr/bin/env perl

#
# anchor
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
our $bam_projdir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

init(subdir => 'B');
setup(<<"TREE");
|-- A
|   `-- foo
|   `-- rules.bam+devel <<
rule foo -> boats/bar : cp.bam
rule foo -> \$^D/bar : cp.bam
rule **/bar -> //targets
>>
|   `-- cp.bam << 0777
file : {
  path-search : cp    # this needs the config to resolve
}
args : [
  \$bm_source0
  \$bm_target0
]
>>
|-- B
|   `-- module.bam+devel <<
anchor ../A
>>
|-- system-config <<
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}
filesystem : {
  exclude : {
    foo
  }
  fstrees : {
    $bam_basedir : {
      mount : true
      mkdir : true
    }
    $bam_basedir/B : {
      mount : true
      mkdir : true
    }
  }
}
>>
TREE

my $B_id = hash64("$bam_projdir");

# base link points to the right node
my $result = bam_ls(["//modules/$B_id/base", "--no-follow"]);
my $ref = $$result{out};
assert { $ref eq "base -> $bam_basedir/B" };

# anchor link points to the right node
$result = bam_ls(["//modules/$B_id/anchor", "--no-follow"]);
$ref = $$result{out};
assert { $ref eq "anchor -> $bam_basedir/A" };

# before
assert {
  stats(undef, {
    modules => 1
})};
assert {
  stats("//filesystem", {
    mkdir => 1
})};
assert {
  stats("$bam_basedir/B", "-S", {
    type => 'module'
  , state => 'fresh'
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert {
  stats("$bam_basedir/B", {
    type => 'module-dir'
  , state => 'fresh'
  , mkdir => 0
})};
assert {
  stats("$bam_basedir/B/boats", {
    type => 'dir'
  , state => 'fresh'
  , mkdir => 1
})};
assert {
  stats("$bam_basedir/A", {
    type => 'dir'
  , state => 'fresh'
  , mkdir => 0
})};

build();
assert_file("$bam_projdir/boats/bar");
assert_file("$bam_projdir/bar");
teardown();
