#!/usr/bin/env perl

#
# delete unreferenced files in the build dir, honoring these settings
#  fstree unlink=true  (fstree)
#  managed             (module)
#
# in this test, the file becomes unreferenced because its counterpart in the anchor dir is gone
# and two levels of directories
# reverse unlink order
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<"TREE");
|-- A
|   `-- a0
|   `-- a1
|   `-- a2
|-- B
|   `-- module.bam%devel <<
managed
anchor ../A

rule a0 -> C/D/E/b0 : ./cp.bam+(.)
rule a1 -> C/D/b1 : ./cp.bam+(.)
rule a2 -> C/b2 : ./cp.bam+(.)
>>
|   `-- cp.bam << 0777
file : {
  lookup : {
    namespace : coreutils
    pattern : bin/cp+(.@)
  }
}
args : [
  \$bm_source0
  \$bm_target0
]
>>
|-- system-config <<
namespaces : {
  coreutils
}
filesystem : {
  fstrees : {
    $bam_basedir/A : {
      mount : true
    }
    $bam_basedir/B : {
      mount : true
      mkdir : true
      unlink : true
    }
    $repodir/usr/share/bam/coreutils : {
      mount : true
      namespaces : {
        coreutils
      }
    }
  }
}
>>
TREE

my $module_id = bam::identity("module", "$bam_basedir/B");
my $fstree_id = bam::identity("fstree", "$bam_basedir/B");

#
#
#
print("\n >> 1 - INITIAL <<\n\n");
assert {
  stats("//bm/sys-filesystem", "--follow", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
})};
assert {
  stats("//bm/fstrees/$fstree_id", "--follow", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
})};
assert {
  stats("//bm/modules/$module_id", "-S", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
})};
assert {
  stats("$bam_basedir/B", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
})};

build();
my $res = bam_tree(["$bam_basedir"]);
print("$$res{out}\n");
assert { eexists("$bam_basedir/A/a0") };
assert { eexists("$bam_basedir/A/a1") };
assert { eexists("$bam_basedir/A/a2") };
assert { eexists("$bam_basedir/B/C/D/E/b0") };
assert { eexists("$bam_basedir/B/C/D/b1") };
assert { eexists("$bam_basedir/B/C/b2") };

#
#
#
print("\n >> 2 - unlink a0 in anchor dir <<\n\n");
unlink("$bam_basedir/A/a0");
reconcile();

build();
$res = bam_tree(["$bam_basedir"]);
print("$$res{out}\n");
assert { enoent("$bam_basedir/A/a0") };
assert { eexists("$bam_basedir/A/a1") };
assert { eexists("$bam_basedir/A/a2") };
assert { enoent ("$bam_basedir/B/C/D/E") };
assert { eexists("$bam_basedir/B/C/D/b1") };
assert { eexists("$bam_basedir/B/C/b2") };

assert {
  stats("//bm/sys-filesystem", "--follow", {
      unlink_ok => 1
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 1
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("//bm/fstrees/$fstree_id", "--follow", {
      unlink_ok => 1
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 1
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("//bm/modules/$module_id", "-S", {
      unlink_ok => 1
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 1
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("$bam_basedir/B", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 0
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("$bam_basedir/B/C", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 0
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("$bam_basedir/B/C/D", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 1
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};

#
#
#
print("\n >> 3 - unlink a1 in anchor dir <<\n\n");
unlink("$bam_basedir/A/a1");
reconcile();

build();
$res = bam_tree(["$bam_basedir"]);
print("$$res{out}\n");
assert { enoent("$bam_basedir/A/a0") };
assert { enoent("$bam_basedir/A/a1") };
assert { eexists("$bam_basedir/A/a2") };
assert { enoent ("$bam_basedir/B/C/D/E") };
assert { enoent ("$bam_basedir/B/C/D") };
assert { eexists("$bam_basedir/B/C/b2") };

assert {
  stats("//bm/sys-filesystem", "--follow", {
      unlink_ok => 2
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 2
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("//bm/fstrees/$fstree_id", "--follow", {
      unlink_ok => 2
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 2
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("//bm/modules/$module_id", "-S", {
      unlink_ok => 2
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 2
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("$bam_basedir/B", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 0
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("$bam_basedir/B/C", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 1
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};

#
#
#
print("\n >> 4 - unlink a2 in anchor dir <<\n\n");
unlink("$bam_basedir/A/a2");
reconcile();

build();
$res = bam_tree(["$bam_basedir"]);
print("$$res{out}\n");

assert { enoent("$bam_basedir/A/a0") };
assert { enoent("$bam_basedir/A/a1") };
assert { enoent("$bam_basedir/A/a2") };
assert { enoent ("$bam_basedir/B/C/D/E") };
assert { enoent ("$bam_basedir/B/C/D") };
assert { enoent ("$bam_basedir/B/C") };

assert {
  stats("//bm/sys-filesystem", "--follow", {
      unlink_ok => 3
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 3
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("//bm/fstrees/$fstree_id", "--follow", {
      unlink_ok => 3
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 3
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("//bm/modules/$module_id", "-S", {
      unlink_ok => 3
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 3
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};
assert {
  stats("$bam_basedir/B", {
      unlink_ok => 0
    , unlink_err => 0
    , unlink_no => 0
    , unlink_enoent => 0
    , rmdir_ok => 1
    , rmdir_err => 0
    , rmdir_no => 0
    , rmdir_enoent => 0
})};

teardown();
