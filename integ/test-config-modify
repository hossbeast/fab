#!/usr/bin/env perl

#
# This test exercises config.bam file changes
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# config file with syntax error
init();
my $testdir = setup(<<'TREE');
|-- module.bam+devel
|-- config.bam+devel <<
>>
TREE

# 1. empty config.bam file
assert {
  stats(undef, {
      system_state_ok => 1
    , configset_files => 1
})};
assert {
  info({
    "system-state" => 'ok'
})};
assert { stats("config.bam+devel", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 1
  , parse_ok => 1
})};

# 2. config.bam file changed
open my $fh, ">", "$testdir/config.bam+devel" or die $!;
print $fh <<'TEXT';
build : {
  concurrency : 42
}
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ok => 2
  , configset_files => 1
})};
assert { stats("config.bam+devel", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 2
  , parse_ok => 2
})};
my $res = bam_config();
assert { $$res{out} =~ /concurrency/ };

# 3. config.bam file changed
open $fh, ">", "$testdir/config.bam+devel" or die $!;
print $fh <<'TEXT';
filesystem : {
  fstrees : {
    /foo/bar : {
      mkdir : false
    }
  }
}
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ok => 3
  , configset_files => 1
})};
assert { stats("config.bam+devel", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 3
  , parse_ok => 3
})};
$res = bam_config();
assert { $$res{out} !~ /concurrency/ };
assert { $$res{out} =~ /mkdir : false/ };
assert { $$res{out} !~ /mkdir : true/ };

# 4. config.bam file changed
open $fh, ">", "$testdir/config.bam+devel" or die $!;
print $fh <<'TEXT';
filesystem : {
  fstrees : {
    / : {
      mkdir : true
    }
  }
}
TEXT
close $fh;

reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ok => 4
  , configset_files => 1
})};
assert { stats("config.bam+devel", "-S", {
    type => "configset"
  , state => 'fresh'
  , parse => 4
  , parse_ok => 4
})};
$res = bam_config();
assert { $$res{out} !~ /concurrency/ };
assert { $$res{out} !~ /mkdir : false/ };
assert { $$res{out} =~ /mkdir : true/ };

teardown();
