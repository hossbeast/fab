#!/usr/bin/env perl

#
# This test has a formula with a syntax error, fixes the error, then checks that when the
# system is reconciled, the module is reloaded
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# references non-existent formula
init();
my $testdir = setup({tolerant => 1 }, <<'TREE');
|-- module.bam%devel <<
rule -- boats : ./foo.bam+(.)
rule boats -> //targets
>>
|-- foo.bam << 0777
# this formula has a syntax error
file : {
  path-search : date  foooo
}
>>
TREE

# before - in spite of the invalid formula, the module has still loaded
assert {
  stats(undef, {
    modules => 1
  , system_state_ready => 0
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("module.bam%devel", "-S", {
    parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("foo.bam", "-S", {
    parse_err => 1
  , parse_ok => 0
  , state => "stale"
})};

# fix the formula
open my $fh, ">", "$testdir/foo.bam" or die $!;
print $fh <<'TEXT';
TEXT
close $fh;

reconcile();
assert {
  stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 1       # was not invalidated
  , state => "fresh"
})};
assert {
  stats("module.bam%devel", "-S", {
    parse_err => 0
  , parse_ok => 1
  , state => "fresh"
})};
assert {
  stats("foo.bam", "-S", {
    parse_err => 1
  , parse_ok => 1
  , state => "fresh"
})};
teardown();
