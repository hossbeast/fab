#!/usr/bin/env perl

#
# This test exercises various cases of fstree / namespace associations
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init(subdir => 'B');
setup(<<"TREE");
|-- A
|   `-- C
|       `-- D
|-- B
|   `-- module.bam%devel <<
>>
|-- system-config <<
namespaces : {
  ns0
  ns1
}
filesystem : {
  fstrees : {
    $bam_basedir/A : {
      mkdir : true
      mount : true
      namespaces : {
        ns0
        ns1
      }
    }
  }
}
>>
TREE

my $ns0_namespace_id = bam::identity('namespace', "ns0");
my $ns1_namespace_id = bam::identity('namespace', "ns1");
my $modules_namespace_id = bam::identity('namespace', "modules");
my $fstree_id = bam::identity("fstree", $bam_basedir);
my $A_fstree_id = bam::identity("fstree", "$bam_basedir/A");
my $B_fstree_id = bam::identity("fstree", "$bam_basedir/B");

print("ns0 $ns0_namespace_id\n");
print("ns1 $ns1_namespace_id\n");

# initially, both namespaces
assert {
  stats(undef, {
      fstrees => 5    # root, shadow
    , namespaces => 5 # formulas, modules, plugins, ns0, ns1
    , fsnames => 4
})};
assert { eexists("//bm/namespaces/$modules_namespace_id") }; # modules namespace always exists
assert { eexists("//bm/namespaces/$ns0_namespace_id") };
assert { eexists("//bm/namespaces/$ns1_namespace_id") };
assert { eexists("//bm/fstrees/$fstree_id") };       # from system-config dir
assert { eexists("//bm/fstrees/$B_fstree_id") };     # from base dir
assert { eexists("//bm/fstrees/$A_fstree_id") };     # from config

assert {
  stats("//bm/namespaces/$ns0_namespace_id", "-S", {
      type => 'namespace'
    , count => 2
    , del => 0
    , put => 2
})};

my $names = bam_namespace_fsnames_map($ns0_namespace_id);
assert { scalar %$names == 2 };
assert { $$names{A} };
assert { $$names{C} };

assert {
  stats("//bm/namespaces/$ns1_namespace_id", "-S", {
      type => 'namespace'
    , count => 2
    , del => 0
    , put => 2
})};

$names = bam_namespace_fsnames_map($ns1_namespace_id);
assert { scalar %$names == 2 };
assert { $$names{A} };
assert { $$names{C} };

# remove one namespace
open my $fh, ">", "$bam_basedir/system-config" or die $!;
print $fh <<"TEXT";
namespaces : {
  ns0
}
filesystem : {
  fstrees : {
    $bam_basedir/A : {
      mkdir : true
      mount : true
      namespaces : {
        ns0
      }
    }
  }
}
TEXT
close $fh;

reconcile();

bam_debug();
assert {
  stats(undef, {
      fstrees => 5
    , namespaces => 4 # formulas, modules, plugins, ns0
    , fsnames => 2
})};
assert { eexists("//bm/namespaces/$modules_namespace_id") };
assert { eexists("//bm/namespaces/$ns0_namespace_id") };
assert { enoent("//bm/namespaces/$ns1_namespace_id") };

# ns0 still exists, has the same names
assert {
  stats("//bm/namespaces/$ns0_namespace_id", "-S", {
      type => 'namespace'
    , count => 2
    , del => 0
    , put => 2
})};

$names = bam_namespace_fsnames_map($ns0_namespace_id);
assert { scalar %$names == 2 };
assert { $$names{A} };
assert { $$names{C} };

# ns1 has been removed
assert { enoent("//bm/namespaces/$ns1_namespace_id") };

teardown();
