#!/usr/bin/env perl

#
# This test checks whether bind rules in conditional blocks are applied correctly
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use Carp qw(confess);
$SIG{__DIE__} = 'confess';

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

init();
setup(<<"TREE");
|-- module.bam%devel <<
{
  if(\$a)
  bind B => //B
}
>>
|-- var.bam%devel <<
a : true
>>
|-- B
|   |-- foo
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : {
      mount : true
      namespaces : {
        modules
      }
    }
  }
}
TREE

print("\n >> 1 - conditional evaluation, true <<\n\n");
assert {
  stats(undef, {
    system_state_ready => 1
  , system_state_ok => 0
  , system_error => 0
  , modules => 1
  , fstrees => 3
  , namespaces => 3
})};
assert {
  stats("var.bam%devel", "-S", {
    type => "varset"
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , rules => 1
  , parse_err => 0
  , parse_ok => 1
})};

# binding is present
assert { ls("//B", "B -> $bam_basedir/B") };

print("\n >> 2 - conditional evaluation, false <<\n\n");
open my $fh, ">", "$bam_basedir/var.bam%devel" or die $!;
print $fh <<'TEXT';
a : false
TEXT
close $fh;

reconcile();
assert { info({
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
    system_state_ready => 2
  , system_state_ok => 0
  , system_error => 0
  , modules => 1
  , fstrees => 3
  , namespaces => 3
})};
assert {
  stats("var.bam%devel", "-S", {
    type => "varset"
  , state => 'fresh'
  , stale => 2
  , fresh => 2
  , parse_err => 0
  , parse_ok => 2
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 2
  , fresh => 2
  , reloaded => 2
  , rulesets => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , rules => 1
})};

# binding is absent
assert { enoent("//B") };

print("\n >> 3 - conditional evaluation, back to true <<\n\n");
open $fh, ">", "$bam_basedir/var.bam%devel" or die $!;
print $fh <<'TEXT';
a : true
TEXT
close $fh;

reconcile();
assert { info({
    "system-state" => 'ready'
})};
assert {
  stats(undef, {
    system_state_ready => 3
  , system_state_ok => 0
  , system_error => 0
  , modules => 1
  , fstrees => 3
  , namespaces => 3
})};
assert {
  stats("var.bam%devel", "-S", {
    type => "varset"
  , state => 'fresh'
  , stale => 3
  , fresh => 3
  , parse_err => 0
  , parse_ok => 3
})};
assert {
  stats(".", "-S", {
    type => 'module'
  , state => 'fresh'
  , stale => 3
  , fresh => 3
  , reloaded => 3
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => 'fresh'
  , stale => 1
  , fresh => 1
  , parse_err => 0
  , parse_ok => 1
  , rules => 1
})};

# binding is present
assert { ls("//B", "B -> $bam_basedir/B") };

teardown();
