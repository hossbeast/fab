#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# var file syntax error
init();
my $testdir = setup({tolerant => 1}, <<'TREE');
|-- module.bam+devel
|-- var.bam+devel <<
lflags.devel ::
>>
TREE

# before
assert { stats(undef, {
    modules => 1
  , system_state_ok => 0
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "stale"
  , reloaded => 0     # prevents the module from loading
  , parse => 1
  , parse_ok => 1
})};
assert { stats("var.bam+devel", "-S", {
    parse => 1
  , parse_ok => 0
  , state => 'stale'
})};

# var file syntax fixed
open my $fh, ">", "$testdir/var.bam+devel" or die $!;
print $fh <<'TEXT';
lflags.devel : A
TEXT
close $fh;

# after - corrected syntax, now module and varfile are fresh
reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ok => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1     # module is now loaded
  , parse => 1
  , parse_ok => 1
})};
assert { stats("var.bam+devel", "-S", {
    parse => 2
  , parse_ok => 1
  , state => "fresh"
})};
teardown();
