#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# var file syntax error
init();
setup({tolerant => 1}, <<'TREE');
|-- module.bam%devel
|-- var.bam%devel <<
lflags.devel ::
>>
TREE

# before
assert { stats(undef, {
    modules => 1
  , system_state_ready => 0
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "stale"
  , reloaded => 0     # prevents the module from loading
})};
assert { stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("var.bam%devel", "-S", {
    type => 'varset'
  , state => 'stale'
  , stale => 1
  , fresh => 0
  , parse_err => 1
  , parse_ok => 0
})};

# var file syntax fixed
open my $fh, ">", "$bam_basedir/var.bam%devel" or die $!;
print $fh <<'TEXT';
lflags.devel : A
TEXT
close $fh;

# after - corrected syntax, now module and varfile are fresh
reconcile();
assert { stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert { stats(".", "-S", {
    type => 'module'
  , state => "fresh"
  , reloaded => 1     # module is now loaded
})};
assert { stats("./module.bam%devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert { stats("var.bam%devel", "-S", {
    type => 'varset'
  , stale => 1
  , fresh => 1
  , parse_err => 1
  , parse_ok => 1
  , state => "fresh"
})};
teardown();
