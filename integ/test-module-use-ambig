#!/usr/bin/env perl

#
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
our $bam_basedir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam;

# unresolved use ref
init(subdir => 'B');
setup(<<TREE);
|-- A
    `-- rules.bam+devel <<
rule foo -> bar
>>
|-- C
    `-- foo
|-- B
    `-- module.bam+devel <<
use A
>>
|-- system-config <<
filesystem : {
  fstrees : {
    $bam_basedir : { mount : true }
  }
}
>>
TREE

my $A_rules_id = hash64("$bam_basedir/A/rules.bam+devel");
my $CA_rules_id = hash64("$bam_basedir/C/A/rules.bam+devel");

# 1. A ref resolves -> A
assert { stats(undef, {
    modules => 1
  , ruleset_files => 1
  , system_state_ok => 1
})};
assert { stats(".", "-S", {
    type => "module"
  , state => "fresh"
  , fresh => 1
  , stale => 1
  , parse => 1
  , parse_ok => 1
  , reloaded => 1
  , uses_down => 1
  , modules_up => 0
  , modules_down => 0
})};
assert { stats("$bam_basedir/A/rules.bam+devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , fresh => 1
  , stale => 1
  , parse => 1
  , parse_ok => 1
  , uses_up => 1
})};

assert { ls("//module/rulesets/$A_rules_id", "$A_rules_id -> //rulesets/$A_rules_id") };

# create a second target for resolving A
#  creating C/A invalidates B/module through the index-vertex with label A
mkdirp("$bam_basedir/C/A");
open my $fh, ">$bam_basedir/C/A/rules.bam+devel";
print $fh <<'TEXT';
rule baz -> qux
TEXT
close $fh;
chmod 0644, "$bam_basedir/C/A/rules.bam+devel" or die $!;

# 2. A ref is now ambiguous
reconcile(expect_error => 1);
assert { stats(undef, {
    modules => 1
  , ruleset_files => 1
  , system_state_ok => 1
})};
# module reload attempted but unsuccessful
assert { stats(".", "-S", {
    type => "module"
  , state => "stale"
  , fresh => 1
  , stale => 2
  , modules_up => 0
  , modules_down => 0
  , reloaded => 1
  , parse => 1
  , parse_ok => 1
})};
assert { stats("$bam_basedir/A/rules.bam+devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , fresh => 1
  , stale => 1      # not invalidated by rma-rules disconnect event
  , parse => 1
  , parse_ok => 1
})};

#
# remove the first target for resolving A -- now the reference is unambiguous
#
unlink("$bam_basedir/A/rules.bam+devel") or die $!;
rmdir("$bam_basedir/A") or die $!;

reconcile();
assert { stats(undef, {
    modules => 1
  , ruleset_files => 1
  , system_state_ok => 2
})};
assert { stats(".", "-S", {
    type => "module"
  , state => "fresh"
  , fresh => 2
  , stale => 2
  , modules_up => 0
  , modules_down => 0
  , uses_down => 1
  , reloaded => 2
  , parse => 1
  , parse_ok => 1
})};
assert { stats("$bam_basedir/C/A/rules.bam+devel", "-S", {
    type => 'ruleset'
  , state => "fresh"
  , fresh => 1
  , stale => 1      # not invalidated by rma-rules disconnect event
  , parse => 1
  , parse_ok => 1
  , uses_up => 1
})};

teardown();
