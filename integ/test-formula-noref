#!/usr/bin/env perl

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
use lib "$repodir/integ/lib";
use lib "$repodir/perl";
use lib "$repodir/libbacon/perl";
use util;
use tree;
use bam::bam;
use integ;

# module file - reference to not-found formula
init();
my $testdir = setup({ tolerant => 1 }, <<'TREE');
|-- module.bam%devel <<
rule -- boats : ./foo.bam+(.)
rule boats -> //targets
>>
TREE

# before
assert {
  stats(undef, {
    modules => 1
  , system_state_ok => 0
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => "ruleset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};

# create the formula
open my $fh, ">", "$testdir/foo.bam" or die $!;
print $fh <<'TEXT';
#!/usr/bin/env perl
open FH, ">", $ENV{bm_target0} or die $!;
print FH "foo\n";
close FH;
TEXT
close $fh;
chmod 0777, "$testdir/foo.bam" or die $!;

# the module has not been reloaded, but the targets which the formula is now attached to have been invalidated
reconcile();
assert {
  stats(undef, {
    modules => 1
  , system_state_ready => 1
})};
assert {
  stats(".", "-S", {
    type => "module"
  , state => 'fresh'
  , reloaded => 1
})};
assert {
  stats("./module.bam%devel", "-S", {
    type => "ruleset"
  , state => 'fresh'
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("foo.bam", "-S", {
    type => 'formula'
  , state => "fresh"
  , parse_err => 0
  , parse_ok => 1
})};
assert {
  stats("boats", {
  state => "uncreated"
})};

# run the build - this creates the file
build();
assert {
  stats("boats", {
    state => "fresh"
  , fresh => 1
})};

# file was created by the foo formula
assert_file("$testdir/boats", "foo");
teardown();
