use flex
use bison

rule **+(/) => [*] //module/include

# pull in non-test object files in the module
rule $^D/**~test~assert/*.o -> libbacon.a

# default build targets
rule libbacon.a -> //targets

{
  if($CONFIG_DEVEL)
  rule $^D/assert/*.o -> libbacon.a 
}
