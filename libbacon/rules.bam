use flex
use bison

rule **+(/) => [*] //module/include

# pull in non-test object files in the module
rule { search : module } **~test~assert/*.o -> libbacon.a

# default build targets
rule libbacon.a -> //targets

{
  if($CONFIG_DEVEL)
  rule { search : module } assert/*.o -> libbacon.a 
}
