#!/usr/bin/env perl

#
# with autobuild in effect, bamd will run the build when changes are detected
#
# build slots in the same stage run in parallel, so their results are produced in a non-deterministic order. because of
# this, in presence of multiple files with syntax errors, autobuild will tend to flip between failing files
#
# the autobuild-focus plugin helps in this situation. when autobuild has failed multiple slots in the same stage, it
# picks one of them, and re-places the goals to build just that one target. once it has succeeded, it restores the
# original goals.
#
# autobuild recognizes the goals token of its own pid as being compatible
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

# devel plugins take modules from the repo dir
use File::Basename;
use Cwd;
our $repodir;
BEGIN { $repodir = dirname(Cwd::realpath("$0/..")) }
BEGIN { unshift @INC, "$repodir/libbacon/perl" }
BEGIN { unshift @INC, "$repodir/perl" }

use Data::Dumper;
use POSIX;
use bam::bacon;

sub tx {
  my $s = shift;
  POSIX::write(1001, $s, length($s));
}

sub say {
  my $s = shift;
  $s .= "\n";
  POSIX::write(1, $s, length($s));
}

sub err {
  my $s = shift;
  POSIX::write(2, $s, length($s));
}

sub interval {
  my $ns = shift;

  use integer;

  my $s = $ns / (1000 * 1000 * 1000);
  $ns -= $s * (1000 * 1000 * 1000);

  my $ms = $ns / (1000 * 1000);
  $ns -= $ms * (1000 * 1000);

  my $us = $ns / 1000;
  $ns -= $us * 1000;

  sprintf("%02u.%03u.%03u.%03u", $s, $ms, $us, $ns)
}

tx(<<MSG);
eventsub : [
  goals-set
  build-start
  build-end
  formula-fork
  formula-reap
]

MSG
tx(<<MSG);
plugin-ready

MSG

sub build_show
{
  my $stages = shift;

  for my $stage (@$stages) {
    for my $slot (@$stage) {
      my $forked = $$slot{forked};
      my $path = $$forked{path};
      my $slash = rindex($path, '/');
      $path = substr($path, $slash + 1);
      my $targets = join(", ", @{$$forked{targets}});
    }
  }
}

# properties of the autobuild goals (set by bam autorun functionality)
my $autorun_goals_text;
my $autorun_goals_token;
my $autorun_goals_pid;

my %slots;       # build slots for the most recent build
my $text;
my $msg;
my $line;
my $slot;
my $build_end;
my @stages;
my $label;
my $path;
my $x;
my $success;

while(1)
{
  # messages are separated by two newlines
  $text = '';
  while(1) {
    $line = <STDIN>;
    if(!defined($line)) {
      exit;
    }
    chomp($line);
    if(length($line) == 0) {
      last;
    }
    $text .= "\n" if($text);
    $text .= $line;
  }

  if($text eq 'plugin-ready-request') {
tx(<<MSG);
plugin-ready

MSG
    next;
  }

  $msg = bam::bacon::parse($text);
  if($$msg{"goals-set"}) {
    # bam autobuild uses this label
    if(!exists($$msg{"goals-set"}{"//bm/sys-goals"}{label})) {
      next;
    }
    # goals from some other source
    if($$msg{"goals-set"}{"//bm/sys-goals"}{label} ne "bam-autobuild") {
      next;
    }

    # save the token
    $autorun_goals_token = $$msg{"goals-set"}{"//bm/sys-goals"}{token};
    $autorun_goals_pid = $$msg{"goals-set"}{"//bm/sys-goals"}{pid};

    # save the goals text
    $autorun_goals_text = $text;

    # unwrap from the goals-set event
    $autorun_goals_text =~ s/^\s*goals-set\s+:\s+{//;
    $autorun_goals_text =~ s/\s+}$//;

    # unwrap from the //bm/sys-goals mapping
    $autorun_goals_text =~ s/^\s*\/\/bm\/sys-goals\s+:\s+{//;
    $autorun_goals_text =~ s/\s+}$//;

    # elide some unnecessary fields
    $autorun_goals_text =~ s/^\s*duration\s+:\s+"[^"]+"\s*$//m;

    # normalize whitespace
    $autorun_goals_text =~ s/\n+/\n/gm;
  } elsif($$msg{forked}) {
    $slots{$$msg{forked}{pid}} = $msg;
  } elsif($$msg{waited}) {
    $slot = $slots{$$msg{waited}{pid}};
    $$slot{waited} = $$msg{waited};
  } elsif($$msg{"build-start"}) {
    %slots = ();
  } elsif($$msg{"build-end"}) {
    $build_end = $$msg{"build-end"};

    # check expected label
    if(!exists($$build_end{label}) || !exists($$build_end{token})) {
      next;
    }

    # check for focus build triggered by this plugin
    if($$build_end{label} eq "autobuild-focus" && $$build_end{token} eq $autorun_goals_pid && $$build_end{pid} == $$) {
      # build completed successfully -- restore the old goals
      if($$build_end{success}) {
        tx("goals : { $autorun_goals_text }\n\n");
      }

      next;
    }

    # check for autorun build triggered by bam autobuild
    if($$build_end{label} ne "bam-autobuild" || $$build_end{token} ne $autorun_goals_token) {
      next;
    }

    # not autorun triggered
    if(!$$build_end{autorun}) {
      next;
    }

    # build did not fail
    if($$build_end{success}) {
      next;
    }

    @stages = ();
    for $slot (values %slots) {
      push @{$stages[$$slot{forked}{stage}]}, $slot;
    }

    # no-op build
    if($#stages < 0) {
      next;
    }

    # only a single formula ; build was already focused
    if($#{$stages[$#stages]} < 1) {
      next;
    }

    # pick a random failed slot
    for($x = 0; $x <= $#{$stages[$#stages]}; $x++) {
      $slot = $stages[$#stages][$x];
      $success = $$slot{waited}{status} == 0 && $$slot{waited}{"stderr-total"} == 0;
      if(!$success) {
        last;
      }
    }

    # not expected ; the build failed, by definition there must be a failed slot
    if($x > $#{$stages[$#stages]}) {
      next;
    }

    $slot = $stages[$#stages][$x];
    $path = $$slot{forked}{targets}[0];

    # flip the goals to focus on this one target
    tx(<<MSG);
goals : {
  token : $autorun_goals_token
  label : autobuild-focus
  target-transitive : [
    path : {
      pattern : $path
      hidden : true
    }
  ]
  reconcile
  build
}

MSG
  }
}
