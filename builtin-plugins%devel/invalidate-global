#!/usr/bin/env perl

#
# subscribe to the node-stale event and, when any matching node becomes stale, post
# a global invalidation event
#

use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

BEGIN { push @INC, '/home/todd/bam/libbacon/perl' }

use POSIX;
use Getopt::Long qw|GetOptionsFromArray|;
use bacon;

open my $fh, ">/tmp/a" or die $!;

sub say {
  my $s = shift;
  print $fh "$s\n";
}

sub tx {
  my $s = shift;
  POSIX::write(1001, $s, length($s));
}

my %args;
my %optargs = (
    'suffix=s'    => \@{$args{suffixes}}
  , 'prefix=s'    => \@{$args{prefixes}}
);
GetOptionsFromArray(\@ARGV, %optargs);

die "unexpected arguments " . join(" ", @ARGV) if @ARGV;

tx(<<MSG);
eventsub : [
  node-stale
]

plugin-ready

MSG

while(1)
{
  # messages are separated by two newlines
  my $text = '';
  while(1) {
    my $line = <STDIN>;
    chomp($line);
    if(length($line) == 0) {
      last;
    }
    $text .= "\n" if($text);
    $text .= $line;
  }

  # bamd sends this event o all plugins on reconciliation
  if($text eq 'plugin-ready-request') {
tx(<<MSG);
plugin-ready

MSG
    next;
  }

  my $msg = bacon_parse($text);
  if(!exists($$msg{"node-stale"})) {
    next;
  }
  my $path = $$msg{"node-stale"}{path};

  # check if the path starts with any prefix
  my $x;
  for ($x = 0; $x <= $#{$args{prefixes}}; $x++)
  {
    my $prefix = $args{prefixes}[$x];
    if(substr($path, 0, length($prefix)) eq $prefix) {
      last;
    }
  }

  # no match
  if($#{$args{prefixes}} == -1) {
  } elsif($x <= $#{$args{prefixes}}) {
  } else {
    next;
  }

  # check if the path ends with any suffix
  for ($x = 0; $x <= $#{$args{suffixes}}; $x++)
  {
    my $suffix = $args{suffixes}[$x];
    if(substr($path, length($suffix) * -1) eq $suffix) {
      last;
    }
  }

  # no match
  if($#{$args{suffixes}} == -1) {
  } elsif($x <= $#{$args{suffixes}}) {
  } else {
    next;
  }

  # ignore the events generated while processing the global invalidation
  tx(<<MSG);
eventsub : [
]

MSG

  # invalidate all primary files
  tx(<<MSG);
invalidate-primary

MSG

  # re-subscribe
  tx(<<MSG);
eventsub : [
  node-stale
]

MSG
}
