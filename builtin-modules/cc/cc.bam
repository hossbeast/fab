file : {
  path-search : cc
}
args : [
  $cflags
  sequence : [
    select : [
      module
      # all directories in the module
      traverse : {
        direction : down
        min-distance : 0
        graph : dirtree
      }
    ]
    property : relpath
    prepend : "-I"
  ]

  sequence : [
    select : [
      module
      # imported directories
      traverse : {
        direction : down
        graph : imports
      }
    ]
    property : relpath
    prepend : "-I"
  ]
  $bm_source
  "-c"
  "-o" $bm_target
]
