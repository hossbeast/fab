use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;
use POSIX;

die "cc not found" unless $ENV{cc};

# exec into the compiler
my @cmd = (
    $ENV{cc}
  , split(/ /, $ENV{CFLAGS})
  , (map { "-I$_" } @ARGV)    # other arguments are include paths
  , $ENV{bm_source0}
  , "-c"
  , "-o", $ENV{bm_target0}
);

my $s = join(" ", @cmd)) . "\n";
POSIX::write(1001, $s, length($s));
exec { $cmd[0] } @cmd

__DATA__

envs : {
  cc : {
    lookup : {
      pattern : bin/cc+(.@)
      namespace : base-devel
    }
  }
}
args : [
  sequence : [
    select : [
      path : {
        pattern : //module/include
      }
      traverse : {
        direction : down
        min-distance : 1
        max-distance : 1
      }
    ]
    property : relpath
  ]
]
