use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;
use POSIX;

die "CC not found" unless $ENV{CC};

# exec into the compiler
my @cmd = (
    $ENV{CC}
  , split(/ /, $ENV{CFLAGS} || '')
  , (map { "-I$_" } @ARGV)    # other arguments are include paths
  , $ENV{bm_source0}
  , "-c"
  , "-o", $ENV{bm_target0}
);

print(join(" ", @cmd));

exec { $cmd[0] } @cmd

__DATA__

envs : {
  CC : {
    path-search : cc
  }
}
args : [
  sequence : [
    select : [
      lookup : {
        path : //module/include
      }
      traverse : {
        direction : down
        min-distance : 1
        max-distance : 1
      }
    ]
    property : relpath
  ]
]
