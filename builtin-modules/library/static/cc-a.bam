use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;
use POSIX;

die "ar not found" unless $ENV{ar};

my @arflags;
push @arflags, split(/ /, $ENV{arflags}) if $ENV{arflags};

my @cmd = (
    $ENV{ar}
  , @arflags
  , "rcs"
  , $ENV{bm_target0}
  # object files in this module
  , grep { substr($_, -2) eq ".o" } split(/ /, $ENV{objects})
);

# no combination of arguments will cause ar to actually recreate the entire archive
# note that ar actually creates a tempfile then copies from there to the target file
unlink($ENV{bm_target0});

my $s = join(" ", @cmd) . "\n";
POSIX::write(1001, $s, length($s));
exec { $cmd[0] } @cmd;

__DATA__

envs : {
  ar : {
    lookup : {
      pattern : bin/ar+(.@)
      namespace : binutils
    }
  }

  # object files for the library
  objects : {
    sequence : [
      select : [
        target
        traverse : {
          direction : down
          graph : depends
          max-distance : 2
          min-distance : 2
        }
      ]
      property : relpath
    ]
  }

  includes : {
    sequence : [
      # include directories matched by the include rule
      select : [
        path : {
          pattern : //module/include
        }
        traverse : {
          direction : down
          min-distance : 1
          max-distance : 1
        }
      ]
      property : relpath
    ]
  }
}
