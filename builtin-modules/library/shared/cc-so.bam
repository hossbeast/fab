use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;
use POSIX;

die "cc not found" unless $ENV{cc};

my $name = basename($ENV{bm_target});
my $dot = index($name, ".");
my $soname = substr($name, 0, $dot) . ".so";
my $lnk = $ENV{bm_target} . ".lnk";

my @cmd = (
    $ENV{cc}
  , split(/ /, $ENV{CFLAGS})
  , "-shared"
  # linker script
  , "-Wl,--version-script=$lnk"
  # soname
  , "-Wl,-soname,$soname"
  , (map { "-I$_" } split(/ /, $ENV{includes}))
  , "-o", $ENV{bm_target}
  # object files in this module
  , grep { substr($_, -2) eq ".o" } split(/ /, $ENV{objects})
);

my $s = join(" ", @cmd) . "\n";
POSIX::write(1001, $s, length($s));
exec { $cmd[0] } @cmd;

__DATA__

envs : {
  cc : {
    lookup : {
      pattern : bin/cc+(.@)
      namespace : base-devel
    }
  }

  # object files for the library
  objects : [
    sequence : [
      select : [
        target
        traverse : {
          direction : down
          graph : depends
          max-distance : 1
          min-distance : 1
        }
      ]
    ]
    property : relpath
  ]

  includes : [
    sequence : [
      # include directories matched by the include rule
      select : [
        path : {
          pattern : //module/include
        }
        traverse : {
          direction : down
          min-distance : 1
          max-distance : 1
        }
      ]
      property : relpath
    ]
  ]
}
