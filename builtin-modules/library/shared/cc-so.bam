use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;

die "CC not found" unless $ENV{CC};

my $name = basename($ENV{bm_target});
my $dot = index($name, ".");
my $soname = substr($name, 0, $dot) . ".so";
my $lnk = $ENV{bm_target} . ".lnk";

my @cmd = (
    $ENV{CC}
  , split(/ /, $ENV{CFLAGS})
  , "-shared"
  # linker script
  , "-Wl,--version-script=$lnk"
  # soname
  , "-Wl,-soname,$soname"
  , (map { "-I$_" } split(/ /, $ENV{includes}))
  , "-o", $ENV{bm_target}
  # object files in this module
  , grep { substr($_, -2) eq ".o" } split(/ /, $ENV{objects})
);

exec { $cmd[0] } @cmd

__DATA__

envs : {
  CC : {
    path-search : cc
  }

  # object files for the library
  objects : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 1
        min-distance : 1
      }
    ]
    property : relpath
  ]

  includes : [
    # include directories matched by the include rule
    select : [
      lookup : {
        path : //module/include
      }
      traverse : {
        direction : down
        min-distance : 1
        max-distance : 1
      }
    ]
    property : relpath
  ]
}
