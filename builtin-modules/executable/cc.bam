use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;

die "cc not found" unless $ENV{cc};

my @libs;
my @objs;
for my $obj (@ARGV) {
  if(substr($obj, -2) eq ".a") {
    push @libs, $obj;
  } else {
    push @objs, $obj;
  }
}

# exec into the compiler
my @cmd = (
    $ENV{cc}
  , split(/ /, $ENV{CFLAGS})
  , (map { "-I$_" } split(/ /, $ENV{includes}))
  , "-o", $ENV{bm_target0}
  , "-Wl,--start-group"
  , @objs
  , @libs
  , "-Wl,--end-group"
  , split(/ /, $ENV{LFLAGS0} || "")
  , split(/ /, $ENV{LFLAGS1} || "")
);

my $s = join(" ", @cmd) . "\n";
POSIX::write(1001, $s, length($s));
exec { $cmd[0] } @cmd

__DATA__

envs : {
  cc : {
    lookup : {
      pattern : bin/cc+(.@)
      namespace : base-devel
    }
  }

  includes : {
    sequence : [
      select : [
        path : {
          pattern : //module/include
        }
        traverse : {
          direction : down
          min-distance : 1
          max-distance : 1
        }
      ]
      property : relpath
    ]
  }
}

args : [
  sequence : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 2
        min-distance : 2
      }
    ]
    property : relpath
  ]
]
