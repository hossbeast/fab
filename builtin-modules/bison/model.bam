# tab.c files from parser y files
rule **/(*).y -> [*] $^D/$1.tab.[ch] : ./bison.bam

# tokens.c / tokens.h files from tab.c / tab.h files
rule **/(*).tab.[ch] [*] -> [*] $^D/$1.tokens.[ch] : ./tokens.bam
