use cc
use library/static
use executable

# global includes
bind fab/include             => [*] //module/include

# libraries
bind fab/libxlinux/include   => [*] //module/include
bind bam-build/libxlinux     => [*] //artifacts

bind fab/libcommon/include   => [*] //module/include
bind bam-build/libcommon     => [*] //artifacts

bind fab/libdescriptor/include => [*] //module/include
bind bam-build/libdescriptor => [*] //artifacts

bind fab/libvalyria/include  => [*] //module/include
bind bam-build/libvalyria    => [*] //artifacts

bind fab/libnarrator/include => [*] //module/include
bind bam-build/libnarrator   => [*] //artifacts

bind fab/libbacon/include    => [*] //module/include
bind bam-build/libbacon      => [*] //artifacts

bind fab/liblorien/include   => [*] //module/include
bind bam-build/liblorien     => [*] //artifacts

bind fab/libmoria/include    => [*] //module/include
bind bam-build/libmoria      => [*] //artifacts

bind fab/libyyutil/include   => [*] //module/include
bind bam-build/libyyutil     => [*] //artifacts

bind fab/libbam/include                   => [*] //module/include
bind bam-build/libbam                     => [*] //artifacts
bind bam-build/libbam/$CONFIG_VARIANT     => [*] //module/include
