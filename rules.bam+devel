use cc
use library/static
use executable

# global includes
bind bam/include             => [*] //module/include

# libraries
bind bam/libxlinux/include   => [*] //module/include
bind bam-build/libxlinux     => [*] //artifacts

bind bam/libcommon/include   => [*] //module/include
bind bam-build/libcommon     => [*] //artifacts

bind bam/libdescriptor/include => [*] //module/include
bind bam-build/libdescriptor => [*] //artifacts

bind bam/libvalyria/include  => [*] //module/include
bind bam-build/libvalyria    => [*] //artifacts

bind bam/libnarrator/include => [*] //module/include
bind bam-build/libnarrator   => [*] //artifacts

bind bam/libbacon/include    => [*] //module/include
bind bam-build/libbacon      => [*] //artifacts

bind bam/liblorien/include   => [*] //module/include
bind bam-build/liblorien     => [*] //artifacts

bind bam/libmoria/include    => [*] //module/include
bind bam-build/libmoria      => [*] //artifacts

bind bam/libyyutil/include   => [*] //module/include
bind bam-build/libyyutil     => [*] //artifacts

bind bam/libbam/include                   => [*] //module/include
bind bam-build/libbam                     => [*] //artifacts
bind bam-build/libbam/$CONFIG_VARIANT     => [*] //module/include
