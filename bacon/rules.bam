use git
bind bam-build/asan         => //asan-bits
bind executable             => //executable

# includes
rule **+(/) => [*] //module/include

# invoke the compiler to build the executable
rule $^D/**/*.o [*] -> bacon : //executable/cc.bam

# default targets
rule $^D/bacon -> //targets

# dependencies
rule //artifacts/*/$CONFIG_VARIANT/*.a -> bacon

{
  if($CONFIG_DEVEL)

  rule //asan-bits/devel/asan.o -> bacon
}
