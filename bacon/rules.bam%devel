use git
bind bam-build/asan => //asan-bits

# includes
rule **+(/) => [*] //module/include

# rename
rule bacon.exe -> bacon+(@) : coreutils/symlink.bam%devel+(.)

# default targets
rule $^D/bacon+(@) -> //targets

# dependencies
rule $^D/**/*.o [*] -> bacon.exe
rule //artifacts/*/$CONFIG_VARIANT/*.a -> bacon.exe
{
  if($CONFIG_DEVEL)
  rule //asan-bits/devel/asan.o -> bacon.exe
}
