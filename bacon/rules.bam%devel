use git

bind bam-build/asan                     => //asan-bits
bind "builtin-modules%devel"/executable => //executable

# includes
rule **+(/) => [*] //module/include

# invoke the compiler to build the executable
rule $^D/**/*.o [*] -> bacon.exe # : //executable/cc.bam%devel

# default targets
rule $^D/bacon -> //targets

# dependencies
rule //artifacts/*/$CONFIG_VARIANT/*.a -> bacon.exe

{
  if($CONFIG_DEVEL)

  rule //asan-bits/devel/asan.o -> bacon.exe
}
