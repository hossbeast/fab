use cc           # this module contains C sources
use executable   # this module builds an executable
use git

# declare variants
variant {debug,devel,final,trace}

# make common objects available for #include and linking
import fab/include
import fab/asan
import lib{common,xlinux,narrator,valyria,yyutil,bacon}

variant {debug,devel} : [
  rule bacon.? <- asan/asan.$?.o
]

# invoke the compiler to build the executable
rule **/*.?.o [*] -> bacon.$? : executable/cc.bam

# library dependencies
variant {debug,devel,final,trace} : [
  rule //module/imports/*/lib*.?.a -> bacon.$?
]

rule bacon.? -> //module/targets
