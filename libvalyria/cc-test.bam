use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

die "cc not found in environment" unless $ENV{cc};

my @rpath;
for my $req (split(/ /, $ENV{imports}))
{
  push @rpath, '-Wl,-rpath,$ORIGIN' . "/../$req";
}

# exec into the compiler
my @cmd = (
    $ENV{cc}
  , split(/ /, $ENV{cflags})
  , "-o", $ENV{bm_target}
  , @rpath
  # object files
  , split(/ /, $ENV{objects})
  , '-lasan', '-lubsan', '-lbacktrace'
  # library files
  , "-Wl,--start-group"
  , split(/ /, $ENV{libraries})
  , "-Wl,--end-group"
);

exec { $cmd[0] } @cmd

__DATA__

envs : {
  cc : {
    path-search : cc
  }
  objects : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 1
        min-distance : 1
        extension : o
      }
    ]
    property : relpath
  ]

  libraries : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 1
        min-distance : 1
        extension : a
      }
    ]
    property : relpath
  ]

  imports : [
    select : [
      module
      traverse : {
        direction : down
        graph : imports
      }
    ]
    property : relpath
  ]
}
