use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;

die "ar not found in environment" unless $ENV{ar};

my @cmd = (
    $ENV{ar}
  , "rcs"
  , $ENV{bm_target0}
  # object files in this module
  , split(/ /, $ENV{objects})
);

print(join(" ", @cmd), "\n");

# no combination of arguments will cause ar to actually recreate the entire archive
unlink($ENV{bm_target0});

exec { $cmd[0] } @cmd

__DATA__

envs : {
  ar : {
    lookup : {
      pattern : bin/ar+(.)
      namespace : binutils
    }
  }

  # object files for the library
  objects : {
    sequence : [
      select : [
        target
        traverse : {
          direction : down
          graph : depends
          max-distance : 2
          min-distance : 2
        }
      ]
      property : relpath
    ]
  }
}
