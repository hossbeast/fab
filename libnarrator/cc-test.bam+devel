use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

die "cc not found in environment" unless $ENV{CC};

# exec into the compiler
my @cmd = (
    $ENV{CC}
  , split(/ /, $ENV{CFLAGS})
  , "-o", $ENV{bm_target0}
  # object files
  , split(/ /, $ENV{objects})
  # library files
  , "-Wl,--start-group"
  , split(/ /, $ENV{libraries})
  , "-Wl,--end-group"
);

print(join(" ", @cmd) . "\n");
exec { $cmd[0] } @cmd

__DATA__

envs : {
  CC : {
    path-search : cc
  }

  objects : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 2
        min-distance : 2
        extension : o
      }
    ]
    property : relpath
  ]

  libraries : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        extension : a
      }
    ]
    property : relpath
  ]
}
