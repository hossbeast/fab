use cc               # this module contains c sources
use library/shared  # this module builds a shared library
use library/static

import fab/include
import libcommon
import libxlinux

import fab/unit as fabtest

# variants for the module
variant {debug,devel,final,trace}

# pull in object files in the module, except those under test
rule *~test/**/*.?.o -> libnarrator.$?.{so,a}

# default build targets
rule libnarrator.?.a -> //module/targets

# library dependencies
rule //module/imports/*/lib*.?.a -> libnarrator.$?.a

#
# test
#

# build individual test executables
rule test/test_(*).?.o -> $^D/test_$1.$? : ./cc-test.bam
rule test/test_(*).? <- fabtest/unit.$?.o
rule test/test_(*).? <- libnarrator.$?.a

# target to run each test
rule test/test_(*).? -> //module/tests/test-$1.$? : ./test.bam

# add tests to global tests
rule //module/tests/* -> //tests

rule //tests -> //module/targets
