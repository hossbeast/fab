# top-level source directories only
rule $^A/.+(/) => [*] //module/include
rule $^A/*+(/) => [*] //module/include

# pull in object files in the module, except those under integ/example
rule $^D/*~test~example/**/*.o -> libnarrator.a

# default build targets
rule $^D/libnarrator.a -> //targets
