#!/usr/bin/env bash
#
# SPDX-License-Identifier: GPL-3.0
# Copyright (c) 2012-2023 Todd Freed <todd.freed@gmail.com>
#

INVOCATION="$0 $@"
ROOT_PATH=$(dirname $(realpath $0))
SRC_PATH=$ROOT_PATH
BUILD_PATH=$(realpath .)
CONFIG_CC=/usr/bin/cc
CONFIG_FINAL=true
CONFIG_VARIANT=final

# install-time directories
INSTALLDIR=/
BINDIR=/usr/bin
RUNDIR=/var/run
SHAREDIR=/usr/share
ETCDIR=/etc

usage() {
  echo "usage: $0 [option].."
  echo
}

if [ $# -ne 0 ]; then
  usage
  exit 1
fi

set -e

echo SRC_PATH   $SRC_PATH
echo BUILD_PATH $BUILD_PATH

define() {
  name=$1
  value=$(eval echo \$${name})
  if [ ! -z "$value" ]; then
    echo $name=$value
  else
    echo "# $name not set"
  fi
}

CONFIG_MAK=$BUILD_PATH/config.mak
rm -f $CONFIG_MAK
exec 1000>&1
exec 1>$CONFIG_MAK
echo "# SPDX-License-Identifier: GPL-3.0"
echo "# Copyright (c) 2012-2023 Todd Freed <todd.freed@gmail.com>"
echo "#"
echo "# generated by $INVOCATION"
echo
define ROOT_PATH
define SRC_PATH
define BUILD_PATH
define CONFIG_CC
define CONFIG_FINAL
define CONFIG_VARIANT
define INSTALLDIR
define BINDIR
define RUNDIR
define SHAREDIR
define ETCDIR

exec 1>&1000
cat $CONFIG_MAK

setup() {
  echo $1
  mkdir -p $BUILD_PATH/$1
  ln -fs $SRC_PATH/$1/makefile $BUILD_PATH/$1/makefile

  # replicate the directory structure
  (cd $SRC_PATH/$1 ; find . -type d) | (cd $BUILD_PATH/$1 ; xargs mkdir -p)
}

# setup the build directory
mkdir -p $BUILD_PATH
ln -fs $SRC_PATH/makefile $BUILD_PATH/
ln -fs $SRC_PATH/makefile.common $BUILD_PATH/

# setup the build directories
for x in libxlinux libcommon asan unit libnarrator libdescriptor libvalyria libxunit libyyutil liblorien libbacon libmoria bacon libbam bam bamd; do
  setup $x
done

# generated files
mkdir -p $BUILD_PATH/libbam/bam

# build generated files
make -C $BUILD_PATH/libxlinux \
 sigtable.c
make -C $BUILD_PATH/libbacon \
 parser/value.lex.c \
 parser/value_list.tab.c \
 parser/value.tab.c \
 parser/value_set.tab.c \
 parser/expr.tab.c
make -C $BUILD_PATH/libbacon \
 parser/value.states.c \
 parser/value_list.tokens.c \
 parser/value.tokens.c \
 parser/value_set.tokens.c \
 parser/expr.tokens.c
make -C $BUILD_PATH/libmoria \
 parser/operations.lex.c \
 parser/operations.tab.c \
 parser/graph.lex.c \
 parser/graph.tab.c
make -C $BUILD_PATH/libmoria \
 parser/operations.states.c \
 parser/operations.tokens.c \
 parser/graph.states.c \
 parser/graph.tokens.c
make -C $BUILD_PATH/bacon \
 git-state.c
make -C $BUILD_PATH/libbam \
 bam/build_slot.desc.h \
 bam/config_tell.desc.h \
 bam/envs_tell.desc.h \
 bam/list.desc.h \
 bam/vars_tell.desc.h
make -C $BUILD_PATH/bam \
 args/args.tab.c \
 args/args.lex.c \
 event_parser/events.tab.c \
 event_parser/events.lex.c \
 git-state.c
make -C $BUILD_PATH/bam \
 args/args.tokens.c \
 args/args.states.c \
 event_parser/events.tokens.c \
 event_parser/events.states.c
make -C $BUILD_PATH/bamd \
 build/build_stats.desc.h \
 buildplan/buildplan_stats.desc.h \
 bpe/stats_bpe.desc.h \
 configset/stats_configset.desc.h \
 filesystem/filesystem_stats.desc.h \
 rcu/rcu_stats.desc.h \
 formula/stats_formula.desc.h \
 fstree/stats_fstree.desc.h \
 client/stats_client.desc.h \
 fsname/fsname_stats.desc.h \
 namespace/namespace_stats.desc.h \
 module/stats_module.desc.h \
 notify/notify_stats.desc.h \
 plugin/stats_plugin.desc.h \
 rule/stats_rule.desc.h \
 rma/stats_rma.desc.h \
 ruleset/stats_ruleset.desc.h \
 fsent_dir/stats_fsent_dir.desc.h \
 system/system_stats.desc.h \
 varset/stats_varset.desc.h \
 vertex/stats_vertex.desc.h
make -C $BUILD_PATH/bamd \
 configset_parser/configset.tab.c \
 mak_parser/mak.tab.c \
 formula_parser/formula.tab.c \
 pattern_parser/attachment_pattern.tab.c \
 pattern_parser/generate_pattern.tab.c \
 pattern_parser/include_pattern.tab.c \
 pattern_parser/lookup_pattern.tab.c \
 pattern_parser/match_pattern.tab.c \
 pattern_parser/path_pattern.tab.c \
 pattern_parser/search_pattern.tab.c \
 request_parser/request.tab.c \
 ruleset_parser/ruleset.tab.c \
 selector_parser/selector.tab.c \
 git-state.c
make -C $BUILD_PATH/bamd \
 configset_parser/configset.lex.c \
 mak_parser/mak.lex.c \
 formula_parser/formula.lex.c \
 pattern_parser/pattern.lex.c \
 request_parser/request.lex.c \
 ruleset_parser/ruleset.lex.c \
 selector_parser/selector.lex.c
make -C $BUILD_PATH/bamd \
 configset_parser/configset.tokens.c \
 mak_parser/mak.tokens.c \
 formula_parser/formula.tokens.c \
 pattern_parser/attachment_pattern.tokens.c \
 pattern_parser/generate_pattern.tokens.c \
 pattern_parser/include_pattern.tokens.c \
 pattern_parser/lookup_pattern.tokens.c \
 pattern_parser/match_pattern.tokens.c \
 pattern_parser/path_pattern.tokens.c \
 pattern_parser/search_pattern.tokens.c \
 request_parser/request.tokens.c \
 ruleset_parser/ruleset.tokens.c \
 selector_parser/selector.tokens.c
make -C $BUILD_PATH/bamd \
 configset_parser/configset.states.c \
 mak_parser/mak.states.c \
 formula_parser/formula.states.c \
 pattern_parser/pattern.states.c \
 request_parser/request.states.c \
 ruleset_parser/ruleset.states.c \
 selector_parser/selector.states.c
