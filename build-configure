INVOCATION="$0 $@"
ROOT_PATH=$(dirname $(realpath $0))
SRC_PATH=$ROOT_PATH
BUILD_PATH=$(realpath .)
CONFIG_PROBES=y

usage() {
  echo "usage: $0 [option].."
  echo
}

if [ $# -ne 0 ]; then
  usage
  exit 1
fi

set -e

echo SRC_PATH   $SRC_PATH
echo BUILD_PATH $BUILD_PATH

define() {
  name=$1
  value=$(eval echo \$${name})
  if [ ! -z "$value" ]; then
    echo $name=$value
  else
    echo "# $name not set"
  fi
}

CONFIG_MAK=$BUILD_PATH/config.mak
rm -f $CONFIG_MAK
exec 1000>&1
exec 1>$CONFIG_MAK
echo "# SPDX-License-Identifier: GPL-3.0"
echo "# Copyright (c) 2012-2023 Todd Freed <todd.freed@gmail.com>"
echo "#"
echo "# generated by $INVOCATION"
echo
define ROOT_PATH
define SRC_PATH
define BUILD_PATH
define CONFIG_PROBES

exec 1>&1000
cat $CONFIG_MAK

setup() {
  echo $1/$2
  mkdir -p $BUILD_PATH/$1/$2

  ln -fs module.bam $BUILD_PATH/$1/$2/module.bam+devel

  rm -f $BUILD_PATH/$1/$2/module.bam
  cat 1>$BUILD_PATH/$1/$2/module.bam <<HERE
/* SPDX-License-Identifier: GPL-3.0 */
/* Copyright (c) 2012-2023 Todd Freed <todd.freed@gmail.com> */

anchor $SRC_PATH/$1
varfiles var.bam.$2
rulesfiles rules.bam.$2
HERE
}

# setup the build directory
ln -fs $SRC_PATH/config.bam       $BUILD_PATH/
ln -fs $SRC_PATH/config.bam+devel $BUILD_PATH/

# setup the build directories
for x in libxlinux libcommon asan unit libnarrator libdescriptor libvalyria libxunit libyyutil liblorien libbacon libmoria bacon libbam bam bamd; do
  for v in debug devel final trace; do
    setup $x $v
  done
done
