use git
use flex
use bison

bind fab-build/asan               => //fabasan
bind modules/executable           => //executable

# includes
rule **+(/) => [*] //module/include

# default targets
rule { search : module } fab -> //targets

rule { search : module } **/*.o [*] -> fab : //executable/cc.bam

# dependencies
rule //artifacts/*/$CONFIG_VARIANT/*.a -> fab
{
  if($CONFIG_DEVEL)

  rule //fabasan/devel/asan.o -> fab
}
