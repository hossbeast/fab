use cc          # this module contains C sources
use flex
use bison
use executable  # this module builds an executable
use xunit
use git

# make common objects available for #include and linking
import fab/include
import fab/asan
import lib{common,descriptor,xlinux,valyria,bacon,narrator,fab,lorien,moria,yyutil,xunit}

variant {debug,devel,final,trace}

# invoke the compiler to build the executable
rule **~test/(*~xunit-)*.?.o [*] -> fabd.$? : executable/cc.bam

# build the binary by default
rule fabd.? -> //module/targets

# run all the tests by default
rule //tests/* -> //module/targets

variant devel : [
  rule fabd.? <- asan/asan.$?.o
]

# library dependencies
rule //module/imports/*~libxunit/lib*.?.a -> fabd.$?

var : {
  lflags : [ -lrt -lpthread -lbacktrace ]
}

#
# tests
#

variant devel : [
  # all the code into the blob
  rule **~test/(*~main).?.o -> test/blob.?.a : ./cc-blob.bam

  # including test utilities
  rule test/node_operations_test.?.o -> test/blob.?.a
  rule test/strht.?.o -> test/blob.?.a

  # including library dependencies
  rule //module/imports/*/lib*.?.a -> test/blob.?.a

  # add blob to test binaries
  rule **/test/test_*.?.xunit <- test/blob.?.a
  rule **/test/test_*.?.xunit <- asan/asan.$?.o

  # target to run each test
#  rule **/test/test_(*).?.xunit -> //module/tests/test-$1.$? : ./test.bam

#  rule //module/tests/* -> //tests
]
