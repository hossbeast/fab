use cc          # this module contains C sources
use flex
use bison
use executable  # this module builds an executable
use xunit
use git

# make common objects available for #include and linking
import fab/include
import fab/asan
import lib{common,descriptor,xlinux,valyria,value,narrator,fab,lorien,moria,yyutil,xunit}

variant pic.{debug,devel,final,trace}

# invoke the compiler to build the executable
rule **~test/*.?.o [*] -> fabd.$? : executable/cc.bam

rule fabd.? -> //module/targets

variant pic.devel : [
  rule fabd.? <- asan/asan.$?.o
]

# library dependencies
rule //module/imports/*~libxunit/lib*.?.a -> fabd.$?

# remove this somehow - libxunit should be needed only for the test blob
variant pic.devel : [
  rule //module/imports/libxunit/lib*.?.a -> fabd.$?
]

var : {
  lflags : [ -lrt -lpthread ]
}

#
# tests
#

variant pic.devel : [
  # all the code into the blob
  rule **~test/(*~main).?.o -> test/blob.?.a : ./cc-blob.bam

  # including test utilities
  rule test/node_operations_test.?.o -> test/blob.?.a

  # including library dependencies
  rule //module/imports/*/lib*.?.a -> test/blob.?.a

  # add blob to test binaries
  rule **/test/(test_*.?.xunit) <- test/blob.?.a
  rule tests.xunit <- test/blob.?.a
]
