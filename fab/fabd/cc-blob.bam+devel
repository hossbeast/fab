use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;

die "ar not found in environment" unless $ENV{ar};

my @cmd = (
    $ENV{ar}
  , "rcs"
  , $ENV{bm_target}
  # object files in this module
  , split(/ /, $ENV{objects})
);

print(join(" ", @cmd), "\n");

exec { $cmd[0] } @cmd

__DATA__

envs : {
  ar : {
    path-search : ar
  }

  # object files for the library
  objects : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 1
        min-distance : 1
        extension : o
      }
    ]
    property : relpath
  ]
}
