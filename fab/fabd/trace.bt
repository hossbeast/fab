#!/usr/bin/env bpftrace

#include <string.h>


struct moria_vertex {
  char _pad0[40];
  const char  *              label;
  uint16_t                   label_len;
  char _pad1[2];
  uint32_t                   attrs;
};

usdt:*:fabd:vertex_attrs_set
{
  $vertex = (struct moria_vertex *)arg0;
  $before = str(arg1);
  $after = str(arg2);
  $type = $vertex->attrs & 0x00fffff0;

$VERTEX_DIR                    = (uint64)0x830010;
$VERTEX_MODULE_DIR             = (uint64)0x830110;
$VERTEX_FILE                   = (uint64)0x810010;
$VERTEX_SYMLINK                = (uint64)0x820010;
$VERTEX_MODULE_FILE            = (uint64)0x810110;
$VERTEX_RULES_FILE             = (uint64)0x810510;
$VERTEX_FORMULA_FILE           = (uint64)0x810610;
$VERTEX_VAR_FILE               = (uint64)0x810710;
$VERTEX_CONFIG_FILE            = (uint64)0x810810;
$VERTEX_RULE                   = (uint64)0x420;
$VERTEX_MODULE                 = (uint64)0x120;
$VERTEX_FORMULA                = (uint64)0x620;
$VERTEX_VAR                    = (uint64)0x720;
$VERTEX_CONFIG                 = (uint64)0x820;
$VERTEX_RULES                  = (uint64)0x520;
$VERTEX_RMA                    = (uint64)0x30;
$VERTEX_BPE                    = (uint64)0x800040;
$VERTEX_SHADOW_DIR             = (uint64)0x831010;
$VERTEX_SHADOW_FILE            = (uint64)0x811010;
$VERTEX_SHADOW_LINK            = (uint64)0x821010;
$VERTEX_SHADOW_MODULE          = (uint64)0x832010;
$VERTEX_SHADOW_RULE            = (uint64)0x833010;
$VERTEX_CONTEXT_MODULE         = (uint64)0x834010;

  if($type == $VERTEX_RMA) {
      return;
  }

  printf("vertex %p\n", $vertex);
  printf(" label %s\n", str($vertex->label, $vertex->label_len));
  printf(" attrs %x\n", $vertex->attrs);
  printf(" before %s\n", $before);
  printf(" after %s\n", $after);
  printf("%s\n", ustack());
}
