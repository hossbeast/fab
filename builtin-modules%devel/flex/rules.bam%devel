# lex.c files from lexer l files
#  each invocation yields all files on the right-hand-side
rule **/(*).l -> [*] $^D/$1.lex.{c,h} : ./flex.bam%devel

# states.c / states.h files from .lex.h files
rule **/(*).lex.h -> [*] $^D/$1.states.{c,h} : ./states.bam%devel
