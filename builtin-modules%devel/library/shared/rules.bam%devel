# write the linker script
rule *.lnk -- : linker-script.bam%devel

# propagate invalidation from the so to the linker script
rule (*).so -> $^D/$1.so.lnk

# dynamically linked shared objects
rule (*).so.lnk -> $^D/$1.so : cc-so.bam%devel
