use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;
use POSIX;

die "ar not found" unless $ENV{ar};

my @arflags;
push @arflags, split(/ /, $ENV{arflags}) if $ENV{arflags};

#
# no combination of arguments will cause ar to actually recreate the entire archive
# therefore it is necessary to actually delete and recreate the file, in case symbols
# have been removed
#
# in addition, even if the file does not exist, ar will first create a tempfile, write
# to it, and finally rename the completed file over the target file. this creates an
# unnecessary, subsequent inotify event, after the target file is modified, namely the
# delete event of that temp file
#
# if using fstree with invalidation : notify, this spurious delete event can cause
# extra pointless reconciliation events
#
# so to work around these issues, ask ar to do its work in /tmp and, when its done
# rewrite the target file is one clean operation
#

my $temp = "/tmp/" . $ENV{bm_bamd_id} . '-' . $ENV{target_id};

my @cmd = (
    $ENV{ar}
  , @arflags
  , "rcs"
  , $temp
  # object files in this module
  , grep { substr($_, -2) eq ".o" } split(/ /, $ENV{objects})
);

my $s = join(" ", @cmd) . "\n";
POSIX::write(1001, $s, length($s));

system(@cmd);

if(!unlink($ENV{target}) && !$!{ENOENT}) {
  die $!;
}
system("mv $temp $ENV{target}");

__DATA__

envs : {
  target : {
    sequence : [
      select : [
        target
      ]
      property : abspath
    ]
  }
  target_id : {
    sequence : [
      select : [
        target
      ]
      property : id
    ]
  }

  ar : {
    lookup : {
      pattern : bin/ar+(.@)
      namespace : binutils
    }
  }

  # object files for the library
  objects : {
    sequence : [
      select : [
        target
        traverse : {
          direction : down
          graph : depends
          max-distance : 2
          min-distance : 2
        }
      ]
      property : abspath
    ]
  }

  includes : {
    sequence : [
      # include directories matched by the include rule
      select : [
        path : {
          pattern : //module/include
        }
        traverse : {
          direction : down
          min-distance : 1
          max-distance : 1
        }
      ]
      property : abspath
    ]
  }
}
