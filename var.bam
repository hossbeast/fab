bisonflags   : "--warnings=error"
cflags       : {
  -g -m64 -Wall -Werror -Wno-format-truncation -D_GNU_SOURCE -fno-builtin-log -Wmissing-prototypes "-fdiagnostics-color=always" -Wno-misleading-indentation -Wno-trigraphs
  -Wno-dangling-pointer
  "-DFABIPCDIR=/var/run/fab"
  -fPIC
  -include/home/todd/fab/include/tracef.h
  -include/home/todd/fab/include/hexdump.h
  -include/home/todd/fab/include/backtracef.h
}
cflags.debug : {
  -O0 -ggdb3 -DCONFIG_DEBUG
}
cflags.devel : {
  -O0 -ggdb3 -DCONFIG_DEVEL -Wno-frame-address -DFAULT_INJECTION "-fsanitize=address,undefined" -fno-omit-frame-pointer
}
cflags.trace : {
  -O3 -ggdb3 -DCONFIG_TRACE -Wno-frame-address -fno-omit-frame-pointer -Wno-array-bounds
}
cflags.final : {
  -O3 -Wno-array-bounds # -Warray-bounds is NOT COMPATIBLE with containerof
}
lflags.devel : [
  -lasan -lubsan -lbacktrace
]
