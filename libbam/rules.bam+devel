use descriptor

bind descriptor => //descriptor

rule **+(/) => [*] //module/include

# pull in object files in the module, except those under integ
rule { search : module } **~test/*.o -> libbam.a

# default build targets
rule libbam.a -> //targets

# library dependencies
rule //artifacts/*/$CONFIG_VARIANT/*.a -> libbam.a

# descriptor .c and .h files are generated
rule { search : anchor } build_slot/build_slot.h            -> [*] bam/build_slot.desc.[ch] : //descriptor/descriptor.bam+devel
rule { search : anchor } metadata/metadata.h                -> [*] bam/metadata.desc.[ch] : //descriptor/descriptor.bam+devel
rule { search : anchor } stats/stats.h                      -> [*] bam/stats.desc.[ch] : //descriptor/descriptor.bam+devel
rule { search : anchor } list/list.h                        -> [*] bam/list.desc.[ch] : //descriptor/descriptor.bam+devel
rule { search : anchor } describe/describe.h                -> [*] bam/describe.desc.[ch] : //descriptor/descriptor.bam+devel
rule { search : anchor } config_describe/config_describe.h  -> [*] bam/config_describe.desc.[ch] : //descriptor/descriptor.bam+devel
rule { search : anchor } rule_info/rule_info.h              -> [*] bam/rule_info.desc.[ch] : //descriptor/descriptor.bam+devel
rule { search : anchor } rules_describe/rules_describe.h    -> [*] bam/rules_describe.desc.[ch] : //descriptor/descriptor.bam+devel
rule { search : anchor } vars_describe/vars_describe.h      -> [*] bam/vars_describe.desc.[ch] : //descriptor/descriptor.bam+devel
