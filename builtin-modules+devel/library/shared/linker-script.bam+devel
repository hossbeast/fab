use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

open(my $wfh, ">", "$ENV{bm_target}") or die "open($ENV{bm_target}) : $!";

print $wfh ("{ global: \n");

for my $f (split(/ /, $ENV{sources}))
{
  open(my $rfh, "<", $f) or die "open($f) : $!";
  while(<$rfh>)
  {
    if(/API(?:DATA)? +([a-zA-Z_][a-zA-Z0-9_]*)/)
    {
      print $wfh ("$1;\n")
    }
  }
}

print $wfh ("local: *; };");
print $wfh ("\n");

__DATA__

envs : {
  sources : [
    select : [
      target              # the linker script
      traverse : {        # up to the so
        direction : up
        graph : depends
        min-distance : 1
        max-distance : 1
      }
      traverse : {        # down to the primary files
        direction : down
        graph : depends
        min-distance : 2
        max-distance : 2
        extension : c
      }
    ]
    property : relpath
  ]
}
