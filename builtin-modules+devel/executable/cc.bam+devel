use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;
use Data::Dumper;
use POSIX;

die "CC not found" unless $ENV{CC};

# exec into the compiler
my @cmd = (
    $ENV{CC}
  , split(/ /, $ENV{CFLAGS})
  , (map { "-I$_" } split(/ /, $ENV{includes}))
  , "-o", $ENV{bm_target0}
  , "-Wl,--start-group"
  , @ARGV
  , "-Wl,--end-group"
  , split(/ /, $ENV{LFLAGS0} || "")
  , split(/ /, $ENV{LFLAGS1} || "")
);

print(join(" ", @cmd));

exec { $cmd[0] } @cmd

__DATA__

envs : {
  CC : {
    path-search : cc
  }

  includes : [
    select : [
      lookup : {
        path : //module/include
      }
      traverse : {
        direction : down
        min-distance : 1
        max-distance : 1
      }
    ]
    property : relpath
  ]
}

args : [
  sequence : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 2
        min-distance : 2
      }
    ]
    property : relpath
  ]
]
