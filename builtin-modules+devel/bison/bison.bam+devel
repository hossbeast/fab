use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

die "bison not found" unless $ENV{bison};

my $cfile = substr($ENV{bm_target0}, -2) eq ".c" ? $ENV{bm_target0} : $ENV{bm_target1};

my @cmd = (
    $ENV{bison}
  , "-o", $cfile
  , "-d"
  , $ENV{bm_source}
);

exec { $cmd[0] } @cmd;

__DATA__

envs : {
  bison : {
    path-search : bison
  }
}
