use cc             # this module contains c sources
use library/static

import libxlinux
import fab/include

# variants for the module
variant pic.{debug,devel,final,trace}

# build the archive
rule libcommon.?.a -> //module/targets
rule */*.?.o -> libcommon.$?.a

# direct library dependencies
rule //module/imports/*/lib*.?.a -> libcommon.$?.a

var : {
  cflags.pic : [ -fPIC ]
}
