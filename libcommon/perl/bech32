use strict;
use warnings;

use File::Basename;
use Cwd;
use Data::Dumper;

our $dir;
BEGIN { $dir = dirname(Cwd::realpath($0)) }
BEGIN { push @INC, $dir };
use bech32;

my @data;
my $in;
@data = qw|
 97 95 01 3c 7e f6 4b 51 07 a7 f7 7d
 a7 d2 cf 23 31 54 41 31 90 62 94 fd
 b8 2d cd ec 87 f2 75 2b a6 9f cc dd
 02 d5
|;
@data = qw|01 02 03 04 05|;
$in = pack("C*", map { hex } @data);

my $out = bech32_encode("foo", $in);

print("in : ", map { sprintf("%02x", $_) } unpack("C*", $in));
print("\n");
print("out: $out\n");
