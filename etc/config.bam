# file invalidation
filesystems : {
  / : {
    invalidate : notify
  }
}

# heuristic based on detected cpus
build : {
  concurrency : 0
}

# formula execution $PATH
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}

walker : {
  special : {
    var.bam
    config.bam
    rules.bam
  }

  # use builtin modules
  include : {
    /usr/share/fab/modules
  }

  # except skip this stuff
  exclude : {
    .git
  }
}
