# file invalidation
filesystem : {
  special : {
    var.bam
    config.bam
    rules.bam
  }

  exclude : {
    .git
  }

  fstrees : {
    / : {
      invalidation : notify
      mkdir : false
      index : false
    }

    /usr/share/bam/modules : {
      invalidation : stat
      mkdir : false
      index : true
      mount : true
    }

    /usr/share/bam/plugins : {
      invalidation : stat
      mkdir : false
      index : true
      mount : true
    }
  }
}

# heuristic based on detected cpus
build : {
  concurrency : 0
}

# formula execution $PATH
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}

timeout : {
  interval : 600  # exit after 10 minutes of inactivity
}
