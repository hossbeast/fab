bind fab-build/asan => [*] //artifacts
bind fab-build/unit => [*] //artifacts

bind fab/unit => [*] //module/include

# single-test executables
rule { search : module } **/test/(test_*).o -> $^D/$1.unit : ./cc-test.bam
rule { search : module } search //artifacts/*/$CONFIG_VARIANT/*.{a,o} [*] -> [*] search **/test/test_*.unit 

# single-test targets
rule { search : module } **/test/(test_*).unit -> //$1 : ./run.bam
