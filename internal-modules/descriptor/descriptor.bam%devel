my $sfd = POSIX::open("/tmp/$$", O_WRONLY | O_CREAT | O_APPEND);
sub say {
  my $s = shift;
  my ($package, $filename, $line) = caller();
  my $msg = sprintf("[%10u] line %4u : ", $$, $line);
  $msg .= " " . $s if $s;
  $msg .= "\n";
  POSIX::write($sfd, $msg, length($msg));
}
