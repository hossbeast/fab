#include "descriptor.h"
#include "$desc.descriptor.h"
#include "macros.h"

END

while(my($name, $def) = each %structs)
{
  my $fields = $$def{fields};

  print FH <<"END";
struct descriptor_type descriptor_${name} = {
    id : DESCRIPTOR_ID_${name}
  , name : "$name"
  , name_len : @{[length($name)]}
  , members_len : @{[scalar(@$fields)]}
  , members : (descriptor_field*[]) {
END

  my $comma = '  ';
  for my $field (@$fields)
  {
    printf FH <<"END";
    $comma&descriptor_${name}_$$field{name}
END
    $comma = ", ";
  }

print FH <<"END";
  }
};

END
}

while(my($name, $def) = each %structs)
{
  for my $field (@{$$def{fields}})
  {
    my $id = sprintf("0x%08x", unpack("N", Digest::MD5::md5($name . $$field{name})));

    my $codestring = $codes{$$field{code}};
    print FH <<"END";
struct descriptor_field descriptor_${name}_$$field{name} = {
    name : "$$field{name}"
  , name_len : @{[length($$field{name})]}
  , code : $codestring
  , offset : $$field{offset}
END

    if($$field{code} == 1 || $$field{code} == 2)  # int
    {
      print FH "  , size : $$field{size}\n";
    }
    if($$field{code} == 3)  # string
    {
      print FH "  , len_offset : $$field{len_field}{offset} /* $$field{len_field}{name} */\n";
    }
    elsif($$field{code} == 4)  # list
    {
      print FH "  , size_offset : $$field{size_field}{offset} /* $$field{size_field}{name} */\n";
      print FH "  , len_offset : $$field{len_field}{offset} /* $$field{len_field}{name} */\n";
    }

    print FH "};\n";
  }
}

close FH;

# generated header file
open FH, ">$descriptor_h_path" or die "open($descriptor_h_path) : $!";
print FH <<"END";
/* A desc definition file generated by bam. bam is free software released under the
   GNU General Public License.

   As a special exception, desc definition files generated by bam (including this
   desc definition file) are excluded from the license covering bam itself, even if
   substantial portions of the bam source code are copied verbatim into the desc
   definition file. You may create a larger work that contains part or all of the build
   script and distribute that work under terms of your choice. */

#pragma once

#include "descriptor.h"

END

while(my($name, $def) = each %structs)
{
  my $id = sprintf("0x%08x", unpack("N", Digest::MD5::md5($name)));

  print FH <<"END";
#define DESCRIPTOR_ID_${name} $id
extern struct descriptor_type descriptor_${name};
END

  for my $field (@{$$def{fields}})
  {
    print FH <<"END";
extern struct descriptor_field descriptor_${name}_$$field{name};
END
  }
}

close FH;

