my $DESCRIPTOR_INT = 1;
my $DESCRIPTOR_UINT = 2;
my $DESCRIPTOR_STRING = 3;
my $DESCRIPTOR_LIST = 4;
my %codes = (
    $DESCRIPTOR_INT => "DESCRIPTOR_INT"
  , $DESCRIPTOR_UINT => "DESCRIPTOR_UINT"
  , $DESCRIPTOR_STRING => "DESCRIPTOR_STRING"
  , $DESCRIPTOR_LIST => "DESCRIPTOR_LIST"
);

my $desc_o_path = $ENV{bm_source0};
my $descriptor_c_path; # target
my $descriptor_h_path; # target
if(substr($ENV{bm_target0}, -2) eq ".c") {
  $descriptor_c_path = $ENV{bm_target0};
  $descriptor_h_path = $ENV{bm_target1};
} else {
  $descriptor_c_path = $ENV{bm_target1};
  $descriptor_h_path = $ENV{bm_target0};
}
my ($desc, $directories, undef) = fileparse($desc_o_path, ".h");
$desc = substr($desc, 0, -7);

# sigchld handler
my %status_by_pid;
$SIG{CHLD} = sub {
  local ($!, $?);
  while((my $pid = waitpid(-1, WNOHANG)) > 0) {
    my $exit = $? >> 8;
    my $sig = $? & 127;
    $status_by_pid{$pid} = $?;

    # affirmative murder
    kill 9, $pid;
  }
};

# unblock sigchld
POSIX::sigprocmask(POSIX::SIG_UNBLOCK, POSIX::SigSet->new(SIGCHLD), POSIX::SigSet->new());

sub pr_set_pdeathsig
{
  my $sig = shift;

  return unless $^O eq 'linux';

  my(undef, undef, undef, undef, $machine) = POSIX::uname();
  my $SYS_prctl = undef;
  $SYS_prctl = 157 if $machine eq "x86_64";
  $SYS_prctl = 172 if $machine =~ /^i[3456]86$/;

  return unless $SYS_prctl;

  my $PR_SET_PDEATHSIG = 1;   # at least it is on my machine

  syscall($SYS_prctl, $PR_SET_PDEATHSIG, $sig) >= 0 or die "prctl failed : $!";
}

sub run
{
  my @cmd = @_;

  my ($out_rd_fd, $out_wr_fd) = POSIX::pipe() or die $!;
  my ($err_rd_fd, $err_wr_fd) = POSIX::pipe() or die $!;
  my $pid = fork();
  if(!$pid)
  {
    POSIX::dup2($out_wr_fd, 1) or die $!;
    POSIX::dup2($err_wr_fd, 2) or die $!;

    for(my $x = 0; $x < 1024; $x++)
    {
      next if $x == 1 || $x == 2;
      POSIX::close($x);
    }

    POSIX::open("/dev/null", O_WRONLY);

    pr_set_pdeathsig(9);  # no zombies

    exec { $cmd[0] } @cmd;
    exit(1);
  }

  # close write-end of the pipes
  POSIX::close($out_wr_fd) or die $!;
  POSIX::close($err_wr_fd) or die $!;

  my $rin = '';
  vec($rin, $out_rd_fd, 1) = 1;
  vec($rin, $err_rd_fd, 1) = 1;

  my $buf = '';
  my $out = '';
  my $out_len = 0;
  my $err = '';
  my $err_len = 0;
  my $text;
  while(1)
  {
    my $n = select(my $rout = $rin, undef, undef, 0.125);
    next unless ($n > 0);

    my $or = 0;
    if(vec($rout, $out_rd_fd, 1) == 1)
    {
      $or = POSIX::read($out_rd_fd, $buf, 0xffff);
      $out_len += $or;
      if($or)
      {
        $text = substr($buf, 0, $or);
        $out .= $text;
      }
    }

    my $er = 0;
    if(vec($rout, $err_rd_fd, 1) == 1)
    {
      $er = POSIX::read($err_rd_fd, $buf, 0xffff);
      $err_len += $er;
      if($er)
      {
        $text = substr($buf, 0, $er);
        POSIX::write(2, $text, length($text));
        $err .= $text;
      }
    }

    #
    # once the child process has exited (which closes its fds), and pipes are drained
    #
    # https://man7.org/linux/man-pages/man7/pipe.7.html
    #  If all file descriptors referring to the write end of a pipe have
    #  been closed, then an attempt to read(2) from the pipe will see
    #  end-of-file (read(2) will return 0).
    #
    last if($or == 0 && $er == 0 && exists $status_by_pid{$pid});
  }

  return $status_by_pid{$pid}, $out, $err;
}

# find descriptor symbols in the object file
my @cmd = ($ENV{nm}, $desc_o_path);
print(join(" ", @cmd) . "\n");
my ($status, $out, $err) = run(@cmd);

my %replicas;
while($out =~ m/descriptor_replica_([_a-zA-Z][_0-9a-zA-Z]+)/gm) {
  print(" - $&\n");
  $replicas{$1} = 1;
}

# load layout of structs with descriptors from the object file
@cmd = ($ENV{pahole}, $desc_o_path);
print(join(" ", @cmd) . "\n");
($status, $out, $err) = run(@cmd);

my %structs;
my $struct = undef;
my $a = $b = 0;
while(1)
{
  my $b = index($out, "\n", $a);
  last if $b == -1;
  my $line = substr($out, $a, $b - $a);

  if($struct) {
    if($line =~ /^[ \t]+((?:8|16|32|64|int|short|long|u|_t|const|char|void|\*| )+)[ \t]+([a-zA-Z][_0-9a-zA-Z]*);[ \t]+\/\*[ \t]+([0-9]+)[ \t]+([0-9]+)/) {
      print("$line $$struct{name} ---- $1 $2 $3 $4 B\n");
      my $code = 0;
      my $type = $1;
      my $name = $2;
      my $offset = int($3);
      my $size = int($4);
      $type =~ s/^ +//g;
      $type =~ s/ +$//g;
      if($type =~ 'int') {
        $code = $DESCRIPTOR_INT;
        if($type =~ 'u') {
          $code = $DESCRIPTOR_UINT;
        }
      } elsif ($type =~ /(const )?+char +\*/) {
        $code = $DESCRIPTOR_STRING;
      } elsif ($type =~ /void +\*/) {
        $code = $DESCRIPTOR_LIST;
      } else {
        print("WTF $type\n");
        die;
      }
      push @{$$struct{fields}}, {
          type => $type
        , code => $code
        , name => $name
        , offset => $offset
        , size => $size
      };
    } elsif($line =~ /^};$/){
      print("$line END $$struct{name} C\n");
      $structs{$$struct{name}} = $struct;
      $struct = undef;
    } else {
      print("$line $$struct{name}  ????\n");
    }
  } elsif($line =~ /^(?:struct|union) ([_a-zA-Z][_0-9a-zA-Z]+) \{/) {
    my $name = $1;
    if(exists $replicas{$name}) {
      $struct = { name => $name };
      print("$line START $$struct{name} A\n");
    }
  }

  $a = $b + 1;
}

# ensure that each descriptor has a layout
for my $name (keys %replicas)
{
  die "type $name not found" unless exists $structs{$name};
}

# match up scalar/aggregate types
while(my($name, $type) = each %structs)
{
  my $fields = $$type{fields};
  for my $field (@$fields)
  {
    if($$field{code} == 3)  # string
    {
      my $x;
      for($x = 0; $x <= $#$fields; $x++)
      {
        last if($$fields[$x]{name} eq "$$field{name}_len");
      }

      die("subfield $$field{name}_len not found") if $x > $#$fields;
      die("subfield $$field{name}_len has wrong type $$fields[$x]{code}") if $$fields[$x]{code} != 2;
      $$field{len_field} = splice(@$fields, $x, 1);
    }
    elsif($$field{code} == 4)  # list
    {
      # list-size field
      my $x;
      for($x = 0; $x <= $#$fields; $x++)
      {
        last if($$fields[$x]{name} eq "$$field{name}_size");
      }

      die("subfield $$field{name}_size not found") if $x > $#$fields;
      die("subfield $$field{name}_size has wrong type $$fields[$x]{code}") if $$fields[$x]{code} != 2;
      $$field{size_field} = splice(@$fields, $x, 1);

      # list-length field
      for($x = 0; $x <= $#$fields; $x++)
      {
        last if($$fields[$x]{name} eq "$$field{name}_len");
      }

      die("subfield $$field{name}_len not found") if $x > $#$fields;
      die("subfield $$field{name}_len has wrong type $$fields[$x]{code}") if $$fields[$x]{code} != 2;
      $$field{len_field} = splice(@$fields, $x, 1);
    }
  }
}

