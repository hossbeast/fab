bind bam/libxunit/include   => [*] //module/include
bind bam-build/libxunit     => [*] //artifacts
bind bam-build/asan         => [*] //artifacts

# per-test executables
rule $^D/**/test/(test_*).o -> $^D/$1.xunit : ./cc-test.bam
rule $^D/**/test/(test_*).xunit -> //$1 : ./run.bam
rule search //artifacts/*/$CONFIG_VARIANT/*.{a,o} [*] -> [*] search **/test/test_*.xunit 
