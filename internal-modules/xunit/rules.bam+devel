bind fab/libxunit/include   => [*] //module/include
bind fab-build/libxunit     => [*] //artifacts
bind fab-build/asan         => [*] //artifacts

# per-test executables
rule { search : module } **/test/(test_*).o -> $^D/$1.xunit : ./cc-test.bam+devel
rule { search : module } **/test/(test_*).xunit -> //$1 : ./run.bam+devel
rule search //artifacts/*/$CONFIG_VARIANT/*.{a,o} [*] -> [*] search **/test/test_*.xunit 

# omnibus test executable
rule { search : module } **/test/test_*.o [*] -> tests.xunit : ./cc-test.bam+devel
rule { search : module } tests.xunit -> //xunit : ./run.bam+devel
rule search //artifacts/*/$CONFIG_VARIANT/*.{a,o} [*] -> [*] search tests.xunit
