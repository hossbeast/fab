variant devel : [
  # per-test executables
  rule **/test/(test_*.?).o -> $^D/$1.xunit : ./cc-test.bam
  rule **/test/(test_*.?.xunit) <- //module/imports/libxunit/libxunit.?.a

  # per-test targets
  rule **/test/(test_*).?.xunit -> //tests/$1 : ./run.bam

  # omnibus test executable
  rule **/test/test_*.?.o [*] -> tests.xunit : ./cc-test.bam
  rule tests.xunit <- //module/imports/libxunit/libxunit.?.a

  # omnibus test target
  rule tests.xunit -> //module/xunit : ./run.bam

  # global xunit target
  rule //module/xunit -> //xunit
]
