use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

die "cc not found" unless $ENV{cc};

my @cmd = (
    $ENV{cc}
  , split(/ /, $ENV{CFLAGS})
  , "-o", $ENV{bm_target0}
  , '-lasan', '-lubsan', '-lbacktrace'
  , "-Wl,--start-group"
  , @ARGV
  , "-Wl,--end-group"
);

print(join(" ", @cmd));
exec { $cmd[0] } @cmd

__DATA__

envs : {
  cc : {
    lookup : {
      pattern : bin/cc+(.@)
      namespace : base-devel
    }
  }
}

args : [
  sequence : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 2
        min-distance : 1
      }
    ]
    property : relpath
  ]
]
