use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use POSIX;

# redirect stdout -> auxout
POSIX::dup2(1001, 1);

# redirect stderr -> auxout
POSIX::dup2(1001, 2);

my @cmd = (
  "./" . $ENV{"bm_source0"}
);

exec { $cmd[0] } @cmd;
