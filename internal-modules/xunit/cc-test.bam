use strict;
use warnings;
$SIG{__WARN__} = sub { die @_ };

use File::Basename;

die "cc not found" unless $ENV{cc};

my @cmd = (
    $ENV{cc}
  , split(/ /, $ENV{cflags})
  , "-o", $ENV{bm_target}
  # object files in this module
  , split(/ /, $ENV{objects})
  , '-lasan', '-lubsan', '-lbacktrace'
  , "-Wl,--start-group"
  , split(/ /, $ENV{'static-libs'})
  , "-Wl,--end-group"
  , split(/ /, $ENV{lflags} || '')
);

print(join(" ", @cmd));

exec { $cmd[0] } @cmd

__DATA__

envs : {
  cc : {
    path-search : cc
  }

  # object files for the library
  objects : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        max-distance : 1
        min-distance : 1
        extension : o
      }
    ]
    property : relpath
  ]

  static-libs : [
    select : [
      target
      traverse : {
        direction : down
        graph : depends
        extension : a
      }
    ]
    property : relpath
  ]
}
