filesystem : {
  fstrees : {
    / : {
      invalidation : stat
      mkdir : false
      index : false
    }
  }

  # except skip this stuff
  exclude : {
    .git
    /home/todd/bam/builtin-modules
    /usr/share/bam/modules
  }

  special : {
    var.bam+devel
    config.bam+devel
    rules.bam+devel
  }
}

# heuristic based on detected cpus
build : {
  concurrency : 16
}

# formula execution $PATH
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}
