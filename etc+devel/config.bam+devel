# file invalidation
filesystems : {
  "/" : {
    invalidate : notify
  }
}

# heuristic based on detected cpus
build : {
  concurrency : 0
}

# formula execution $PATH
formula : {
  path : {
    dirs : {
      /usr/bin
    }
  }
}

walker : {
  # except skip this stuff
  exclude : {
    .git
  }

  special : {
    rules.bam+devel
    config.bam+devel
    var.bam+devel
  }
}
