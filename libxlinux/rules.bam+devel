#rule { graph : relation } **+(/) [*] -> //module/include
#rule { graph : relation id : a } //lib-sources/*+(/) -> //module/include
#rule { graph : relation id : b } //global-include/* -> //module/include

rule { search : anchor } .+(/) => [*] //module/include
rule { search : anchor search : module } *~xlinux+(/) => [*] //module/include

# pull in object files in the module, except those under integ
rule { search : module } *~integ~build/**/*.o -> libxlinux.a

# default build targets
rule { search : module } libxlinux.a -> //targets

# generated signals table
rule -- [*] sigtable/sigtable.{c,h} : ./sigtable.bam+devel
