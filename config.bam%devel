# heuristic based on detected cpus
build : {
  concurrency : 16
}

timeout : {
  interval-sec : 600  # exit after 10 minutes of inactivity
}

notify : {
  interval-msec : 500 # process events after between 1/2 - 1 seconds
}

filesystem : {
  fstrees : {
    / : {
      invalidation : stat
      mkdir : false
      mount : false
    }

    /home/todd/bam : {
      invalidation : notify
      mkdir : false
      mount : true
      namespaces : {
        modules
      }
    }

    /home/todd/bam-build : {
      invalidation : notify
      mkdir : true
      mount : true
      namespaces : {
        modules
      }
    }

    $bm_basedir : {
      invalidation : notify
      mkdir : true
      mount : true
      namespaces : {
        modules
      }
    }

    /home/todd/bam/builtin-plugins%devel : {
      invalidation : stat
      mkdir : false
      mount : true
      namespaces : {
        plugins
      }
    }
  
    /home/todd/bam/builtin-modules%devel : {
      invalidation : stat
      mkdir : false
      mount : true
      namespaces : {
        modules
        formulas
      }
    }
  }

  exclude : {
    /home/todd/bam/builtin-modules
    /home/todd/bam/builtin-plugins
    /usr/share/bam/modules
  }
  special : {
    var.bam.final%devel
    var.bam.debug%devel
    var.bam.trace%devel
    var.bam.devel%devel
    rules.bam.final%devel
    rules.bam.debug%devel
    rules.bam.trace%devel
    rules.bam.devel%devel
  }
}

plugins : {
  [
    {
      file : {
        lookup : {
          pattern : builtin-plugins%devel/autobuild-focus+(.)
          namespace : plugins
        }
      }
    }
    {
      file : {
        lookup : {
          pattern : builtin-plugins%devel/invalidate-primary+(.)
          namespace : plugins
        }
      }
      args : [
        --suffix=h
        --in-module
      ]
    }
  ]
}
