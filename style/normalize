#
# normalize header and footer of all kinds of source files
#
# usage
#  ./style/normalize      # consider all files from cwd down
#  ./style/normalize path path ...
#

use strict;
use warnings;

my $LIM = 1000;   # rewrite at most this many files
my $CNT = 0;

sub usage {
  print STDOUT <<TEXT;
usage : $0              consider all files in $ENV{CWD}, recursive
usage : path path ...   consider only the specified files

TEXT
}

sub bam_bam {
  my $path = shift;
  print("$CNT of $LIM $path\n");

  open FH, "<$path" or die "open($path) : $!";
  my @lines;

  # skip leading spdx / copyright / blank lines
  my $head = 1;
  while(<FH>) {
    if($head) {
      if(/SPDX|Copyright..c..20|^$/) {
        next;
      } else {
        $head = 0;
      }
    }
    push @lines, $_;
  }
  close FH;

  open FH, ">style_normalize_b" or die $!;
  chmod 0644, \*FH;

  # tim trailing blank lines
  while($#lines >= 0) {
    if($lines[$#lines] =~ /^$/) {
      pop @lines;
    } else {
      last;
    }
  }

  # supply proper spdx header
  print FH <<'HEAD';
/* SPDX-License-Identifier: GPL-3.0 */
/* Copyright (c) 2012-2023 Todd Freed <todd.freed@gmail.com> */

HEAD

  # rewrite the file
  for(my $x = 0; $x <= $#lines; $x++) {
    print FH ($lines[$x]);
  }
  close FH;
  qx|mv style_normalize_b $path|;
  system("git diff $path");
}

