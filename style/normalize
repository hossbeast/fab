sub perl_pl {
  my ($path, $interp) = @_;
  print("$CNT of $LIM $path\n");

  open FH, "<$path" or die "open($path) : $!";

  my @lines;

  # skip leading spdx / copyright / comment / shebang / blank lines
  my $state = 0;
  while(<FH>) {
    if($state == 0 && /SPDX|Copyright..c..20/) {
      next;
    } elsif($state == 0 && /^$/) {
      next;
    } elsif($state <= 1 && /^#/) {
      $state = 1;
      next;
    }

    $state = 2;
    push @lines, $_;
  }
  close FH;

  open FH, ">style_normalize_b" or die $!;
  chmod 0755, \*FH;

  # tim trailing blank lines
  while($#lines >= 0) {
    if($lines[$#lines] =~ /^$/) {
      pop @lines;
    } else {
      last;
    }
  }

  # supply proper shebang / spdx header
  print FH <<"HEAD";
#!/usr/bin/env $interp
#
# SPDX-License-Identifier: GPL-3.0
# Copyright (c) 2012-2023 Todd Freed <todd.freed\@gmail.com>
#

HEAD

  # rewrite the file
  for(my $x = 0; $x <= $#lines; $x++) {
    print FH ($lines[$x]);
  }
  close FH;
  qx|mv style_normalize_b $path|;
  system("git diff $path");
}

