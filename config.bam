filesystems : {
  / : {
    invalidate : stat
    mkdirs : false
    indexed : false
  }

  /home/todd/bam : {
    invalidate : notify
    mkdirs : false
    indexed : true
  }

  /home/todd/bam-build : {
    invalidate : notify
    mkdirs : true
    indexed : true
  }
}

walker : {
  exclude : {
    /home/todd/bam/builtin-modules
    /home/todd/bam/"builtin-modules+devel"
  }
  include : {
    /home/todd/bam
    /home/todd/bam-build
  }
  special : {
    var.bam.final
    var.bam.debug
    var.bam.trace
    var.bam.devel

    rules.bam.final
    rules.bam.debug
    rules.bam.trace
    rules.bam.devel
  }
}
