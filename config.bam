filesystem : {
  fstrees : {
    / : {
      invalidation : stat
      mkdir : false
      index : false
    }

    /home/todd/bam : {
      invalidation : notify
      mkdir : false
      index : true
      mount : true
    }

    /home/todd/bam-build : {
      invalidation : notify
      mkdir : true
      index : true
      mount : true
    }

    /home/todd/bam/internal-modules : {
      invalidation : stat
      mkdir : false
      index : true
      mount : true
    }
  }

  exclude : {
    /home/todd/bam/builtin-modules
    /home/todd/bam/"builtin-modules%devel"
    /home/todd/bam/builtin-plugins
  }

  special : {
    var.bam.final
    var.bam.debug
    var.bam.trace
    var.bam.devel

    rules.bam.final
    rules.bam.debug
    rules.bam.trace
    rules.bam.devel
  }
}

build : {
  concurrency : 16
}
