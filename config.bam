filesystems : {
  / : {
    invalidate : stat
    mkdirs : false
    indexed : false
  }

  /home/todd/fab : {
    invalidate : notify
    mkdirs : false
    indexed : true
  }

  /home/todd/fab-build : {
    invalidate : notify
    mkdirs : true
    indexed : true
  }
}

walker : {
  exclude : {
    /home/todd/fab/builtin-modules
    /home/todd/fab/"builtin-modules+devel"
    /home/todd/fab/**/build/final
    /home/todd/fab/**/build/devel
    /home/todd/fab/**/build/debug
    /home/todd/fab/**/build/trace
  }
  include : {
    /home/todd/fab
    /home/todd/fab-build
  }
  special : {
    var.bam.final
    var.bam.debug
    var.bam.trace
    var.bam.devel

    rules.bam.final
    rules.bam.debug
    rules.bam.trace
    rules.bam.devel
  }
}
