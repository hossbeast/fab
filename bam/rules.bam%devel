use git
use flex
use bison
bind bam-build/asan => //asan-bits

# includes
rule **+(/) => [*] //module/include

# rename
rule $^D/bam.exe -> bam+(@) : coreutils/symlink.bam%devel+(.)

# default targets
rule $^D/bam+(@) -> //targets

# dependencies
rule $^D/**/*.o [*] -> bam.exe
rule //artifacts/*/$CONFIG_VARIANT/*.a -> bam.exe
{
  if($CONFIG_DEVEL)
  rule //asan-bits/devel/asan.o -> bam.exe
}
