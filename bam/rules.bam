use git
use flex
use bison

bind bam-build/asan       => //asan-bits
bind executable           => //executable

# includes
rule **+(/) => [*] //module/include

# default targets
rule { search : module } bam -> //targets

rule { search : module } **/*.o [*] -> bam : //executable/cc.bam

# dependencies
rule //artifacts/*/$CONFIG_VARIANT/*.a -> bam
{
  if($CONFIG_DEVEL)

  rule //asan-bits/devel/asan.o -> bam
}
