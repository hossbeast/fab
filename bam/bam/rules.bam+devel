use git
use flex
use bison

bind fab-build/asan                     => //fabasan
bind "builtin-modules+devel"/executable => //executable

# includes
rule **+(/) => [*] //module/include

# default targets
rule { search : module } bam -> //targets

rule { search : module } **/*.o [*] -> bam : //executable/cc.bam+devel

# dependencies
rule //artifacts/*/$CONFIG_VARIANT/*.a -> bam
{
  if($CONFIG_DEVEL)

  rule //fabasan/devel/asan.o -> bam
}
