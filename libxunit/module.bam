use cc             # this module contains c sources
use library/static # this module builds a library
use git

# make common objects available for #inclusion and linking by files in this module
import fab/include
import libcommon
import libxlinux
import libnarrator

# variants for the module
variant {debug,devel,final,trace}

# pull in object files in the module, except those under integ/example
rule **/*.?.o -> libxunit.$?.a

# default build targets
rule libxunit.?.a -> //module/targets

# library dependencies
rule //module/imports/*/lib*.?.a -> libxunit.$?.a
